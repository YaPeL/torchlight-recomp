+/**
+ * @file        graphics/pending_calls_test.cpp
+ * @brief       The command processor's queue of calls: pushed from several threads, run by one
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <atomic>
+#include <thread>
+#include <vector>
+
+#include <rex/graphics/pending_calls.h>
+
+using rex::graphics::PendingCalls;
+
+TEST_CASE("PendingCalls runs every call pushed from other threads, each thread's in order",
+          "[graphics]") {
+  constexpr int kThreads = 4;
+  constexpr int kCallsPerThread = 20000;
+  PendingCalls calls;
+  std::vector<int> next(kThreads, 0);  // touched only by the running thread
+  int out_of_order = 0;
+  std::atomic<int> pushers_done{0};
+
+  std::vector<std::thread> pushers;
+  for (int t = 0; t < kThreads; ++t) {
+    pushers.emplace_back([&, t] {
+      for (int i = 0; i < kCallsPerThread; ++i) {
+        calls.Push([&, t, i] {
+          if (next[t] != i) {
+            ++out_of_order;
+          }
+          next[t] = i + 1;
+        });
+      }
+      pushers_done.fetch_add(1);
+    });
+  }
+  // The worker: checks and drains while the others push, as the command processor's loop does.
+  while (pushers_done.load() < kThreads || !calls.Empty()) {
+    calls.RunAll();
+  }
+  for (auto& pusher : pushers) {
+    pusher.join();
+  }
+  calls.RunAll();
+
+  CHECK(out_of_order == 0);
+  for (int t = 0; t < kThreads; ++t) {
+    CHECK(next[t] == kCallsPerThread);
+  }
+  CHECK(calls.Empty());
+}
+
+TEST_CASE("PendingCalls runs a call queued by a running call", "[graphics]") {
+  PendingCalls calls;
+  int ran = 0;
+  calls.Push([&] {
+    ++ran;
+    calls.Push([&] { ++ran; });
+  });
+  calls.RunAll();
+  CHECK(ran == 2);
+  CHECK(calls.Empty());
+}
