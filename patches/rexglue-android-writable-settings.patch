@@ -153,6 +159,19 @@ bool ReXApp::SetupEnvironment() {
   cache_root_ = path_config.cache_root;
   metadata_root_ = path_config.metadata_root;
   config_path_ = path_config.config_path;
+#if REX_PLATFORM_ANDROID
+  // Where the app moved the user data, the default config and logs go with it, and the folder
+  // is made here: on a fresh install nothing else has made it yet when the settings are saved.
+  std::filesystem::path writable_dir = settings_dir;
+  if (config_path_ == settings_dir / (std::string(GetName()) + ".toml")) {
+    writable_dir = path_config.user_data_root;
+    config_path_ = writable_dir / (std::string(GetName()) + ".toml");
+  }
+  std::error_code mkdir_error;
+  std::filesystem::create_directories(config_path_.parent_path(), mkdir_error);
+#else
+  const std::filesystem::path& writable_dir = settings_dir;
+#endif
   resolved_defaults_ = std::move(path_config);
 
   // Load config FIRST so log cvars have final values
@@ -166,7 +185,7 @@ bool ReXApp::SetupEnvironment() {
   auto log_config =
       rex::BuildLogConfig(log_level_str, rex::ParseCategoryLevelsFromConfig(config_path_));
   log_config.app_name = std::string(GetName());
-  log_config.log_dir = exe_dir / "logs";
+  log_config.log_dir = writable_dir / "logs";
   OnConfigureLogging(log_config);
