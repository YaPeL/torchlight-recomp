+/**
+ * @file        rex/system/guest_fatal.h
+ * @brief       Fatal guest errors: a hook the app registers, and an end that never returns
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+struct PPCContext;
+
+namespace rex::system {
+
+// What the guest did that it cannot come back from. On the console each of these ends the title
+// (nothing dispatches a raised exception to a handler here), so returning into the guest would
+// run code past a call that does not return.
+enum class GuestFatalKind {
+  kException,     // RtlRaiseException with a code other than SetThreadName's
+  kCppException,  // RtlRaiseException with the C++ throw code (0xE06D7363)
+  kBugCheck,      // KeBugCheck, KeBugCheckEx
+  kDebugBreak,    // DbgBreakPoint
+};
+
+struct GuestFatalError {
+  GuestFatalKind kind = GuestFatalKind::kException;
+  uint32_t code = 0;  // the exception or bug check code; 0x80000003 for a break
+  uint32_t parameter_count = 0;
+  uint32_t parameters[15] = {};  // the record's information, or the bug check's four
+  uint32_t record_address = 0;   // the guest X_EXCEPTION_RECORD, 0 if none
+  uint32_t thread_id = 0;        // the guest thread, 0 if not on one
+  const PPCContext* context = nullptr;  // that thread's context, null if not on one
+};
+
+// Called on the thread that raised the error. It should not return (it may end the process, or
+// throw to a test); if it does, the process aborts anyway. nullptr unregisters.
+using GuestFatalHandler = void (*)(const GuestFatalError& error);
+void SetGuestFatalHandler(GuestFatalHandler handler);
+
+// Logs the error, calls the registered handler, and aborts: with a debugger attached it breaks
+// into it first.
+[[noreturn]] void RaiseGuestFatal(const GuestFatalError& error);
+
+}  // namespace rex::system
