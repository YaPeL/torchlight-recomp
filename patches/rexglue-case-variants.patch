+namespace {
+
+// Names that differ only in case are one name to the guest: an open finds the first one listed
+// (an order the host decides) and an enumeration lists them all. Both stay in the tree.
+void WarnCaseVariants(const std::filesystem::path& folder,
+                      const std::vector<rex::filesystem::FileInfo>& infos) {
+  if (infos.size() < 2) {
+    return;
+  }
+  std::vector<std::pair<std::string, std::string>> names;  // (folded, as on the host)
+  names.reserve(infos.size());
+  for (const auto& info : infos) {
+    std::string name = rex::path_to_utf8(info.name);
+    names.emplace_back(rex::string::utf8_lower_ascii(name), std::move(name));
+  }
+  std::sort(names.begin(), names.end());
+  for (size_t first = 0; first < names.size();) {
+    size_t last = first + 1;
+    while (last < names.size() && names[last].first == names[first].first) {
+      ++last;
+    }
+    if (last - first > 1) {
+      std::string variants;
+      for (size_t i = first; i < last; ++i) {
+        variants += (i == first ? "'" : ", '") + names[i].second + "'";
+      }
+      REXFS_WARN("Host folder '{}' holds names that differ only in case: {}. The title sees them "
+                 "as one name and opens only one of them",
+                 rex::path_to_utf8(folder), variants);
+    }
+    first = last;
+  }
+}
+
+}  // namespace
