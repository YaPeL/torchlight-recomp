+namespace {
+// The open files of the device a package is mounted as, written through to the disk.
+X_RESULT FlushPackageFiles(KernelState* kernel_state, const std::string& device_path) {
+  if (!kernel_state) {
+    return X_ERROR_SUCCESS;
+  }
+  // The references keep the files open while they are flushed.
+  auto xfiles = kernel_state->object_table()->GetObjectsByType<XFile>();
+  std::vector<rex::filesystem::File*> files;
+  files.reserve(xfiles.size());
+  for (auto& xfile : xfiles) {
+    files.push_back(xfile->file());
+  }
+  const X_STATUS status = rex::filesystem::FlushFilesOnDevice(files, device_path);
+  if (XFAILED(status)) {
+    REXSYS_WARN("Content flush of {} failed: {:08X}", device_path, status);
+    return X_ERROR_FUNCTION_FAILED;
+  }
+  return X_ERROR_SUCCESS;
+}
