+namespace {
+
+// Windows' default timer resolution is 15.625 ms: ::Sleep(1), a guest Sleep(1) through
+// XThread::Delay and every wait timeout last up to a whole tick, and the guest vblank thread's
+// waits come out in bursts. The process asks for 1 ms for as long as it runs.
+struct ProcessTimerResolution {
+  ProcessTimerResolution() : active(timeBeginPeriod(1) == TIMERR_NOERROR) {}
+  ~ProcessTimerResolution() {
+    if (active) {
+      timeEndPeriod(1);
+    }
+  }
+  bool active;
+};
+const ProcessTimerResolution process_timer_resolution;
+
+// One high resolution waitable timer per thread (Windows 10 1803 and later), so sleeps last the
+// requested microseconds: ::Sleep takes whole milliseconds and turns a wait under 1 ms into a
+// yield. Null when the system has none; the sleeps then fall back to ::Sleep.
+struct ThreadSleepTimer {
+  ThreadSleepTimer()
+      : handle(CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                      TIMER_ALL_ACCESS)) {}
+  ~ThreadSleepTimer() {
+    if (handle) {
+      CloseHandle(handle);
+    }
+  }
+  HANDLE handle;
+};
+
+// Waits `duration` on the calling thread's timer and stores the wait's result; false if the
+// thread has no timer or it could not be armed.
+bool TimerSleep(std::chrono::microseconds duration, bool alertable, DWORD* result) {
+  thread_local ThreadSleepTimer timer;
+  if (!timer.handle) {
+    return false;
+  }
+  LARGE_INTEGER due_time;
+  due_time.QuadPart = -static_cast<LONGLONG>(duration.count()) * 10;  // relative, 100 ns units
+  if (!SetWaitableTimerEx(timer.handle, &due_time, 0, nullptr, nullptr, nullptr, 0)) {
+    return false;
+  }
+  *result = WaitForSingleObjectEx(timer.handle, INFINITE, alertable ? TRUE : FALSE);
+  return true;
+}
+
+}  // namespace
+
 void Sleep(std::chrono::microseconds duration) {
   if (duration.count() < 100) {
     MaybeYield();
-  } else {
+    return;
+  }
+  DWORD result;
+  if (!TimerSleep(duration, false, &result)) {
     ::Sleep(static_cast<DWORD>(duration.count() / 1000));
   }
 }
 
 SleepResult AlertableSleep(std::chrono::microseconds duration) {
-  if (SleepEx(static_cast<DWORD>(duration.count() / 1000), TRUE) == WAIT_IO_COMPLETION) {
+  DWORD result;
+  if (duration.count() <= 0 || !TimerSleep(duration, true, &result)) {
+    result = SleepEx(static_cast<DWORD>(duration.count() / 1000), TRUE);
+  }
+  if (result == WAIT_IO_COMPLETION) {
     return SleepResult::kAlerted;
   }
   return SleepResult::kSuccess;
