+namespace {
+bool MatchRules(const std::vector<WildcardRule>& rules, const std::string& str_lc) {
   std::string::size_type offset(0);
-  for (const auto& rule : rules_) {
+  for (const auto& rule : rules) {
     if (!(rule.Check(str_lc, &offset))) {
       return false;
     }
   }
-
   return true;
 }
+}  // namespace
+
+bool WildcardEngine::Match(const std::string_view str) const {
+  std::string str_lc = rex::string::utf8_lower_ascii(str);
+  const bool has_dot = str_lc.find('.') != std::string::npos;
+  switch (dos_end_) {
+    case DosEnd::kDotStar:
+      return MatchRules(rules_, str_lc) || (!has_dot && MatchRules(stem_rules_, str_lc));
+    case DosEnd::kDot:
+      return !has_dot && MatchRules(stem_rules_, str_lc);
+    case DosEnd::kNone:
+      break;
+  }
+  return MatchRules(rules_, str_lc);
+}
 
 }  // namespace rex::filesystem
