@@ -0,0 +1,64 @@
+/**
+ * Unit tests for WildcardEngine against Windows/Xbox find semantics (FindFirstFile).
+ *
+ * "*.*" matches every name, with or without a dot (a game lists folders with it); a pattern
+ * ending in ".*" also matches a name without a dot when its stem does; a pattern ending in "."
+ * matches only names without a dot. Everything else keeps its plain meaning.
+ */
+
+#include <string_view>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/filesystem/wildcard.h>
+
+using rex::filesystem::WildcardEngine;
+
+namespace {
+
+bool Matches(std::string_view pattern, std::string_view name) {
+  WildcardEngine engine;
+  engine.SetRule(pattern);
+  return engine.Match(name);
+}
+
+}  // namespace
+
+TEST_CASE("Wildcard star dot star matches every name", "[filesystem][wildcard]") {
+  CHECK(Matches("*.*", "mod.dat"));
+  CHECK(Matches("*.*", "media"));  // a folder: no dot
+  CHECK(Matches("*.*", "a.b.c"));
+  CHECK(Matches("*.*", "x."));
+  CHECK(Matches("*.*", "MEDIA"));  // case ignored
+}
+
+TEST_CASE("Wildcard star matches every name", "[filesystem][wildcard]") {
+  CHECK(Matches("*", "media"));
+  CHECK(Matches("*", "mod.dat"));
+}
+
+TEST_CASE("Wildcard trailing dot star also matches names without a dot", "[filesystem][wildcard]") {
+  CHECK(Matches("a*.*", "abc"));
+  CHECK(Matches("a*.*", "abc.dat"));
+  CHECK_FALSE(Matches("a*.*", "bcd"));
+  CHECK(Matches("unit*.*", "units"));
+}
+
+TEST_CASE("Wildcard trailing dot matches only names without a dot", "[filesystem][wildcard]") {
+  CHECK(Matches("*.", "media"));
+  CHECK_FALSE(Matches("*.", "mod.dat"));
+  CHECK(Matches("abc.", "abc"));
+  CHECK_FALSE(Matches("abc.", "abcd"));
+}
+
+TEST_CASE("Wildcard other patterns keep their meaning", "[filesystem][wildcard]") {
+  CHECK(Matches("*.dat", "mod.dat"));
+  CHECK_FALSE(Matches("*.dat", "media"));
+  CHECK_FALSE(Matches("*.dat", "mod.dat.adm"));
+  CHECK(Matches("mod.dat", "MOD.DAT"));
+  CHECK_FALSE(Matches("mod.dat", "mod.da"));
+  CHECK(Matches("m?d.dat", "mod.dat"));
+  CHECK(Matches("*sword*", "tl_test_sword.dat"));
+  CHECK(Matches(".*", ".hidden"));
+  CHECK_FALSE(Matches(".*", "media"));
+}
