<?xml version="1.0" encoding="UTF-8"?>
<!-- The host's settings, a column on the right of the game's settings menu (settingsmenu_xenon),
     in the style of its rows: labels over slider bars, values in the menu's yellow, checkboxes
     like "Show Tips", and on top three buttons like "Set Storage Device" that pick the section shown
     below them (Video, Controls, Extras; the others' rows are hidden, which the menu's navigation
     passes over). Our own layout: it only references the game's widget types (ceguiWidget/*),
     fonts and imagesets at runtime. The values are filled in by the host. Every window is named
     under "tl_video/": the guest's generator of unique names makes clashing ones (sub_825B8248
     returned "27_"), and the host finds the rows by these names. -->
<GUILayout >
    <Window Type="DefaultWindow" Name="tl_video" >
        <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        <Property Name="UnifiedAreaRect" Value="{{0,430},{0,10},{0,725},{0,575}}" />
        <Property Name="MousePassThroughEnabled" Value="True" />
        <Property Name="WantsMultiClickEvents" Value="False" />
        <Window Type="ceguiWidget/ImageButton" Name="tl_video/section_video" >
            <Property Name="tabOrder" Value="12" />
            <Property Name="HoverImage" Value="set:widgets1 image:gem_button_small_rollover" />
            <Property Name="NormalImage" Value="set:widgets2 image:gem_button_small" />
            <Property Name="PushedImage" Value="set:widgets1 image:gem_button_small_rollover" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="UnifiedAreaRect" Value="{{0,37},{0,0},{0,258},{0,36}}" />
            <Property Name="WantsMultiClickEvents" Value="False" />
            <Window Type="ceguiWidget/StaticText" Name="tl_video/section_video/text" >
                <Property Name="Font" Value="Serif14" />
                <Property Name="Text" Value="Video" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,-2},{1,0},{1,-2}}" />
                <Property Name="HorzTextFormatting" Value="CentreAligned" />
                <Property Name="VertFormatting" Value="CentreAligned" />
                <Property Name="WantsMultiClickEvents" Value="False" />
                <Property Name="MousePassThroughEnabled" Value="True" />
            </Window>
        </Window>
