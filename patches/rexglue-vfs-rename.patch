diff --git a/tests/unit/core/vfs_rename_test.cpp b/tests/unit/core/vfs_rename_test.cpp
new file mode 100644
index 0000000..fb9e536
--- /dev/null
+++ b/tests/unit/core/vfs_rename_test.cpp
@@ -0,0 +1,188 @@
+#include <algorithm>
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <span>
+#include <string>
+#include <vector>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/filesystem.h>
+#include <rex/filesystem/devices/host_path_device.h>
+#include <rex/filesystem/entry.h>
+#include <rex/filesystem/file.h>
+#include <rex/filesystem/vfs.h>
+
+using rex::X_STATUS;
+using rex::filesystem::Entry;
+using rex::filesystem::File;
+using rex::filesystem::FileAccess;
+using rex::filesystem::FileAction;
+using rex::filesystem::FileDisposition;
+using rex::filesystem::HostPathDevice;
+using rex::filesystem::VirtualFileSystem;
+
+namespace {
+
+// A writable host directory mounted as test:, like a title's save container.
+class RenameStore {
+ public:
+  RenameStore() {
+    root_ = std::filesystem::temp_directory_path() /
+            ("rexglue_vfs_rename_" + std::to_string(counter_++));
+    std::error_code ec;
+    std::filesystem::remove_all(root_, ec);
+    std::filesystem::create_directories(root_ / "sub", ec);
+    WriteHost("1.TSV", "first save");
+    WriteHost("backup.tmp", "old backup");
+
+    auto device = std::make_unique<HostPathDevice>("\\RenameStore", root_, false, true);
+    REQUIRE(device->Initialize());
+    REQUIRE(vfs_.RegisterDevice(std::move(device)));
+    REQUIRE(vfs_.RegisterSymbolicLink("test:", "\\RenameStore"));
+  }
+  ~RenameStore() {
+    std::error_code ec;
+    std::filesystem::remove_all(root_, ec);
+  }
+
+  void WriteHost(const std::string& name, const std::string& text) {
+    FILE* file = rex::filesystem::OpenFile(root_ / name, "wb");
+    REQUIRE(file != nullptr);
+    fwrite(text.data(), 1, text.size(), file);
+    fclose(file);
+  }
+  std::string ReadHost(const std::string& name) {
+    FILE* file = rex::filesystem::OpenFile(root_ / name, "rb");
+    if (!file) return "<missing>";
+    std::string text(64, '\0');
+    text.resize(fread(text.data(), 1, text.size(), file));
+    fclose(file);
+    return text;
+  }
+  bool HostExists(const std::string& name) { return std::filesystem::exists(root_ / name); }
+
+  // Writes a file through the VFS (create or overwrite), like the guest's fopen("wb").
+  void Write(const std::string& name, const std::string& text) {
+    File* file = nullptr;
+    FileAction action;
+    REQUIRE(vfs_.OpenFile(nullptr, "test:\\" + name, FileDisposition::kOverwriteIf,
+                          FileAccess::kGenericWrite, false, true, &file,
+                          &action) == X_STATUS_SUCCESS);
+    size_t written = 0;
+    file->WriteSync(std::span<const uint8_t>(reinterpret_cast<const uint8_t*>(text.data()),
+                                             text.size()),
+                    0, &written);
+    file->Destroy();
+  }
+
+  // What NtSetInformationFile(FileRenameInformation) does: the target is the guest path.
+  X_STATUS Rename(const std::string& from, const std::string& to, bool replace) {
+    Entry* entry = vfs_.ResolvePath("test:\\" + from);
+    REQUIRE(entry != nullptr);
+    return entry->Rename(rex::to_path("test:\\" + to), replace);
+  }
+
+  Entry* Lookup(const std::string& name) { return vfs_.ResolvePath("test:\\" + name); }
+
+  std::vector<std::string> Names(const std::string& dir = "") {
+    Entry* parent = vfs_.ResolvePath(dir.empty() ? "test:" : "test:\\" + dir);
+    REQUIRE(parent != nullptr);
+    std::vector<std::string> names;
+    for (const auto& child : parent->children()) names.push_back(child->name());
+    std::sort(names.begin(), names.end());
+    return names;
+  }
+
+  VirtualFileSystem& vfs() { return vfs_; }
+
+ private:
+  static int counter_;
+  std::filesystem::path root_;
+  VirtualFileSystem vfs_;
+};
+
+int RenameStore::counter_ = 0;
+
+}  // namespace
+
+TEST_CASE("A renamed entry is found by its new name", "[filesystem][vfs]") {
+  RenameStore store;
+  REQUIRE(store.Rename("1.TSV", "2.TSV", false) == X_STATUS_SUCCESS);
+  Entry* entry = store.Lookup("2.TSV");
+  REQUIRE(entry != nullptr);
+  CHECK(entry->name() == "2.TSV");
+  CHECK(entry->path() == "2.TSV");
+  CHECK(store.Lookup("1.TSV") == nullptr);
+  CHECK(store.ReadHost("2.TSV") == "first save");
+  CHECK_FALSE(store.HostExists("1.TSV"));
+}
+
+TEST_CASE("Rename replaces an existing entry only when asked", "[filesystem][vfs]") {
+  RenameStore store;
+  SECTION("without replace: collision, nothing changes") {
+    CHECK(store.Rename("1.TSV", "backup.tmp", false) == X_STATUS_OBJECT_NAME_COLLISION);
+    CHECK(store.Names() == std::vector<std::string>{"1.TSV", "backup.tmp", "sub"});
+    CHECK(store.ReadHost("1.TSV") == "first save");
+    CHECK(store.ReadHost("backup.tmp") == "old backup");
+  }
+  SECTION("with replace: one entry left, holding the renamed file") {
+    REQUIRE(store.Rename("1.TSV", "backup.tmp", true) == X_STATUS_SUCCESS);
+    CHECK(store.Names() == std::vector<std::string>{"backup.tmp", "sub"});
+    CHECK(store.ReadHost("backup.tmp") == "first save");
+    CHECK(store.Lookup("backup.tmp")->name() == "backup.tmp");
+  }
+}
+
+TEST_CASE("Rename without replace refuses a host file the tree does not know", "[filesystem][vfs]") {
+  RenameStore store;
+  store.WriteHost("late.tmp", "written behind the VFS");
+  CHECK(store.Rename("1.TSV", "late.tmp", false) == X_STATUS_OBJECT_NAME_COLLISION);
+  CHECK(store.ReadHost("late.tmp") == "written behind the VFS");
+  CHECK(store.ReadHost("1.TSV") == "first save");
+}
+
+TEST_CASE("Repeated safe saves keep one save and one backup", "[filesystem][vfs]") {
+  // Torchlight's save: write save.tmp, delete backup.tmp, rename N.TSV -> backup.tmp,
+  // rename save.tmp -> N.TSV. The delete is left out here (it is a delete-on-close), so the
+  // renames replace.
+  RenameStore store;
+  for (const std::string text : {"second save", "third save"}) {
+    const std::string previous = store.ReadHost("1.TSV");
+    store.Write("save.tmp", text);
+    REQUIRE(store.Rename("1.TSV", "backup.tmp", true) == X_STATUS_SUCCESS);
+    REQUIRE(store.Rename("save.tmp", "1.TSV", true) == X_STATUS_SUCCESS);
+    CHECK(store.Names() == std::vector<std::string>{"1.TSV", "backup.tmp", "sub"});
+    CHECK(store.ReadHost("1.TSV") == text);
+    CHECK(store.ReadHost("backup.tmp") == previous);
+    CHECK_FALSE(store.HostExists("save.tmp"));
+  }
+}
+
+TEST_CASE("Rename moves an entry to another directory", "[filesystem][vfs]") {
+  RenameStore store;
+  REQUIRE(store.Rename("1.TSV", "sub\\1.TSV", false) == X_STATUS_SUCCESS);
+  Entry* moved = store.Lookup("sub\\1.TSV");
+  REQUIRE(moved != nullptr);
+  CHECK(moved->parent() == store.Lookup("sub"));
+  CHECK(store.Names("sub") == std::vector<std::string>{"1.TSV"});
+  CHECK(store.Names() == std::vector<std::string>{"backup.tmp", "sub"});
+  CHECK(store.ReadHost("sub/1.TSV") == "first save");
+}
+
+TEST_CASE("Rename to a missing directory fails", "[filesystem][vfs]") {
+  RenameStore store;
+  CHECK(store.Rename("1.TSV", "nowhere\\1.TSV", false) == X_STATUS_OBJECT_PATH_NOT_FOUND);
+  CHECK(store.Lookup("1.TSV") != nullptr);
+  CHECK(store.ReadHost("1.TSV") == "first save");
+}
+
+TEST_CASE("A renamed entry can be deleted by its new name", "[filesystem][vfs]") {
+  RenameStore store;
+  REQUIRE(store.Rename("1.TSV", "2.TSV", false) == X_STATUS_SUCCESS);
+  CHECK(store.vfs().DeletePath("test:\\2.TSV"));
+  CHECK(store.Lookup("2.TSV") == nullptr);
+  CHECK_FALSE(store.HostExists("2.TSV"));
+  CHECK(store.ReadHost("backup.tmp") == "old backup");
+}
