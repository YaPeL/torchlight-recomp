 namespace rex::kernel::xboxkrnl {
 using namespace rex::system;
 
+// The fatal error as seen from the calling guest thread.
+GuestFatalError FatalOnThisThread(GuestFatalKind kind, uint32_t code) {
+  GuestFatalError error;
+  error.kind = kind;
+  error.code = code;
+  if (auto* state = rex::runtime::ThreadState::Get()) {
+    error.thread_id = state->thread_id();
+    error.context = state->context();
+  }
+  return error;
+}
+
+[[noreturn]] void RaiseFatalRecord(GuestFatalKind kind, ppc_ptr_t<X_EXCEPTION_RECORD> record) {
+  GuestFatalError error = FatalOnThisThread(kind, record->code);
+  error.record_address = record.guest_address();
+  error.parameter_count = std::min<uint32_t>(record->number_parameters, 15);
+  for (uint32_t i = 0; i < error.parameter_count; ++i) {
+    error.parameters[i] = record->exception_information[i];
+  }
+  RaiseGuestFatal(error);
+}
+
+// A breakpoint with no debugger ends a title on the console. Titles reach it on paths they do not
+// come back from: Torchlight's OGRE raises its errors (OGRE_EXCEPT) through it, then runs on with
+// the state the error was about.
 void DbgBreakPoint_entry() {
-  rex::debug::Break();
+  RaiseGuestFatal(FatalOnThisThread(GuestFatalKind::kDebugBreak, 0x80000003));
 }
 
