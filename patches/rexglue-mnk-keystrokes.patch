+/**
+ * @file        input/gamepad_keystrokes.h
+ * @brief       XInput keystrokes from a gamepad state: the bit of each button,
+ *              trigger and stick direction, and its virtual key.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+#include <rex/input/input.h>
+#include <rex/input/keystroke_repeat.h>
+#include <rex/ui/virtual_key.h>
+
+namespace rex::input {
+
+// The virtual key of each keystroke bit. Bits 0-15 are X_INPUT_GAMEPAD's
+// buttons; 16 and up are generated from the analog inputs (GamepadKeyfield).
+// The order is also the order in which simultaneous changes are reported.
+inline constexpr std::array<rex::ui::VirtualKey, 34> kGamepadKeystrokeKeys = {
+    // 00 - True buttons from xinput button field
+    rex::ui::VirtualKey::kXInputPadDpadUp,
+    rex::ui::VirtualKey::kXInputPadDpadDown,
+    rex::ui::VirtualKey::kXInputPadDpadLeft,
+    rex::ui::VirtualKey::kXInputPadDpadRight,
+    rex::ui::VirtualKey::kXInputPadStart,
+    rex::ui::VirtualKey::kXInputPadBack,
+    rex::ui::VirtualKey::kXInputPadLThumbPress,
+    rex::ui::VirtualKey::kXInputPadRThumbPress,
+    rex::ui::VirtualKey::kXInputPadLShoulder,
+    rex::ui::VirtualKey::kXInputPadRShoulder,
+    rex::ui::VirtualKey::kNone, /* Guide has no VK */
+    rex::ui::VirtualKey::kNone, /* Unknown */
+    rex::ui::VirtualKey::kXInputPadA,
+    rex::ui::VirtualKey::kXInputPadB,
+    rex::ui::VirtualKey::kXInputPadX,
+    rex::ui::VirtualKey::kXInputPadY,
+    // 16 - Fake buttons generated from analog inputs
+    rex::ui::VirtualKey::kXInputPadLTrigger,
+    rex::ui::VirtualKey::kXInputPadRTrigger,
+    // 18
+    rex::ui::VirtualKey::kXInputPadLThumbUp,
+    rex::ui::VirtualKey::kXInputPadLThumbDown,
+    rex::ui::VirtualKey::kXInputPadLThumbRight,
+    rex::ui::VirtualKey::kXInputPadLThumbLeft,
+    rex::ui::VirtualKey::kXInputPadLThumbUpLeft,
+    rex::ui::VirtualKey::kXInputPadLThumbUpRight,
+    rex::ui::VirtualKey::kXInputPadLThumbDownRight,
+    rex::ui::VirtualKey::kXInputPadLThumbDownLeft,
+    // 26
+    rex::ui::VirtualKey::kXInputPadRThumbUp,
+    rex::ui::VirtualKey::kXInputPadRThumbDown,
+    rex::ui::VirtualKey::kXInputPadRThumbRight,
+    rex::ui::VirtualKey::kXInputPadRThumbLeft,
+    rex::ui::VirtualKey::kXInputPadRThumbUpLeft,
+    rex::ui::VirtualKey::kXInputPadRThumbUpRight,
+    rex::ui::VirtualKey::kXInputPadRThumbDownRight,
+    rex::ui::VirtualKey::kXInputPadRThumbDownLeft,
+};
+
+// The bits that have a virtual key.
+inline constexpr uint64_t GamepadKeystrokeReportable() {
+  uint64_t reportable = 0;
+  for (uint8_t i = 0; i < uint8_t(kGamepadKeystrokeKeys.size()); i++) {
+    if (kGamepadKeystrokeKeys[i] != rex::ui::VirtualKey::kNone) {
+      reportable |= uint64_t(1) << i;
+    }
+  }
+  return reportable;
+}
+
+// Every pressed bit of a gamepad state: its buttons, the triggers past
+// `trigger_threshold` and each stick's direction past `thumb_threshold` (one of
+// eight: a diagonal instead of its two sides).
+inline uint64_t GamepadKeyfield(const X_INPUT_GAMEPAD& gamepad, uint8_t trigger_threshold,
+                                int16_t thumb_threshold) {
+  uint64_t f = static_cast<uint16_t>(gamepad.buttons);
+
+  f |= static_cast<uint64_t>(gamepad.left_trigger > trigger_threshold) << 16;
+  f |= static_cast<uint64_t>(gamepad.right_trigger > trigger_threshold) << 17;
+
+  auto thumb_x = static_cast<int16_t>(gamepad.thumb_lx);
+  auto thumb_y = static_cast<int16_t>(gamepad.thumb_ly);
+  for (size_t i = 0; i <= 8; i = i + 8) {
+    uint64_t u = thumb_y > thumb_threshold;
+    uint64_t d = thumb_y < ~thumb_threshold;
+    uint64_t r = thumb_x > thumb_threshold;
+    uint64_t l = thumb_x < ~thumb_threshold;
+    if (u && l) {
+      u = l = 0;
+      f |= uint64_t(1) << (22 + i);
+    }
+    if (u && r) {
+      u = r = 0;
+      f |= uint64_t(1) << (23 + i);
+    }
+    if (d && r) {
+      d = r = 0;
+      f |= uint64_t(1) << (24 + i);
+    }
+    if (d && l) {
+      d = l = 0;
+      f |= uint64_t(1) << (25 + i);
+    }
+    f |= u << (18 + i);
+    f |= d << (19 + i);
+    f |= r << (20 + i);
+    f |= l << (21 + i);
+
+    thumb_x = static_cast<int16_t>(gamepad.thumb_rx);
+    thumb_y = static_cast<int16_t>(gamepad.thumb_ry);
+  }
+  return f;
+}
+
+// The XInput keystroke for one NextKeystroke result.
+inline void FillGamepadKeystroke(const Keystroke& keystroke, X_INPUT_KEYSTROKE* out) {
+  out->virtual_key = uint16_t(kGamepadKeystrokeKeys.at(keystroke.index));
+  out->unicode = 0;
+  // InputSystem stamps the guest user this device is assigned to.
+  out->user_index = 0;
+  out->hid_code = 0;
+  out->flags = !keystroke.down    ? X_INPUT_KEYSTROKE_KEYUP
+               : keystroke.repeat ? X_INPUT_KEYSTROKE_KEYDOWN | X_INPUT_KEYSTROKE_REPEAT
+                                  : X_INPUT_KEYSTROKE_KEYDOWN;
+}
+
+}  // namespace rex::input
