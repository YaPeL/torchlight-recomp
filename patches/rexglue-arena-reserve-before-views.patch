+#elif REX_PLATFORM_LINUX
+  // The views are mapped with MAP_FIXED, which replaces whatever is mapped there already: a
+  // driver's or an allocator's memory that address space randomization put in the range would
+  // become guest memory, and guest writes would corrupt it. So the whole range is reserved first,
+  // only where nothing else is mapped, and the views replace that reservation alone.
+  // A page without access stays before and after the views (the reservation's ends), so a host
+  // write that runs off either end of guest memory faults there, at the writer.
+  const size_t arena_size = static_cast<size_t>(0x120000000ull);  // what map_info's views span
+  const size_t guard = rex::memory::page_size();
+  mapping_base_ = 0;
+  for (size_t n = 32; n < 64; n++) {
+    auto mapping_base = reinterpret_cast<uint8_t*>(1ull << n);
+    if (!ReserveFreeRange(mapping_base - guard, arena_size + 2 * guard)) {
+      continue;
+    }
+    if (!MapViews(mapping_base)) {
+      mapping_base_ = mapping_base;
+      guard_size_ = guard;
+      break;
+    }
+    // MapViews left the views it had made in place: replace them and the rest of the reservation,
+    // all ours, with one reservation in one call (no hole opens), then free it.
+    mmap(mapping_base - guard, arena_size + 2 * guard, PROT_NONE,
+         MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED, -1, 0);
+    munmap(mapping_base - guard, arena_size + 2 * guard);
+  }
+  if (!mapping_base_) {
+    REXSYS_ERROR("Unable to find a free block for the guest memory in the 64bit address space.");
+    assert_always();
+    return false;
+  }
 #else
