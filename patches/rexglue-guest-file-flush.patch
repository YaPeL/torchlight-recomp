+namespace {
+// fsync, or on Apple F_FULLFSYNC: fsync there leaves the data in the drive's cache.
+// Some file systems (network shares) do not support F_FULLFSYNC: fsync then.
+bool FlushDescriptor(int descriptor) {
+#if defined(__APPLE__)
+  if (fcntl(descriptor, F_FULLFSYNC) == 0) {
+    return true;
+  }
+#endif
+  return fsync(descriptor) == 0;
+}
+}  // namespace
+
+bool FlushFolder(const std::filesystem::path& path) {
+  const int descriptor = open(path.c_str(), O_RDONLY | O_DIRECTORY);
+  if (descriptor < 0) {
+    return false;
+  }
+  const bool flushed = FlushDescriptor(descriptor);
+  close(descriptor);
+  return flushed;
+}
