+TEST_CASE("Rename onto a case variant replaces it", "[filesystem][vfs]") {
+  // The guest replaces 1.tsv, and the folder holds 1.TSV. On a case-sensitive host the rename
+  // writes a second file, so the replaced one must be removed; on a case-insensitive host the
+  // rename already replaced it, and nothing else may be removed.
+  RenameStore store;
+  store.Write("save.tmp", "new save");
+  REQUIRE(store.Rename("save.tmp", "1.tsv", true) == X_STATUS_SUCCESS);
+  CHECK(store.Names() == std::vector<std::string>{"1.tsv", "backup.tmp", "sub"});
+  CHECK(CaseMatches(store.HostNames(), "1.tsv").size() == 1);
+  CHECK(store.ReadHost("1.tsv") == "new save");
+  CHECK_FALSE(store.HostExists("save.tmp"));
+  CHECK(store.ReadHost("backup.tmp") == "old backup");
+
+  store.Mount();
+  CHECK(CaseMatches(store.Names(), "1.tsv").size() == 1);
+  Entry* entry = store.Lookup("1.TSV");
+  REQUIRE(entry != nullptr);
+  CHECK(store.ReadHost(entry->name()) == "new save");
+}
