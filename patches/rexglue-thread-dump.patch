new file mode 100644
index 0000000..51b7bea
--- /dev/null
+++ b/include/rex/system/thread_dump.h
@@ -0,0 +1,116 @@
+/**
+ * @file        rex/system/thread_dump.h
+ * @brief       A dump of every guest thread's state, for a watchdog that found a hang
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <string>
+#include <string_view>
+
+namespace rex::system {
+
+// Logs, as one error-level log call, every guest thread's name, thread id, host thread id, state
+// (running, waiting, suspended), the kernel objects a waiting thread waits on and for how long,
+// and the guest LR of that wait's kernel call; then each registered section (the command
+// processor's). It can be called from any thread, before or after the kernel and the GPU exist.
+// It never waits on a lock: the threads write their own state into a fixed table with atomics,
+// a record being written at that moment is printed as "inconsistent", and the sections only try
+// their locks. The one lock it can wait on is the log sink's, for the single call that writes
+// the block.
+void LogThreadDump(std::string_view reason);
+
+// The text LogThreadDump logs.
+std::string FormatThreadDump(std::string_view reason);
+
+// A part of the dump that lives outside the runtime (the command processor, in the GPU plugin).
+// It appends its state to `out` and takes no lock it would wait for. Unregister waits until no
+// dump is running the section, so `context` can be destroyed after it returns.
+using ThreadDumpSection = void (*)(void* context, std::string& out);
+bool RegisterThreadDumpSection(ThreadDumpSection section, void* context);
+void UnregisterThreadDumpSection(ThreadDumpSection section, void* context);
+
+namespace thread_dump {
+
+// What the threads record about themselves (XThread and XObject call these).
+
+enum class WaitKind : uint32_t {
+  kNone,
+  kSingle,         // XObject::Wait
+  kAll,            // XObject::WaitMultiple, every object
+  kAny,            // XObject::WaitMultiple, any object
+  kSignalAndWait,  // XObject::SignalAndWait: the signalled object first
+  kDelay,          // XThread::Delay
+};
+
+struct WaitObject {
+  uint32_t type;  // XObject::Type
+  uint32_t handle;
+};
+
+constexpr size_t kMaxRecords = 256;
+constexpr size_t kMaxWaitObjects = 4;
+constexpr size_t kMaxNameLength = 63;
+
+// Takes a record for the calling thread, which then belongs to it until ReleaseRecord. Returns
+// the record's index, or -1 when the table is full (the dump then counts the thread as not
+// recorded).
+int AcquireRecord(uint32_t thread_id, uint32_t host_thread_id, std::string_view name);
+void ReleaseRecord(int record);
+void SetName(int record, std::string_view name);
+void SetSuspendCount(int record, uint32_t suspend_count);
+
+// The calling thread's record (the one AcquireRecord took on it), or -1.
+int CurrentRecord();
+
+// Around a kernel wait on the calling thread; nothing happens on a thread without a record.
+// `timeout_ms` is -1 for an infinite wait. Waits on more than kMaxWaitObjects objects record the
+// first ones and the total count.
+void BeginWait(WaitKind kind, std::span<const WaitObject> objects, uint32_t object_count,
+               int64_t timeout_ms, uint64_t guest_lr);
+void EndWait();
+
+// BeginWait for as long as it lives, then EndWait.
+class ScopedWait {
+ public:
+  ScopedWait(WaitKind kind, std::span<const WaitObject> objects, uint32_t object_count,
+             int64_t timeout_ms, uint64_t guest_lr)
+      : active_(CurrentRecord() >= 0) {
+    if (active_) {
+      BeginWait(kind, objects, object_count, timeout_ms, guest_lr);
+    }
+  }
+  ~ScopedWait() {
+    if (active_) {
+      EndWait();
+    }
+  }
+  ScopedWait(const ScopedWait&) = delete;
+  ScopedWait& operator=(const ScopedWait&) = delete;
+
+ private:
+  bool active_;
+};
+
+// For tests: holds `record` as if its thread were writing it, until the returned object is
+// destroyed.
+class ScopedWriteForTesting {
+ public:
+  explicit ScopedWriteForTesting(int record);
+  ~ScopedWriteForTesting();
+  ScopedWriteForTesting(const ScopedWriteForTesting&) = delete;
+  ScopedWriteForTesting& operator=(const ScopedWriteForTesting&) = delete;
+
+ private:
+  int record_;
+};
+
+}  // namespace thread_dump
+
+}  // namespace rex::system
