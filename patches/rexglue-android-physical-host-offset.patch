+// Where a view starts in the backing file. The 0xE0000000 view starts at 0x1000
+// into its physical range, which a granularity coarser than 4 KB rounds away; the
+// heap then adds the 0x1000 back (host_address_offset). Where PhysicalHostOffset
+// asks for that offset at any granularity (Android), the view starts there too.
+static size_t ViewFileOffset(const MapInfo& info, uint64_t granularity_mask) {
+  uint64_t target = info.target_address;
+  if (info.virtual_address_start < 0x100000000ull) {
+    target -= detail::PhysicalHostOffset(uint32_t(info.virtual_address_start));
+  }
+  return size_t(target & granularity_mask);
+}
