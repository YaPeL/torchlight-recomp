+/// `non_argument_in_context`: the registers non_argument_as_local leaves in the context. The list
+/// replaces any earlier one; a name outside r0, r2, r11, r12, f0, v32-v63 is an error and is
+/// ignored.
+void ApplyNonArgumentInContext(toml::node_view<const toml::node> node, RecompilerConfig& cfg) {
+  cfg.nonArgumentGprsInContext = 0;
+  cfg.nonArgumentFprsInContext = 0;
+  cfg.nonArgumentVmxInContext = 0;
+  auto* list = node.as_array();
+  if (!list) {
+    REXCODEGEN_ERROR("non_argument_in_context: expected an array of register names");
+    return;
+  }
+  for (const auto& item : *list) {
+    auto name = item.value<std::string>();
+    unsigned index = 0;
+    char kind = 0;
+    char rest = 0;
+    if (name && name->size() >= 2 &&
+        std::sscanf(name->c_str(), "%c%u%c", &kind, &index, &rest) == 2) {
+      if (kind == 'r' && (index == 0 || index == 2 || index == 11 || index == 12)) {
+        cfg.nonArgumentGprsInContext |= 1u << index;
+        continue;
+      }
+      if (kind == 'f' && index == 0) {
+        cfg.nonArgumentFprsInContext |= 1u;
+        continue;
+      }
+      if (kind == 'v' && index >= 32 && index <= 63) {
+        cfg.nonArgumentVmxInContext |= uint64_t{1} << (index - 32);
+        continue;
+      }
+    }
+    REXCODEGEN_ERROR("non_argument_in_context: '{}' is not a non-argument register (r0, r2, r11, "
+                     "r12, f0, v32-v63)",
+                     name ? *name : std::string("?"));
+  }
+}
