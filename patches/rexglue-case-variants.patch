+// Whether names that differ only in case are one file on this host's temporary folder (Windows,
+// and macOS's default APFS) or two (Linux).
+bool HostIgnoresCase() {
+  const auto dir = std::filesystem::temp_directory_path() / "rexglue_vfs_case_probe";
+  std::error_code ec;
+  std::filesystem::remove_all(dir, ec);
+  std::filesystem::create_directories(dir, ec);
+  FILE* file = rex::filesystem::OpenFile(dir / "probe.x", "wb");
+  REQUIRE(file != nullptr);
+  fclose(file);
+  const bool ignores = std::filesystem::exists(dir / "PROBE.X", ec);
+  std::filesystem::remove_all(dir, ec);
+  return ignores;
+}
