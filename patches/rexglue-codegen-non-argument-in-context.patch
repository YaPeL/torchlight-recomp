+{% if config_flags.verify_non_argument_locals %}//=============================================================================
+// non_argument_as_local check (verify_non_argument_locals)
 //=============================================================================
+
+// The checking build writes every local non-argument register through to the context, so the two
+// differ only where the guest reads a value another function left in the register. The first
+// difference at each site is logged (64 sites at most) and the local value is used.
+#include <cstring>
+#include <string>
+
+inline void ppc_report_local_difference(const char* function, u32 address, const char* reg,
+                                        const void* local, const void* context, size_t size) {
+  static std::atomic<int> logged{0};
+  int count = logged.fetch_add(1, std::memory_order_relaxed);
+  if (count >= 64) {
+    if (count == 64) {
+      REXCPU_WARN("non_argument_as_local check: more differing sites, not logged");
+    }
+    return;
+  }
+  auto words = [size](const void* p) {
+    std::string text;
+    for (size_t i = 0; i < size; i += 4) {
+      u32 word;
+      std::memcpy(&word, static_cast<const u8*>(p) + i, 4);
+      text += fmt::format("{}{:08X}", i ? " " : "", word);
+    }
+    return text;
+  };
+  REXCPU_WARN("non_argument_as_local check: {} at {:08X} in {}: local {}, context {}", reg,
+              address, function, words(local), words(context));
+}
+
+#define REX_VERIFY_LOCAL(reg, address)                                          \
+  do {                                                                          \
+    if (__builtin_memcmp(&(reg), &ctx.reg, sizeof(reg)) != 0) [[unlikely]] {    \
+      static std::atomic<bool> rex_verify_reported{false};                      \
+      if (!rex_verify_reported.exchange(true, std::memory_order_relaxed)) {     \
+        ppc_report_local_difference(__func__, (address), #reg, &(reg), &ctx.reg, \
+                                    sizeof(reg));                               \
+      }                                                                         \
+    }                                                                           \
+  } while (0)
+
+{% endif %}//=============================================================================
 // Trap Handling
 //=============================================================================
 
