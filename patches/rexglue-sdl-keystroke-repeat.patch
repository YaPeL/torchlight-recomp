diff --git a/tests/unit/input/keystroke_repeat_test.cpp b/tests/unit/input/keystroke_repeat_test.cpp
new file mode 100644
index 0000000..c1fde12
--- /dev/null
+++ b/tests/unit/input/keystroke_repeat_test.cpp
@@ -0,0 +1,124 @@
+// Tests for NextKeystroke (input/keystroke_repeat.h): downs, ups, ordering and key repeat, which
+// must stop as soon as the repeated button is released.
+
+#include <catch2/catch_test_macros.hpp>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include <rex/input/keystroke_repeat.h>
+
+using rex::input::Keystroke;
+using rex::input::KeystrokeTracker;
+using rex::input::NextKeystroke;
+
+namespace {
+
+constexpr uint32_t kDelay = 400, kRate = 100;
+constexpr uint8_t kCount = 34;
+constexpr uint64_t kAll = (uint64_t(1) << kCount) - 1;
+constexpr uint8_t kA = 12, kB = 13;
+constexpr uint64_t Bit(uint8_t i) { return uint64_t(1) << i; }
+
+// Every keystroke the guest gets by reading until empty at `now`.
+std::vector<Keystroke> Drain(KeystrokeTracker& t, uint64_t pressed, uint32_t now,
+                             uint64_t reportable = kAll) {
+  std::vector<Keystroke> out;
+  while (auto k = NextKeystroke(t, pressed, reportable, kCount, now, kDelay, kRate)) {
+    out.push_back(*k);
+    REQUIRE(out.size() < 100);
+  }
+  return out;
+}
+
+bool Is(const Keystroke& k, uint8_t index, bool down, bool repeat) {
+  return k.index == index && k.down == down && k.repeat == repeat;
+}
+
+}  // namespace
+
+TEST_CASE("NextKeystroke reports a press and a release", "[input][keystroke]") {
+  KeystrokeTracker t;
+  auto down = Drain(t, Bit(kA), 1000);
+  REQUIRE(down.size() == 1);
+  CHECK(Is(down[0], kA, true, false));
+  CHECK(Drain(t, Bit(kA), 1016).empty());
+  auto up = Drain(t, 0, 1032);
+  REQUIRE(up.size() == 1);
+  CHECK(Is(up[0], kA, false, false));
+  CHECK(Drain(t, 0, 1048).empty());
+}
+
+TEST_CASE("NextKeystroke repeats a held button after the delay, at the rate",
+          "[input][keystroke]") {
+  KeystrokeTracker t;
+  Drain(t, Bit(kA), 1000);
+  CHECK(Drain(t, Bit(kA), 1400).empty());  // not past the delay yet
+  auto first = Drain(t, Bit(kA), 1401);
+  REQUIRE(first.size() == 1);
+  CHECK(Is(first[0], kA, true, true));
+  CHECK(Drain(t, Bit(kA), 1450).empty());
+  auto second = Drain(t, Bit(kA), 1502);
+  REQUIRE(second.size() == 1);
+  CHECK(Is(second[0], kA, true, true));
+  auto up = Drain(t, 0, 1510);
+  REQUIRE(up.size() == 1);
+  CHECK(Is(up[0], kA, false, false));
+}
+
+TEST_CASE("NextKeystroke does not repeat a button released while nobody read keystrokes",
+          "[input][keystroke]") {
+  // Pressed, then the guest stops reading (a loading screen) and the button is released
+  // meanwhile: the next read gets only its up, never a repeated down.
+  KeystrokeTracker t;
+  Drain(t, Bit(kA), 1000);
+  auto after_load = Drain(t, 0, 2500);
+  REQUIRE(after_load.size() == 1);
+  CHECK(Is(after_load[0], kA, false, false));
+  CHECK(Drain(t, 0, 2600).empty());
+}
+
+TEST_CASE("NextKeystroke stops repeating once the button is released", "[input][keystroke]") {
+  KeystrokeTracker t;
+  Drain(t, Bit(kA), 1000);
+  Drain(t, Bit(kA), 1401);  // repeating
+  auto later = Drain(t, 0, 3000);
+  REQUIRE(later.size() == 1);
+  CHECK(Is(later[0], kA, false, false));
+}
+
+TEST_CASE("NextKeystroke repeats the button pressed last, while it is held",
+          "[input][keystroke]") {
+  KeystrokeTracker t;
+  Drain(t, Bit(kA), 1000);
+  auto b = Drain(t, Bit(kA) | Bit(kB), 1100);
+  REQUIRE(b.size() == 1);
+  CHECK(Is(b[0], kB, true, false));
+  auto repeat = Drain(t, Bit(kA) | Bit(kB), 1501);
+  REQUIRE(repeat.size() == 1);
+  CHECK(Is(repeat[0], kB, true, true));
+  // B released, A still held: B's up, and no repeat of either afterwards.
+  auto up = Drain(t, Bit(kA), 1600);
+  REQUIRE(up.size() == 1);
+  CHECK(Is(up[0], kB, false, false));
+  CHECK(Drain(t, Bit(kA), 3000).empty());
+}
+
+TEST_CASE("NextKeystroke reports ups before downs", "[input][keystroke]") {
+  KeystrokeTracker t;
+  Drain(t, Bit(kA), 1000);
+  auto swap = Drain(t, Bit(kB), 1016);
+  REQUIRE(swap.size() == 2);
+  CHECK(Is(swap[0], kA, false, false));
+  CHECK(Is(swap[1], kB, true, false));
+}
+
+TEST_CASE("NextKeystroke never reports buttons outside the reportable mask",
+          "[input][keystroke]") {
+  KeystrokeTracker t;
+  const uint64_t reportable = kAll & ~Bit(10);  // the guide button has no virtual key
+  CHECK(Drain(t, Bit(10), 1000, reportable).empty());
+  auto a = Drain(t, Bit(10) | Bit(kA), 1016, reportable);
+  REQUIRE(a.size() == 1);
+  CHECK(Is(a[0], kA, true, false));
+}
