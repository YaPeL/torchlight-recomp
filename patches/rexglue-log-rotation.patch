+/**
+ * @file        tests/unit/core/log_rotation_test.cpp
+ * @brief       The log file sink rotates within log_max_file_size_mb x (1 + log_max_files)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+
+#include <catch2/catch_test_macros.hpp>
+#include <spdlog/logger.h>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+namespace fs = std::filesystem;
+
+TEST_CASE("A run's log rotates instead of growing", "[logging]") {
+  const fs::path dir = fs::temp_directory_path() / "rex_log_rotation_test";
+  fs::remove_all(dir);
+  fs::create_directories(dir);
+  const fs::path file = dir / "app_001.log";
+
+  // Put the cvars back however the test ends, so the rest of unit_tests keeps the defaults.
+  struct RestoreFlags {
+    std::string size = rex::cvar::GetFlagByName("log_max_file_size_mb");
+    std::string count = rex::cvar::GetFlagByName("log_max_files");
+    ~RestoreFlags() {
+      rex::cvar::SetFlagByName("log_max_file_size_mb", size);
+      rex::cvar::SetFlagByName("log_max_files", count);
+    }
+  } restore;
+  REQUIRE(rex::cvar::SetFlagByName("log_max_file_size_mb", "1"));
+  REQUIRE(rex::cvar::SetFlagByName("log_max_files", "2"));
+  {
+    spdlog::logger logger("log_rotation_test", rex::detail::MakeLogFileSink(file));
+    // About 4 MB: more than the 3 files of 1 MB the run may keep.
+    const std::string line(1000, 'x');
+    for (int i = 0; i < 4000; ++i) {
+      logger.info("{} {}", i, line);
+    }
+    logger.flush();
+  }
+
+  uint64_t total = 0;
+  int files = 0;
+  for (const auto& entry : fs::directory_iterator(dir)) {
+    total += entry.file_size();
+    ++files;
+  }
+  CHECK(fs::exists(file));
+  CHECK(fs::exists(dir / "app_001.1.log"));
+  CHECK(fs::exists(dir / "app_001.2.log"));
+  CHECK_FALSE(fs::exists(dir / "app_001.3.log"));
+  CHECK(files == 3);
+  CHECK(total <= 3u * 1024 * 1024);
+  fs::remove_all(dir);
+}
