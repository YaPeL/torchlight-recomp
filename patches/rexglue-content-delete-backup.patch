@@ -0,0 +1,161 @@
+#include <algorithm>
+#include <cstdio>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/filesystem.h>
+#include <rex/system/xam/content_manager.h>
+
+using rex::X_RESULT;
+using rex::system::XContentType;
+using rex::system::xam::ContentManager;
+using rex::system::xam::XCONTENT_AGGREGATE_DATA;
+
+namespace {
+
+constexpr uint64_t kXuid = 0xB13EBABEBABEBABEull;
+constexpr uint32_t kTitleId = 0x58410A7E;
+
+// A user data root with one saved-game package (two files) and its header.
+class ContentRoot {
+ public:
+  ContentRoot() {
+    root_ = std::filesystem::temp_directory_path() /
+            ("rexglue_content_delete_backup_" + std::to_string(counter_++));
+    std::error_code ec;
+    std::filesystem::remove_all(root_, ec);
+    CreatePackage();
+    data_.device_id = 1;
+    data_.content_type = XContentType::kSavedGame;
+    data_.set_file_name("torchlight.sav");
+    data_.xuid = kXuid;
+    data_.title_id = kTitleId;
+  }
+  ~ContentRoot() {
+    std::error_code ec;
+    std::filesystem::remove_all(root_, ec);
+  }
+
+  void CreatePackage() {
+    std::error_code ec;
+    std::filesystem::create_directories(package(), ec);
+    std::filesystem::create_directories(header().parent_path(), ec);
+    Write(package() / "0.TSV", "character zero");
+    Write(package() / "sharedstash.bin", "stash");
+    Write(header(), "header");
+  }
+
+  static void Write(const std::filesystem::path& path, const std::string& text) {
+    FILE* file = rex::filesystem::OpenFile(path, "wb");
+    REQUIRE(file != nullptr);
+    fwrite(text.data(), 1, text.size(), file);
+    fclose(file);
+  }
+
+  static std::string Read(const std::filesystem::path& path) {
+    FILE* file = rex::filesystem::OpenFile(path, "rb");
+    if (!file) return {};
+    std::string text(256, '\0');
+    text.resize(fread(text.data(), 1, text.size(), file));
+    fclose(file);
+    return text;
+  }
+
+  std::filesystem::path root() const { return root_; }
+  std::filesystem::path package() const {
+    return root_ / "B13EBABEBABEBABE" / "58410A7E" / "00000001" / "torchlight.sav";
+  }
+  std::filesystem::path header() const {
+    return root_ / "B13EBABEBABEBABE" / "58410A7E" / "Headers" / "00000001" /
+           "torchlight.sav.header";
+  }
+  std::filesystem::path backups() const { return root_ / "save-backups"; }
+  const XCONTENT_AGGREGATE_DATA& data() const { return data_; }
+
+  std::vector<std::filesystem::path> BackupDirs() const {
+    std::vector<std::filesystem::path> dirs;
+    std::error_code ec;
+    for (auto& entry : std::filesystem::directory_iterator(backups(), ec)) {
+      dirs.push_back(entry.path());
+    }
+    return dirs;
+  }
+
+ private:
+  static int counter_;
+  std::filesystem::path root_;
+  XCONTENT_AGGREGATE_DATA data_;
+};
+
+int ContentRoot::counter_ = 0;
+
+}  // namespace
+
+TEST_CASE("Deleting a package backs it up first", "[content][xam]") {
+  ContentRoot root;
+  ContentManager manager(nullptr, root.root());
+
+  REQUIRE(manager.DeleteContent(kXuid, root.data()) == X_ERROR_SUCCESS);
+  CHECK_FALSE(std::filesystem::exists(root.package()));
+  CHECK_FALSE(std::filesystem::exists(root.header()));
+
+  auto dirs = root.BackupDirs();
+  REQUIRE(dirs.size() == 1);
+  CHECK(dirs[0].filename().string().ends_with("-torchlight.sav"));
+  CHECK(ContentRoot::Read(dirs[0] / "torchlight.sav" / "0.TSV") == "character zero");
+  CHECK(ContentRoot::Read(dirs[0] / "torchlight.sav" / "sharedstash.bin") == "stash");
+  CHECK(ContentRoot::Read(dirs[0] / "torchlight.sav.header") == "header");
+}
+
+TEST_CASE("A package is not deleted when its backup fails", "[content][xam]") {
+  ContentRoot root;
+  ContentManager manager(nullptr, root.root());
+  // A file where the backup directory should go makes the backup impossible.
+  ContentRoot::Write(root.backups(), "not a directory");
+
+  CHECK(manager.DeleteContent(kXuid, root.data()) == X_ERROR_ACCESS_DENIED);
+  CHECK(ContentRoot::Read(root.package() / "0.TSV") == "character zero");
+  CHECK(std::filesystem::exists(root.header()));
+}
+
+TEST_CASE("Repeated deletions keep separate backups", "[content][xam]") {
+  ContentRoot root;
+  ContentManager manager(nullptr, root.root());
+
+  REQUIRE(manager.DeleteContent(kXuid, root.data()) == X_ERROR_SUCCESS);
+  root.CreatePackage();
+  ContentRoot::Write(root.package() / "0.TSV", "second version");
+  REQUIRE(manager.DeleteContent(kXuid, root.data()) == X_ERROR_SUCCESS);
+
+  auto dirs = root.BackupDirs();
+  REQUIRE(dirs.size() == 2);
+  std::vector<std::string> contents;
+  for (auto& dir : dirs) contents.push_back(ContentRoot::Read(dir / "torchlight.sav" / "0.TSV"));
+  CHECK(std::find(contents.begin(), contents.end(), "character zero") != contents.end());
+  CHECK(std::find(contents.begin(), contents.end(), "second version") != contents.end());
+}
+
+TEST_CASE("Unmount and delete also backs up", "[content][xam]") {
+  ContentRoot root;
+  ContentManager manager(nullptr, root.root());
+
+  REQUIRE(manager.UnmountAndDeleteContent(kXuid, root.data()) == X_ERROR_SUCCESS);
+  CHECK_FALSE(std::filesystem::exists(root.package()));
+  auto dirs = root.BackupDirs();
+  REQUIRE(dirs.size() == 1);
+  CHECK(ContentRoot::Read(dirs[0] / "torchlight.sav" / "0.TSV") == "character zero");
+}
+
+TEST_CASE("Deleting a missing package makes no backup", "[content][xam]") {
+  ContentRoot root;
+  ContentManager manager(nullptr, root.root());
+  std::error_code ec;
+  std::filesystem::remove_all(root.package(), ec);
+  std::filesystem::remove(root.header(), ec);
+
+  CHECK(manager.DeleteContent(kXuid, root.data()) == X_ERROR_FILE_NOT_FOUND);
+  CHECK_FALSE(std::filesystem::exists(root.backups()));
+}
