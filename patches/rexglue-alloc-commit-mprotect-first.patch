+/**
+ * @file        memory/alloc_fixed_test.cpp
+ * @brief       rex::memory::AllocFixed's commit on the host, around the heaps' mapped views
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/memory/utils.h>
+
+#if defined(__linux__)
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace {
+
+using rex::memory::AllocationType;
+using rex::memory::AllocFixed;
+using rex::memory::PageAccess;
+
+/// Three pages reserved without access, as a heap reserves its range; unmapped when done.
+struct Reserved {
+  size_t page = size_t(sysconf(_SC_PAGESIZE));
+  uint8_t* base = static_cast<uint8_t*>(
+      mmap(nullptr, 3 * page, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
+  ~Reserved() { munmap(base, 3 * page); }
+};
+
+}  // namespace
+
+// The heaps commit over ranges they reserved or mapped as views: that is one mprotect.
+TEST_CASE("AllocFixed commits a reserved range in place", "[memory][alloc_fixed]") {
+  Reserved r;
+  REQUIRE(r.base != MAP_FAILED);
+  REQUIRE(AllocFixed(r.base + r.page, r.page, AllocationType::kCommit, PageAccess::kReadWrite) ==
+          r.base + r.page);
+  volatile uint8_t* page = r.base + r.page;
+  page[0] = 0x5A;
+  CHECK(page[0] == 0x5A);
+}
+
+// A range with nothing mapped there is mapped by the commit, as before mprotect was tried first.
+TEST_CASE("AllocFixed maps a commit where nothing is mapped", "[memory][alloc_fixed]") {
+  Reserved r;
+  REQUIRE(r.base != MAP_FAILED);
+  REQUIRE(munmap(r.base + r.page, r.page) == 0);
+  REQUIRE(AllocFixed(r.base + r.page, r.page, AllocationType::kCommit, PageAccess::kReadWrite) ==
+          r.base + r.page);
+  volatile uint8_t* page = r.base + r.page;
+  page[0] = 0x5A;
+  CHECK(page[0] == 0x5A);
+}
+
+// Part mapped and part not: the commit fails, as it did (a fixed mapping cannot replace the part
+// that is there).
+TEST_CASE("AllocFixed fails a commit over a range with a hole", "[memory][alloc_fixed]") {
+  Reserved r;
+  REQUIRE(r.base != MAP_FAILED);
+  REQUIRE(munmap(r.base + r.page, r.page) == 0);
+  CHECK(AllocFixed(r.base, 3 * r.page, AllocationType::kCommit, PageAccess::kReadWrite) ==
+        nullptr);
+}
+
+TEST_CASE("AllocFixed fails a commit of no bytes", "[memory][alloc_fixed]") {
+  Reserved r;
+  REQUIRE(r.base != MAP_FAILED);
+  CHECK(AllocFixed(r.base, 0, AllocationType::kCommit, PageAccess::kReadWrite) == nullptr);
+}
+#endif
