diff --git a/src/core/exception_handler_posix.cpp b/src/core/exception_handler_posix.cpp
index 8b1c76a..71c33f5 100644
--- a/src/core/exception_handler_posix.cpp
+++ b/src/core/exception_handler_posix.cpp
@@ -49,6 +49,45 @@ constexpr size_t kMaxHandlerCount = 8;
 // Executed in order.
 std::pair<ExceptionHandler::Handler, void*> handlers_[kMaxHandlerCount];
 
+// No handler claimed the fault. Hand it to the handler that was installed before ours, as the
+// system would have. Without one, restore the default action: the faulting instruction runs again
+// on return and ends the process with this signal. Returning alone would fault again, forever.
+// Our handler stays installed while a previous one runs, so it may still retry.
+static void ChainUnclaimedSignal(int signal_number, siginfo_t* signal_info, void* signal_context) {
+  const struct sigaction* previous = nullptr;
+  switch (signal_number) {
+    case SIGILL:
+      previous = &original_sigill_handler_;
+      break;
+    case SIGSEGV:
+      previous = &original_sigsegv_handler_;
+      break;
+#if REX_PLATFORM_MAC
+    case SIGBUS:
+      previous = &original_sigbus_handler_;
+      break;
+#endif
+    default:
+      break;
+  }
+  if (previous) {
+    if (previous->sa_flags & SA_SIGINFO) {
+      if (previous->sa_sigaction) {
+        previous->sa_sigaction(signal_number, signal_info, signal_context);
+        return;
+      }
+    } else if (previous->sa_handler != SIG_DFL && previous->sa_handler != SIG_IGN) {
+      previous->sa_handler(signal_number);
+      return;
+    }
+  }
+  struct sigaction default_action;
+  std::memset(&default_action, 0, sizeof(default_action));
+  default_action.sa_handler = SIG_DFL;
+  sigemptyset(&default_action.sa_mask);
+  sigaction(signal_number, &default_action, nullptr);
+}
+
 static void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info,
                                      void* signal_context) {
 #if REX_PLATFORM_MAC
@@ -175,6 +214,7 @@ static void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info,
       // On non-Mac POSIX, SIGBUS is a bus error (misaligned access), not a
       // protection fault — don't handle it here.
       assert_unhandled_case(signal_number);
+      ChainUnclaimedSignal(signal_number, signal_info, signal_context);
       return;
 #endif
       [[fallthrough]];
@@ -417,6 +457,7 @@ static void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info,
       return;
     }
   }
+  ChainUnclaimedSignal(signal_number, signal_info, signal_context);
 }
 
