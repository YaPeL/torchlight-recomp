diff --git a/src/system/thread_dump.cpp b/src/system/thread_dump.cpp
new file mode 100644
index 0000000..78a85ed
--- /dev/null
+++ b/src/system/thread_dump.cpp
@@ -0,0 +1,440 @@
+/**
+ * @file        system/thread_dump.cpp
+ * @brief       A dump of every guest thread's state, read without waiting on any lock
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/system/thread_dump.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <thread>
+
+#include <fmt/format.h>
+
+#include <rex/logging.h>
+
+namespace rex::system {
+
+namespace {
+
+using thread_dump::kMaxNameLength;
+using thread_dump::kMaxRecords;
+using thread_dump::kMaxWaitObjects;
+using thread_dump::WaitKind;
+using thread_dump::WaitObject;
+
+constexpr size_t kNameWords = (kMaxNameLength + 1) / 8;
+static_assert(kNameWords * 8 == kMaxNameLength + 1);
+
+// One thread's state. Only its own thread writes the ids and the wait, under `writer` and with
+// `sequence` odd while it does; the dump reads them without any lock and keeps a read only when
+// `sequence` was even and unchanged across it. Other threads write the name (under its own
+// `name_writer` and `name_sequence`) and the suspend count (one atomic), and never wait for a
+// record's writer: the record's thread may be suspended in the middle of a write. Every field is
+// an atomic, so a read that races a write is never undefined, only discarded.
+struct Record {
+  std::atomic<bool> in_use{false};
+  std::atomic_flag writer = ATOMIC_FLAG_INIT;
+  std::atomic<uint32_t> sequence{0};
+  std::atomic<uint32_t> thread_id{0};
+  std::atomic<uint32_t> host_thread_id{0};
+  std::atomic<uint32_t> suspend_count{0};
+  std::atomic_flag name_writer = ATOMIC_FLAG_INIT;
+  std::atomic<uint32_t> name_sequence{0};
+  std::array<std::atomic<uint64_t>, kNameWords> name{};
+  std::atomic<uint32_t> wait_kind{0};
+  std::atomic<uint32_t> wait_object_count{0};
+  std::array<std::atomic<uint32_t>, kMaxWaitObjects> wait_types{};
+  std::array<std::atomic<uint32_t>, kMaxWaitObjects> wait_handles{};
+  std::atomic<int64_t> wait_timeout_ms{0};
+  std::atomic<uint64_t> wait_guest_lr{0};
+  std::atomic<int64_t> wait_start_ms{0};
+};
+
+std::array<Record, kMaxRecords> records;
+std::atomic<uint32_t> unrecorded_threads{0};
+thread_local int current_record = -1;
+
+int64_t NowMs() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+// A write to one of a record's two parts (`writer` and `sequence`, or the name's), only if
+// nobody else is writing it: nothing here ever waits for a writer. The record's own thread is
+// the only writer of the ids and the wait, so there it always gets the part.
+class TryWriteScope {
+ public:
+  TryWriteScope(std::atomic_flag& writer, std::atomic<uint32_t>& sequence)
+      : writer_(writer), sequence_(sequence) {
+    owns_ = !writer_.test_and_set(std::memory_order_acquire);
+    if (owns_) {
+      sequence_.fetch_add(1, std::memory_order_relaxed);
+      std::atomic_thread_fence(std::memory_order_release);
+    }
+  }
+  ~TryWriteScope() {
+    if (owns_) {
+      sequence_.fetch_add(1, std::memory_order_release);
+      writer_.clear(std::memory_order_release);
+    }
+  }
+  bool owns() const { return owns_; }
+  TryWriteScope(const TryWriteScope&) = delete;
+  TryWriteScope& operator=(const TryWriteScope&) = delete;
+
+ private:
+  std::atomic_flag& writer_;
+  std::atomic<uint32_t>& sequence_;
+  bool owns_;
+};
+
+void StoreName(Record& record, std::string_view name) {
+  TryWriteScope write(record.name_writer, record.name_sequence);
+  if (!write.owns()) {
+    return;  // another thread is naming it at this moment
+  }
+  char bytes[kNameWords * 8] = {};
+  std::memcpy(bytes, name.data(), std::min(name.size(), kMaxNameLength));
+  for (size_t i = 0; i < kNameWords; ++i) {
+    uint64_t word;
+    std::memcpy(&word, bytes + i * 8, 8);
+    record.name[i].store(word, std::memory_order_relaxed);
+  }
+}
+
+Record* RecordAt(int index) {
+  if (index < 0 || static_cast<size_t>(index) >= kMaxRecords) {
+    return nullptr;
+  }
+  return &records[index];
+}
+
+// A record as the dump read it.
+struct Snapshot {
+  uint32_t thread_id;
+  uint32_t host_thread_id;
+  uint32_t suspend_count;
+  char name[kNameWords * 8];
+  WaitKind wait_kind;
+  uint32_t wait_object_count;
+  WaitObject wait_objects[kMaxWaitObjects];
+  int64_t wait_timeout_ms;
+  uint64_t wait_guest_lr;
+  int64_t wait_start_ms;
+};
+
+// False when the record was being written in every attempt; the attempts do not wait.
+bool TryRead(const Record& record, Snapshot* out) {
+  for (int attempt = 0; attempt < 3; ++attempt) {
+    uint32_t before = record.sequence.load(std::memory_order_acquire);
+    if (before & 1) {
+      continue;
+    }
+    out->thread_id = record.thread_id.load(std::memory_order_relaxed);
+    out->host_thread_id = record.host_thread_id.load(std::memory_order_relaxed);
+    out->wait_kind = static_cast<WaitKind>(record.wait_kind.load(std::memory_order_relaxed));
+    out->wait_object_count = record.wait_object_count.load(std::memory_order_relaxed);
+    for (size_t i = 0; i < kMaxWaitObjects; ++i) {
+      out->wait_objects[i] = {record.wait_types[i].load(std::memory_order_relaxed),
+                              record.wait_handles[i].load(std::memory_order_relaxed)};
+    }
+    out->wait_timeout_ms = record.wait_timeout_ms.load(std::memory_order_relaxed);
+    out->wait_guest_lr = record.wait_guest_lr.load(std::memory_order_relaxed);
+    out->wait_start_ms = record.wait_start_ms.load(std::memory_order_relaxed);
+    std::atomic_thread_fence(std::memory_order_acquire);
+    if (record.sequence.load(std::memory_order_relaxed) == before) {
+      out->suspend_count = record.suspend_count.load(std::memory_order_relaxed);
+      return true;
+    }
+  }
+  return false;
+}
+
+// The name, or "(name being written)" when it was being written in every attempt.
+void ReadName(const Record& record, Snapshot* out) {
+  for (int attempt = 0; attempt < 3; ++attempt) {
+    uint32_t before = record.name_sequence.load(std::memory_order_acquire);
+    if (before & 1) {
+      continue;
+    }
+    for (size_t i = 0; i < kNameWords; ++i) {
+      uint64_t word = record.name[i].load(std::memory_order_relaxed);
+      std::memcpy(out->name + i * 8, &word, 8);
+    }
+    out->name[sizeof(out->name) - 1] = '\0';
+    std::atomic_thread_fence(std::memory_order_acquire);
+    if (record.name_sequence.load(std::memory_order_relaxed) == before) {
+      return;
+    }
+  }
+  std::snprintf(out->name, sizeof(out->name), "(name being written)");
+}
+
+const char* WaitKindName(WaitKind kind) {
+  switch (kind) {
+    case WaitKind::kSingle:
+      return "wait";
+    case WaitKind::kAll:
+      return "wait for all";
+    case WaitKind::kAny:
+      return "wait for any";
+    case WaitKind::kSignalAndWait:
+      return "signal and wait";
+    case WaitKind::kDelay:
+      return "delay";
+    case WaitKind::kNone:
+      break;
+  }
+  return "none";
+}
+
+// XObject::Type, in its order.
+const char* ObjectTypeName(uint32_t type) {
+  static constexpr const char* kNames[] = {
+      "Undefined", "Enumerator",     "Event",   "File",    "IOCompletion",
+      "Module",    "Mutant",         "NotifyListener",     "Semaphore",
+      "Session",   "Socket",         "SymbolicLink",       "Thread",  "Timer",
+  };
+  return type < std::size(kNames) ? kNames[type] : "?";
+}
+
+void AppendThread(const Snapshot& snapshot, int64_t now_ms, std::string& out) {
+  fmt::format_to(std::back_inserter(out), "  \"{}\" id {:08X} host tid {}: ", snapshot.name,
+                 snapshot.thread_id, snapshot.host_thread_id);
+  if (snapshot.suspend_count) {
+    fmt::format_to(std::back_inserter(out), "suspended ({}), ", snapshot.suspend_count);
+  }
+  if (snapshot.wait_kind == WaitKind::kNone) {
+    out += "running\n";
+    return;
+  }
+  fmt::format_to(std::back_inserter(out), "waiting {:.1f} s in {}",
+                 (now_ms - snapshot.wait_start_ms) / 1000.0, WaitKindName(snapshot.wait_kind));
+  uint32_t shown = std::min<uint32_t>(snapshot.wait_object_count, kMaxWaitObjects);
+  for (uint32_t i = 0; i < shown; ++i) {
+    fmt::format_to(std::back_inserter(out), "{} {} {:08X}", i ? "," : " on",
+                   ObjectTypeName(snapshot.wait_objects[i].type), snapshot.wait_objects[i].handle);
+  }
+  if (snapshot.wait_object_count > shown) {
+    fmt::format_to(std::back_inserter(out), " and {} more", snapshot.wait_object_count - shown);
+  }
+  if (snapshot.wait_timeout_ms < 0) {
+    out += ", no timeout";
+  } else {
+    fmt::format_to(std::back_inserter(out), ", timeout {} ms", snapshot.wait_timeout_ms);
+  }
+  fmt::format_to(std::back_inserter(out), ", guest LR {:08X}\n", snapshot.wait_guest_lr);
+}
+
+// Registered sections. A dump counts itself in `users` before it looks at `ready`, and
+// Unregister clears `ready` before it waits for `users` to drop, so no dump runs a section after
+// Unregister returns (both sequentially consistent).
+struct Section {
+  std::atomic<bool> claimed{false};
+  std::atomic<bool> ready{false};
+  std::atomic<ThreadDumpSection> function{nullptr};
+  std::atomic<void*> context{nullptr};
+  std::atomic<int> users{0};
+};
+
+constexpr size_t kMaxSections = 4;
+std::array<Section, kMaxSections> sections;
+
+}  // namespace
+
+bool RegisterThreadDumpSection(ThreadDumpSection function, void* context) {
+  for (Section& section : sections) {
+    bool expected = false;
+    if (section.claimed.compare_exchange_strong(expected, true)) {
+      section.function.store(function);
+      section.context.store(context);
+      section.ready.store(true);
+      return true;
+    }
+  }
+  return false;
+}
+
+void UnregisterThreadDumpSection(ThreadDumpSection function, void* context) {
+  for (Section& section : sections) {
+    if (!section.ready.load() || section.function.load() != function ||
+        section.context.load() != context) {
+      continue;
+    }
+    section.ready.store(false);
+    while (section.users.load() != 0) {
+      std::this_thread::yield();
+    }
+    section.function.store(nullptr);
+    section.context.store(nullptr);
+    section.claimed.store(false);
+    return;
+  }
+}
+
+std::string FormatThreadDump(std::string_view reason) {
+  std::string out;
+  fmt::format_to(std::back_inserter(out), "Thread dump ({}):\n", reason);
+  int64_t now_ms = NowMs();
+  size_t shown = 0;
+  size_t inconsistent = 0;
+  for (const Record& record : records) {
+    if (!record.in_use.load(std::memory_order_acquire)) {
+      continue;
+    }
+    Snapshot snapshot;
+    if (!TryRead(record, &snapshot)) {
+      ++inconsistent;
+      continue;
+    }
+    ReadName(record, &snapshot);
+    AppendThread(snapshot, now_ms, out);
+    ++shown;
+  }
+  fmt::format_to(std::back_inserter(out), "  {} threads", shown);
+  if (inconsistent) {
+    fmt::format_to(std::back_inserter(out), "; {} inconsistent (being written)", inconsistent);
+  }
+  if (uint32_t unrecorded = unrecorded_threads.load(std::memory_order_relaxed)) {
+    fmt::format_to(std::back_inserter(out), "; {} not recorded (table full)", unrecorded);
+  }
+  out += "\n";
+  for (Section& section : sections) {
+    section.users.fetch_add(1);
+    if (section.ready.load()) {
+      section.function.load()(section.context.load(), out);
+    }
+    section.users.fetch_sub(1);
+  }
+  return out;
+}
+
+void LogThreadDump(std::string_view reason) {
+  std::string text = FormatThreadDump(reason);
+  if (!text.empty() && text.back() == '\n') {
+    text.pop_back();
+  }
+  REXSYS_ERROR("{}", text);
+}
+
+namespace thread_dump {
+
+int AcquireRecord(uint32_t thread_id, uint32_t host_thread_id, std::string_view name) {
+  for (size_t i = 0; i < kMaxRecords; ++i) {
+    Record& record = records[i];
+    bool expected = false;
+    if (!record.in_use.compare_exchange_strong(expected, true, std::memory_order_acq_rel)) {
+      continue;
+    }
+    {
+      TryWriteScope write(record.writer, record.sequence);
+      if (!write.owns()) {
+        // Left held by a thread that was killed while writing it: never used again.
+        continue;
+      }
+      record.thread_id.store(thread_id, std::memory_order_relaxed);
+      record.host_thread_id.store(host_thread_id, std::memory_order_relaxed);
+      record.wait_kind.store(static_cast<uint32_t>(WaitKind::kNone), std::memory_order_relaxed);
+    }
+    record.suspend_count.store(0, std::memory_order_relaxed);
+    StoreName(record, name);
+    current_record = static_cast<int>(i);
+    return current_record;
+  }
+  unrecorded_threads.fetch_add(1, std::memory_order_relaxed);
+  return -1;
+}
+
+void ReleaseRecord(int index) {
+  Record* record = RecordAt(index);
+  if (!record) {
+    return;
+  }
+  {
+    // Called by another thread too (XThread::Terminate): it does not wait for the record.
+    TryWriteScope write(record->writer, record->sequence);
+    if (write.owns()) {
+      record->wait_kind.store(static_cast<uint32_t>(WaitKind::kNone), std::memory_order_relaxed);
+    }
+  }
+  record->in_use.store(false, std::memory_order_release);
+  if (current_record == index) {
+    current_record = -1;
+  }
+}
+
+void SetName(int index, std::string_view name) {
+  if (Record* record = RecordAt(index)) {
+    StoreName(*record, name);
+  }
+}
+
+void SetSuspendCount(int index, uint32_t suspend_count) {
+  if (Record* record = RecordAt(index)) {
+    record->suspend_count.store(suspend_count, std::memory_order_relaxed);
+  }
+}
+
+int CurrentRecord() {
+  return current_record;
+}
+
+void BeginWait(WaitKind kind, std::span<const WaitObject> objects, uint32_t object_count,
+               int64_t timeout_ms, uint64_t guest_lr) {
+  Record* record = RecordAt(current_record);
+  if (!record) {
+    return;
+  }
+  TryWriteScope write(record->writer, record->sequence);
+  if (!write.owns()) {
+    return;
+  }
+  record->wait_kind.store(static_cast<uint32_t>(kind), std::memory_order_relaxed);
+  record->wait_object_count.store(object_count, std::memory_order_relaxed);
+  size_t shown = std::min(objects.size(), kMaxWaitObjects);
+  for (size_t i = 0; i < shown; ++i) {
+    record->wait_types[i].store(objects[i].type, std::memory_order_relaxed);
+    record->wait_handles[i].store(objects[i].handle, std::memory_order_relaxed);
+  }
+  record->wait_timeout_ms.store(timeout_ms, std::memory_order_relaxed);
+  record->wait_guest_lr.store(guest_lr, std::memory_order_relaxed);
+  record->wait_start_ms.store(NowMs(), std::memory_order_relaxed);
+}
+
+void EndWait() {
+  Record* record = RecordAt(current_record);
+  if (!record) {
+    return;
+  }
+  TryWriteScope write(record->writer, record->sequence);
+  if (write.owns()) {
+    record->wait_kind.store(static_cast<uint32_t>(WaitKind::kNone), std::memory_order_relaxed);
+  }
+}
+
+ScopedWriteForTesting::ScopedWriteForTesting(int record) : record_(record) {
+  Record& target = records.at(record_);
+  while (target.writer.test_and_set(std::memory_order_acquire)) {
+    std::this_thread::yield();
+  }
+  target.sequence.fetch_add(1, std::memory_order_relaxed);
+}
+
+ScopedWriteForTesting::~ScopedWriteForTesting() {
+  Record& target = records.at(record_);
+  target.sequence.fetch_add(1, std::memory_order_release);
+  target.writer.clear(std::memory_order_release);
+}
+
+}  // namespace thread_dump
+
+}  // namespace rex::system
