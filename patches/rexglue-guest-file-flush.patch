+/**
+ * @file        tests/unit/core/vfs_flush_test.cpp
+ * @brief       Guest flushes reach the host file (NtFlushBuffersFile, FlushFileBuffers,
+ *              XamContentFlush and XamContentClose go through File::Flush)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/filesystem.h>
+#include <rex/filesystem/devices/host_path_device.h>
+#include <rex/filesystem/devices/host_path_entry.h>
+#include <rex/filesystem/devices/host_path_file.h>
+#include <rex/filesystem/entry.h>
+#include <rex/filesystem/file.h>
+#include <rex/filesystem/vfs.h>
+
+using rex::X_STATUS;
+using rex::filesystem::Entry;
+using rex::filesystem::File;
+using rex::filesystem::FileAccess;
+using rex::filesystem::FileAction;
+using rex::filesystem::FileDisposition;
+using rex::filesystem::FileHandle;
+using rex::filesystem::FlushFilesOnDevice;
+using rex::filesystem::HostPathDevice;
+using rex::filesystem::HostPathEntry;
+using rex::filesystem::HostPathFile;
+using rex::filesystem::VirtualFileSystem;
+
+namespace {
+
+// A host handle that counts its flushes and fails them on request.
+class CountingHandle : public FileHandle {
+ public:
+  CountingHandle(int* flushes, bool fail) : FileHandle("counting"), flushes_(flushes), fail_(fail) {}
+  bool Read(size_t, void*, size_t, size_t* out) override {
+    *out = 0;
+    return true;
+  }
+  bool Write(size_t, const void*, size_t length, size_t* out) override {
+    *out = length;
+    return true;
+  }
+  bool SetLength(size_t) override { return true; }
+  bool Flush() override {
+    ++*flushes_;
+    return !fail_;
+  }
+
+ private:
+  int* flushes_;
+  bool fail_;
+};
+
+// Two writable host directories mounted as devices \Flush\A and \Flush\B, each with one file.
+class FlushStore {
+ public:
+  FlushStore() {
+    base_ = std::filesystem::temp_directory_path() /
+            ("rexglue_vfs_flush_" + std::to_string(counter_++));
+    std::error_code ec;
+    std::filesystem::remove_all(base_, ec);
+    for (const char* name : {"A", "B"}) {
+      std::filesystem::create_directories(base_ / name, ec);
+      FILE* file = rex::filesystem::OpenFile(base_ / name / "save.dat", "wb");
+      REQUIRE(file != nullptr);
+      fputs("save", file);
+      fclose(file);
+      auto device = std::make_unique<HostPathDevice>(std::string("\\Flush\\") + name,
+                                                     base_ / name, false, true);
+      REQUIRE(device->Initialize());
+      REQUIRE(vfs_.RegisterDevice(std::move(device)));
+    }
+  }
+  ~FlushStore() {
+    std::error_code ec;
+    std::filesystem::remove_all(base_, ec);
+  }
+
+  HostPathEntry* EntryOn(const char* device) {
+    Entry* entry = vfs_.ResolvePath(std::string("\\Flush\\") + device + "\\save.dat");
+    REQUIRE(entry != nullptr);
+    return static_cast<HostPathEntry*>(entry);
+  }
+  // A file on `device` whose host handle counts into `flushes`.
+  File* CountingFile(const char* device, uint32_t access, int* flushes, bool fail = false) {
+    return new HostPathFile(access, EntryOn(device), std::make_unique<CountingHandle>(flushes, fail));
+  }
+  File* OpenReal(const char* device, uint32_t access) {
+    File* file = nullptr;
+    FileAction action;
+    REQUIRE(vfs_.OpenFile(nullptr, std::string("\\Flush\\") + device + "\\save.dat",
+                          FileDisposition::kOpen, access, false, true, &file,
+                          &action) == X_STATUS_SUCCESS);
+    return file;
+  }
+
+ private:
+  static inline int counter_ = 0;
+  std::filesystem::path base_;
+  VirtualFileSystem vfs_;
+};
+
+}  // namespace
+
+TEST_CASE("A writable host file's flush reaches its host handle", "[filesystem][vfs][flush]") {
+  FlushStore store;
+  int flushes = 0;
+  File* file = store.CountingFile("A", FileAccess::kGenericWrite, &flushes);
+  CHECK(file->Flush() == X_STATUS_SUCCESS);
+  CHECK(flushes == 1);
+  file->Destroy();
+}
+
+TEST_CASE("A failed host flush is reported", "[filesystem][vfs][flush]") {
+  FlushStore store;
+  int flushes = 0;
+  File* file = store.CountingFile("A", FileAccess::kFileWriteData, &flushes, /*fail=*/true);
+  CHECK(file->Flush() != X_STATUS_SUCCESS);
+  CHECK(flushes == 1);
+  file->Destroy();
+}
+
+TEST_CASE("A read-only handle has nothing to flush", "[filesystem][vfs][flush]") {
+  FlushStore store;
+  int flushes = 0;
+  File* file = store.CountingFile("A", FileAccess::kGenericRead, &flushes);
+  CHECK(file->Flush() == X_STATUS_SUCCESS);
+  CHECK(flushes == 0);
+  file->Destroy();
+}
+
+TEST_CASE("A content flush writes through the files on its device only",
+          "[filesystem][vfs][flush]") {
+  FlushStore store;
+  int a1 = 0, a2 = 0, b = 0;
+  File* on_a1 = store.CountingFile("A", FileAccess::kGenericWrite, &a1);
+  File* on_a2 = store.CountingFile("A", FileAccess::kGenericWrite, &a2, /*fail=*/true);
+  File* on_b = store.CountingFile("B", FileAccess::kGenericWrite, &b);
+  const std::vector<File*> files = {on_a1, nullptr, on_a2, on_b};
+
+  // Every file of \Flush\A is flushed, the failing one too, and its failure comes back.
+  CHECK(FlushFilesOnDevice(files, "\\Flush\\A") != X_STATUS_SUCCESS);
+  CHECK(a1 == 1);
+  CHECK(a2 == 1);
+  CHECK(b == 0);
+
+  CHECK(FlushFilesOnDevice(files, "\\Flush\\B") == X_STATUS_SUCCESS);
+  CHECK(b == 1);
+  CHECK(FlushFilesOnDevice(files, "\\Flush\\C") == X_STATUS_SUCCESS);
+
+  on_a1->Destroy();
+  on_a2->Destroy();
+  on_b->Destroy();
+}
+
+TEST_CASE("A real host file flushes after a write", "[filesystem][vfs][flush]") {
+  FlushStore store;
+  File* file = store.OpenReal("A", FileAccess::kGenericRead | FileAccess::kGenericWrite);
+  const std::string text = "new save";
+  size_t written = 0;
+  REQUIRE(file->WriteSync({reinterpret_cast<const uint8_t*>(text.data()), text.size()}, 0,
+                          &written) == X_STATUS_SUCCESS);
+  CHECK(file->Flush() == X_STATUS_SUCCESS);  // fsync, or F_FULLFSYNC on Apple
+  file->Destroy();
+}
