<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Windows application manifest of every executable (the game, the replay, the tests), a source of
     each one (top CMakeLists.txt) that the linker merges into the manifest it embeds:
     - activeCodePage UTF-8 (Windows 10 1903 and later): the process code page is UTF-8, so the
       UTF-8 std::string paths the code passes to std::filesystem, the C runtime and OGRE reach the
       file system intact under user names with accents or an n with tilde (docs/windows-port.md);
     - per-monitor DPI awareness (V2, with the older per-monitor form as the fallback) from the
       start of the process, before SDL sets it: window sizes are real pixels and the runtime's
       dialogs take clicks where they are drawn. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
