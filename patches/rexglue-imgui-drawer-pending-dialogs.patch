   }
+  // Dialogs still open (e.g. the game quit with a XAM dialog showing): delete
+  // them, which signals their waiting fences. Otherwise the kernel dispatch
+  // thread stays blocked in xeXamDispatchDialogEx and the KernelState teardown
+  // waits for it forever. Their close callbacks do not run, so the pending XAM
+  // operation completes with an unspecified result; the title is exiting.
+  while (!dialogs_.empty()) {
+    delete dialogs_.back();  // ~ImGuiDialog removes it from dialogs_
+  }
   if (internal_state_) {
     ImGui::DestroyContext(internal_state_);
     internal_state_ = nullptr;
