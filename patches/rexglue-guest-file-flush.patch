+X_STATUS FlushFilesOnDevice(std::span<File* const> files, std::string_view device_mount_path) {
+  X_STATUS result = X_STATUS_SUCCESS;
+  for (File* file : files) {
+    const Entry* entry = file ? file->entry() : nullptr;
+    if (!entry || entry->device()->mount_path() != device_mount_path) {
+      continue;
+    }
+    const X_STATUS status = file->Flush();
+    if (XFAILED(status) && XSUCCEEDED(result)) {
+      result = status;
+    }
+  }
+  return result;
+}
