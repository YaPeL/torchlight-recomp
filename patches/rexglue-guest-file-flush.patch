+namespace {
+
+constexpr uint32_t kDeleteAccess = 0x00010000;  // NT DELETE
+
+// A host handle that counts its flushes and fails them on request.
+class CountingHandle : public FileHandle {
+ public:
+  CountingHandle(int* flushes, bool fail) : FileHandle("counting"), flushes_(flushes), fail_(fail) {}
+  bool Read(size_t, void*, size_t, size_t* out) override {
+    *out = 0;
+    return true;
+  }
+  bool Write(size_t, const void*, size_t length, size_t* out) override {
+    *out = length;
+    return true;
+  }
+  bool SetLength(size_t) override { return true; }
+  bool Flush() override {
+    ++*flushes_;
+    return !fail_;
+  }
+
+ private:
+  int* flushes_;
+  bool fail_;
+};
+
+// A writable host folder mounted as save: (like a content package), holding the old
+// character file 4.tsv.
+class SaveStore {
+ public:
+  explicit SaveStore(bool track) {
+    root_ = std::filesystem::temp_directory_path() /
+            ("rexglue_vfs_flush_" + std::to_string(counter_++));
+    std::error_code ec;
+    std::filesystem::remove_all(root_, ec);
+    std::filesystem::create_directories(root_, ec);
+    FILE* file = rex::filesystem::OpenFile(root_ / "4.tsv", "wb");
+    REQUIRE(file != nullptr);
+    fputs("old character", file);
+    fclose(file);
+    auto device = std::make_unique<HostPathDevice>("\\SaveStore", root_, false, true);
+    REQUIRE(device->Initialize());
+    if (track) device->EnableChangeTracking();
+    device_ = device.get();
+    REQUIRE(vfs_.RegisterDevice(std::move(device)));
+    REQUIRE(vfs_.RegisterSymbolicLink("save:", "\\SaveStore"));
+  }
+  ~SaveStore() {
+    std::error_code ec;
+    std::filesystem::remove_all(root_, ec);
+  }
+
+  HostPathDevice& device() { return *device_; }
+  bool HostExists(const std::string& name) { return std::filesystem::exists(root_ / name); }
+
+  File* Open(const std::string& name, FileDisposition disposition, uint32_t access) {
+    File* file = nullptr;
+    FileAction action;
+    REQUIRE(vfs_.OpenFile(nullptr, "save:\\" + name, disposition, access, false, true, &file,
+                          &action) == X_STATUS_SUCCESS);
+    return file;
+  }
+  // Writes `text` through a handle that is closed again, as a game does before it closes the
+  // content.
+  void Write(const std::string& name, FileDisposition disposition, const std::string& text) {
+    File* file = Open(name, disposition, FileAccess::kGenericWrite);
+    size_t written = 0;
+    REQUIRE(file->WriteSync({reinterpret_cast<const uint8_t*>(text.data()), text.size()}, 0,
+                            &written) == X_STATUS_SUCCESS);
+    file->Destroy();
+  }
+  X_STATUS Rename(const std::string& from, const std::string& to) {
+    File* file = Open(from, FileDisposition::kOpen, kDeleteAccess);
+    const X_STATUS status = file->entry()->Rename(rex::to_path("save:\\" + to), true);
+    file->Destroy();
+    return status;
+  }
+  bool Delete(const std::string& name) { return vfs_.DeletePath("save:\\" + name); }
+  File* CountingFile(uint32_t access, int* flushes, bool fail = false) {
+    auto* entry = static_cast<HostPathEntry*>(vfs_.ResolvePath("save:\\4.tsv"));
+    REQUIRE(entry != nullptr);
+    return new HostPathFile(access, entry, std::make_unique<CountingHandle>(flushes, fail));
+  }
+
+ private:
+  static inline int counter_ = 0;
+  std::filesystem::path root_;
+  VirtualFileSystem vfs_;
+  HostPathDevice* device_ = nullptr;
+};
+
+}  // namespace
+
+TEST_CASE("A writable handle's flush reaches its host handle", "[filesystem][vfs][flush]") {
+  SaveStore store(false);
+  int flushes = 0;
+  File* file = store.CountingFile(FileAccess::kGenericWrite, &flushes);
+  CHECK(file->Flush() == X_STATUS_SUCCESS);
+  CHECK(flushes == 1);
+  file->Destroy();
+
+  int failing = 0;
+  file = store.CountingFile(FileAccess::kFileWriteData, &failing, /*fail=*/true);
+  CHECK(file->Flush() != X_STATUS_SUCCESS);
+  CHECK(failing == 1);
+  file->Destroy();
+
+  int read_only = 0;
+  file = store.CountingFile(FileAccess::kGenericRead, &read_only);
+  CHECK(file->Flush() == X_STATUS_SUCCESS);  // nothing written through it
+  CHECK(read_only == 0);
+  file->Destroy();
+}
+
+TEST_CASE("Without change tracking a device flushes nothing", "[filesystem][vfs][flush]") {
+  SaveStore store(false);
+  store.Write("new.tsv", FileDisposition::kCreate, "data");
+  const auto flushed = store.device().FlushChanges();
+  CHECK(flushed.files == 0);
+  CHECK(flushed.folders == 0);
+}
+
+TEST_CASE("A content flush writes through the files written since mount, closed or not",
+          "[filesystem][vfs][flush]") {
+  SaveStore store(true);
+  store.Write("new.tsv", FileDisposition::kCreate, "data");      // created, closed
+  store.Write("4.tsv", FileDisposition::kOverwrite, "changed");  // truncated and rewritten, closed
+  auto flushed = store.device().FlushChanges();
+  CHECK(flushed.files == 2);
+  CHECK(flushed.folders == 1);  // new.tsv's entry
+  CHECK(flushed.failed == 0);
+
+  // Flushed changes are forgotten; reads change nothing.
+  File* read = store.Open("4.tsv", FileDisposition::kOpen, FileAccess::kGenericRead);
+  read->Destroy();
+  flushed = store.device().FlushChanges();
+  CHECK(flushed.files == 0);
+  CHECK(flushed.folders == 0);
+}
+
+TEST_CASE("A save that replaces its file by rename is flushed with its folder",
+          "[filesystem][vfs][flush]") {
+  // Torchlight's save: the new character file under a temporary name, the old one removed, the
+  // temporary renamed into place (4.tsv becomes 4.TSV).
+  SaveStore store(true);
+  store.Write("save.tmp", FileDisposition::kCreate, "new character");
+  REQUIRE(store.Delete("4.tsv"));
+  REQUIRE(store.Rename("save.tmp", "4.TSV") == X_STATUS_SUCCESS);
+  REQUIRE(store.HostExists("4.TSV"));
+
+  const auto flushed = store.device().FlushChanges();
+  CHECK(flushed.files == 1);    // 4.TSV; save.tmp and 4.tsv are gone
+  CHECK(flushed.folders == 1);  // the creation, the removal and the rename
+  CHECK(flushed.failed == 0);
+}
+
+TEST_CASE("A removed file leaves only its folder to flush", "[filesystem][vfs][flush]") {
+  SaveStore store(true);
+  store.Write("new.tsv", FileDisposition::kCreate, "data");
+  REQUIRE(store.Delete("new.tsv"));
+  const auto flushed = store.device().FlushChanges();
+  CHECK(flushed.files == 0);
+  CHECK(flushed.folders == 1);
+}
