Patch 35. In the series since 2026-10-17, after patch 34.

A cross build (Android) cannot run the rexglue it builds, and the codegen steps run it: a
consumer's (generated/rexglue.cmake, $<TARGET_FILE:rex::rexglue>) and the PPC tests'. The cache
variable REXGLUE_HOST_TOOL names rexglue built for the build host and installed with its SDK
(<host prefix>/bin/rexglue).

- rexglueConfig.cmake, when CMAKE_CROSSCOMPILING: rex::rexglue's location becomes that tool, so
  generated/rexglue.cmake needs no change. Without it, a warning (a build without the game's code
  needs no codegen). It also adds the SDK's prefix to CMAKE_FIND_ROOT_PATH: the NDK's toolchain
  searches packages only under its roots, and fmt, spdlog, SDL3 and the rest installed with the
  SDK were not found unless the consumer listed it.
- The host tool must generate what this SDK expects. One version can be two codegens (patches
  applied over one commit give the same version), so the check is a hash: everything that decides
  rexglue's output (src/codegen, include/rex/codegen, resources/templates) hashed at build time by
  cmake/rexglue_codegen_id.cmake and installed as share/rexglue/codegen_id. A host tool whose
  prefix has another hash, or none, fails configure, with both values in the message.
- tests/ppc: a cross build runs the host tool for recompile-tests, after comparing the same hash.

Desktop builds are not cross builds: nothing changes but one more installed file. Test, NDK r30
on Linux, a minimal consumer of an Android install: with the matching host SDK it configures and
rex::rexglue is the host tool; with the series' previous SDK (same version) it fails on the hash;
with no tool, a warning; without the find-root line, fmt is not found. The Android ppc_tests
build with the host tool.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 320b5ba..346bc6c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -21,6 +21,11 @@ project(ReXGlue
 # Build Options
 #==========================================================
 option(REXGLUE_BUILD_TESTS       "Build PPC instruction and unit tests" OFF)
+# A cross build (Android) cannot run the rexglue it builds. The codegen steps that run at build
+# time (the PPC tests here; a consumer's codegen through rexglueConfig.cmake) run this one instead:
+# rexglue built for the build host from the same SDK version.
+set(REXGLUE_HOST_TOOL "" CACHE FILEPATH
+    "rexglue built for the build host, for the codegen steps of a cross build")
 option(REXGLUE_ENABLE_SANITIZERS "Enable UndefinedBehaviorSanitizer" OFF)
 option(REXGLUE_ENABLE_FIDELITYFX "Enable optional AMD FidelityFX integration (experimental)" OFF)
 option(REXGLUE_ENABLE_TRACY                "Enable Tracy profiler integration" ON)
@@ -278,6 +283,24 @@ add_subdirectory(src/kernel)
 add_subdirectory(src/codegen)
 add_subdirectory(src/rexglue)
 
+# What a cross build compares with the host's rexglue (REXGLUE_HOST_TOOL): the hash of what decides
+# rexglue's output, installed next to the SDK as share/rexglue/codegen_id.
+file(GLOB_RECURSE REXGLUE_CODEGEN_ID_INPUTS CONFIGURE_DEPENDS LIST_DIRECTORIES false
+    "${CMAKE_CURRENT_SOURCE_DIR}/src/codegen/*"
+    "${CMAKE_CURRENT_SOURCE_DIR}/include/rex/codegen/*"
+    "${CMAKE_CURRENT_SOURCE_DIR}/resources/templates/*")
+set(REXGLUE_CODEGEN_ID_FILE "${CMAKE_CURRENT_BINARY_DIR}/codegen_id")
+add_custom_command(
+    OUTPUT "${REXGLUE_CODEGEN_ID_FILE}"
+    COMMAND ${CMAKE_COMMAND} -DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}
+            -DOUTPUT=${REXGLUE_CODEGEN_ID_FILE}
+            -P ${CMAKE_CURRENT_SOURCE_DIR}/cmake/rexglue_codegen_id.cmake
+    DEPENDS ${REXGLUE_CODEGEN_ID_INPUTS} ${CMAKE_CURRENT_SOURCE_DIR}/cmake/rexglue_codegen_id.cmake
+    COMMENT "Hashing what decides rexglue's output"
+    VERBATIM)
+add_custom_target(rexglue_codegen_id ALL DEPENDS "${REXGLUE_CODEGEN_ID_FILE}")
+add_dependencies(rexglue rexglue_codegen_id)
+
 # Add tests subdirectory if tests are enabled
 if(REXGLUE_BUILD_TESTS)
     enable_testing()
diff --git a/cmake/rexglueConfig.cmake.in b/cmake/rexglueConfig.cmake.in
index ff7f132..620ca29 100644
--- a/cmake/rexglueConfig.cmake.in
+++ b/cmake/rexglueConfig.cmake.in
@@ -11,6 +11,11 @@ include(CMakeFindDependencyMacro)
 include("${CMAKE_CURRENT_LIST_DIR}/rexglue_helpers.cmake")
 
 list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")
+# A cross toolchain (the NDK's) searches packages only under its find roots: this prefix becomes
+# one, so the dependencies installed with the SDK are found without the consumer listing it.
+if(CMAKE_CROSSCOMPILING AND NOT "${PACKAGE_PREFIX_DIR}" IN_LIST CMAKE_FIND_ROOT_PATH)
+    list(APPEND CMAKE_FIND_ROOT_PATH "${PACKAGE_PREFIX_DIR}")
+endif()
 
 find_dependency(fmt CONFIG)
 find_dependency(spdlog CONFIG)
@@ -46,6 +51,36 @@ if(TARGET rex::rexglue)
         MAP_IMPORTED_CONFIG_MINSIZEREL Release)
 endif()
 
+# A cross build (Android) cannot run the rexglue installed with this SDK. REXGLUE_HOST_TOOL names
+# rexglue built for the build host and installed with its SDK (<prefix>/bin/rexglue), and
+# rex::rexglue (the codegen step) runs that one instead. Its codegen_id must be this SDK's: the
+# same version can still generate different code (patches applied over one commit).
+if(TARGET rex::rexglue AND CMAKE_CROSSCOMPILING)
+    set(REXGLUE_HOST_TOOL "" CACHE FILEPATH
+        "rexglue built for the build host, for the codegen step of a cross build")
+    if(REXGLUE_HOST_TOOL)
+        get_filename_component(_rexglue_host_prefix "${REXGLUE_HOST_TOOL}" DIRECTORY)
+        get_filename_component(_rexglue_host_prefix "${_rexglue_host_prefix}" DIRECTORY)
+        set(_rexglue_host_id_file
+            "${_rexglue_host_prefix}/@CMAKE_INSTALL_DATADIR@/rexglue/codegen_id")
+        set(_rexglue_host_id "")
+        if(EXISTS "${_rexglue_host_id_file}")
+            file(STRINGS "${_rexglue_host_id_file}" _rexglue_host_id LIMIT_COUNT 1)
+        endif()
+        file(STRINGS "${REXGLUE_SHARE_DIR}/codegen_id" _rexglue_id LIMIT_COUNT 1)
+        if(NOT _rexglue_host_id STREQUAL _rexglue_id)
+            message(FATAL_ERROR "REXGLUE_HOST_TOOL (${REXGLUE_HOST_TOOL}) does not generate what "
+                "this SDK expects: codegen_id '${_rexglue_host_id}' (${_rexglue_host_id_file}), "
+                "this SDK's '${_rexglue_id}'. Build the host SDK from the same commit and patches.")
+        endif()
+        set_target_properties(rex::rexglue PROPERTIES
+            IMPORTED_LOCATION_RELEASE "${REXGLUE_HOST_TOOL}")
+    else()
+        message(WARNING "Cross build without REXGLUE_HOST_TOOL: the codegen step cannot run "
+            "(rex::rexglue is built for the target)")
+    endif()
+endif()
+
 if(TARGET rex::runtime AND NOT TARGET rex::system)
     add_library(rex::system ALIAS rex::runtime)
 endif()
diff --git a/cmake/rexglue_codegen_id.cmake b/cmake/rexglue_codegen_id.cmake
new file mode 100644
index 0000000..3a98ac2
--- /dev/null
+++ b/cmake/rexglue_codegen_id.cmake
@@ -0,0 +1,21 @@
+# cmake/rexglue_codegen_id.cmake
+# Script mode (cmake -DSOURCE_DIR=... -DOUTPUT=... -P): writes one hash of everything that decides
+# what rexglue generates (the codegen's sources and the templates it embeds). Two rexglue builds
+# with the same version can still differ there (patches applied over one commit); a cross build
+# runs the host's rexglue only when its hash equals this SDK's (rexglueConfig.cmake, tests/ppc).
+
+file(GLOB_RECURSE _inputs LIST_DIRECTORIES false
+    "${SOURCE_DIR}/src/codegen/*"
+    "${SOURCE_DIR}/include/rex/codegen/*"
+    "${SOURCE_DIR}/resources/templates/*")
+list(SORT _inputs)
+set(_lines "")
+foreach(_file IN LISTS _inputs)
+    file(MD5 "${_file}" _hash)
+    file(RELATIVE_PATH _relative "${SOURCE_DIR}" "${_file}")
+    string(APPEND _lines "${_relative} ${_hash}\n")
+endforeach()
+string(MD5 _id "${_lines}")
+file(WRITE "${OUTPUT}.tmp" "${_id}\n")
+file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
+file(REMOVE "${OUTPUT}.tmp")
