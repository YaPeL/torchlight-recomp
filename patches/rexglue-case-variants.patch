+
+// The names in `names` equal to `name` ignoring ASCII case.
+std::vector<std::string> CaseMatches(const std::vector<std::string>& names,
+                                     const std::string& name) {
+  std::vector<std::string> matches;
+  for (const auto& candidate : names) {
+    if (rex::string::utf8_lower_ascii(candidate) == rex::string::utf8_lower_ascii(name)) {
+      matches.push_back(candidate);
+    }
+  }
+  return matches;
+}
