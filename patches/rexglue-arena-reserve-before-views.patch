+namespace {
+// The protection /proc/self/maps shows for the mapping holding `address` ("rw-s", "---p"), or
+// empty if nothing is mapped there.
+std::string HostAccessAt(const void* address) {
+  const uintptr_t at = reinterpret_cast<uintptr_t>(address);
+  std::ifstream maps("/proc/self/maps");
+  std::string line;
+  while (std::getline(maps, line)) {
+    unsigned long start = 0, end = 0;
+    char access[5] = {};
+    if (std::sscanf(line.c_str(), "%lx-%lx %4s", &start, &end, access) == 3 && start <= at &&
+        at < end) {
+      return access;
+    }
+  }
+  return {};
+}
+}  // namespace
+
+// The guest arena's views are mapped with MAP_FIXED, which replaces what is there: something else
+// mapped where the arena would go (a driver's or an allocator's memory, placed there by address
+// space randomization) has to make it go elsewhere, not become guest memory.
+TEST_CASE("The guest memory arena does not map over someone else's mapping", "[memory][arena]") {
+  const size_t arena = size_t(0x120000000ull);
+  const size_t page = size_t(sysconf(_SC_PAGESIZE));
+  // The first candidate base with nothing mapped yet, as the arena looks for one (from 2^32 up).
+  uint8_t* candidate = nullptr;
+  for (int n = 32; n < 47 && !candidate; n++) {
+    auto base = reinterpret_cast<uint8_t*>(1ull << n);
+    void* probe = mmap(base, arena, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (probe == base) {
+      candidate = base;
+    }
+    if (probe != MAP_FAILED) {
+      munmap(probe, arena);
+    }
+  }
+  REQUIRE(candidate != nullptr);
+  // Someone else's page in the middle of it.
+  uint8_t* other = candidate + 0x50000000;
+  void* mapped = mmap(other, page, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  REQUIRE(mapped == other);
+  std::memset(other, 0xA5, page);
+
+  {
+    rex::memory::Memory memory;
+    REQUIRE(memory.Initialize());
+    CHECK(memory.virtual_membase() != candidate);
+    CHECK(other[0] == 0xA5);
+    CHECK(other[page - 1] == 0xA5);
+    // A page without access on each side of the views: a write running off guest memory faults.
+    CHECK(HostAccessAt(memory.virtual_membase() - 1) == "---p");
+    CHECK(HostAccessAt(memory.virtual_membase() + arena) == "---p");
+    CHECK(HostAccessAt(memory.virtual_membase()) != "---p");
+  }
+  munmap(other, page);
+}
+#endif
