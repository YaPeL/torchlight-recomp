-
-get_property(TEST_BINS GLOBAL PROPERTY PPC_TEST_BINS)
-get_property(TEST_MAPS GLOBAL PROPERTY PPC_TEST_MAPS)
+if(REXGLUE_PPC_TEST_BIN_DIR)
+    # sources.sha256 lists the SHA-256 of each asm/ source the binaries were
+    # assembled from, so a changed test cannot run against stale binaries.
+    set(PPC_SOURCE_SUMS ${PPC_BIN_DIR}/sources.sha256)
+    if(NOT EXISTS ${PPC_SOURCE_SUMS})
+        message(FATAL_ERROR "sources.sha256 missing in ${PPC_BIN_DIR}")
+    endif()
+    file(STRINGS ${PPC_SOURCE_SUMS} PPC_SOURCE_SUM_LINES)
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${PPC_SOURCE_SUMS} ${ASM_FILES})
+    set(TEST_BINS "")
+    set(TEST_MAPS "")
+    foreach(ASM_FILE ${ASM_FILES})
+        get_filename_component(BASE_NAME ${ASM_FILE} NAME_WE)
+        get_filename_component(ASM_NAME ${ASM_FILE} NAME)
+        file(SHA256 ${ASM_FILE} ASM_SUM)
+        list(FIND PPC_SOURCE_SUM_LINES "${ASM_SUM}  ${ASM_NAME}" SUM_INDEX)
+        if(SUM_INDEX EQUAL -1)
+            message(FATAL_ERROR "${ASM_NAME} changed since the binaries in ${PPC_BIN_DIR} were assembled")
+        endif()
+        foreach(EXT bin map)
+            if(NOT EXISTS ${PPC_BIN_DIR}/${BASE_NAME}.${EXT})
+                message(FATAL_ERROR "${BASE_NAME}.${EXT} missing in ${PPC_BIN_DIR}")
+            endif()
+        endforeach()
+        list(APPEND TEST_BINS ${PPC_BIN_DIR}/${BASE_NAME}.bin)
+        list(APPEND TEST_MAPS ${PPC_BIN_DIR}/${BASE_NAME}.map)
+    endforeach()
+    message(STATUS "PPC test binaries from ${PPC_BIN_DIR}")
+else()
+    foreach(ASM_FILE ${ASM_FILES})
+        ppc_add_test_binary(${ASM_FILE} ${PPC_OBJ_DIR} ${PPC_BIN_DIR})
+    endforeach()
+
+    get_property(TEST_BINS GLOBAL PROPERTY PPC_TEST_BINS)
+    get_property(TEST_MAPS GLOBAL PROPERTY PPC_TEST_MAPS)
+endif()
 
