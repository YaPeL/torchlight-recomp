             }
 
             // Will we need a second FBO to do multisampling?
-            if (mNumSamples)
+            if (mNumSamples && !mImplicitMultisample)
             {
                 OGRE_CHECK_GL_ERROR(glGenFramebuffers(1, &mMultisampleFB));
             }
@@ -247,6 +264,12 @@ GLES2FrameBufferObject::GLES2FrameBufferObject()
                 mMultisampleFB = 0;
             }
             
+            if (mNumSamples)
+                LogManager::getSingleton().stream()
+                    << "GLES2 FBO: " << mNumSamples << "x multisampling, "
+                    << (mImplicitMultisample ? "resolved in tile memory (EXT_multisampled_render_to_texture)"
+                                             : "resolved by a blit from a multisample framebuffer");
+
             // Re-initialise
             if(mColour[0].buffer)
                 initialise();
