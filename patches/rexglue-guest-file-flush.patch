+/**
+ * @file        tests/unit/core/vfs_flush_test.cpp
+ * @brief       Guest flushes reach the disk: a handle's flush (NtFlushBuffersFile,
+ *              FlushFileBuffers) and a content package's changes since it was mounted
+ *              (XamContentFlush, XamContentClose: HostPathDevice::FlushChanges)
