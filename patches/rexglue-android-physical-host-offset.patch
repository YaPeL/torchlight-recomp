+TEST_CASE("Recompiled code and the heaps agree on the vE0000000 host offset",
+          "[memory][physical]") {
+  // Recompiled code reaches guest memory as base + address + PhysicalHostOffset (GuestPtr); the
+  // views and the heap's host_address_offset must put the same physical byte there, at any host
+  // page size. Physical address P is also at physical_membase + P.
+  auto& memory = GetTestMemory();
+  auto* heap = MutableHeap(memory.LookupHeap(0xE0000000));
+  REQUIRE(heap != nullptr);
+  CHECK(heap->host_address_offset() == rex::memory::detail::PhysicalHostOffset(0xE0000000));
+
+  uint32_t addr = 0;
+  REQUIRE(heap->Alloc(
+      4096, 4096, rex::memory::kMemoryAllocationReserve | rex::memory::kMemoryAllocationCommit,
+      rex::memory::kMemoryProtectRead | rex::memory::kMemoryProtectWrite, false, &addr));
+  const uint32_t physical = addr - 0xE0000000 + 0x1000;  // the 0xE0 heap's 4 KB shift
+  auto* guest = rex::memory::GuestPtr<volatile uint32_t*>(memory.virtual_membase(), addr + 16);
+  CHECK(reinterpret_cast<volatile uint8_t*>(guest) == memory.TranslateVirtual(addr + 16));
+  *guest = 0x5EB0A11Du;
+  CHECK(*memory.TranslatePhysical<volatile uint32_t*>(physical + 16) == 0x5EB0A11Du);
+  *memory.TranslatePhysical<volatile uint32_t*>(physical + 20) = 0xC0FFEE00u;
+  CHECK(*rex::memory::GuestPtr<volatile uint32_t*>(memory.virtual_membase(), addr + 20) ==
+        0xC0FFEE00u);
+
+  heap->Release(addr, nullptr);
+}
