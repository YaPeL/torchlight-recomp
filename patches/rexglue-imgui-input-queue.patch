+++ b/tests/unit/ui/imgui_drawer_input_test.cpp
@@ -0,0 +1,223 @@
+// Tests for ImGuiDrawer's mouse and touch input: a press and a release that arrive between the
+// same two frames (an instant tap, or a click faster than a frame) are a click, as a slower one is.
+// Driven through a Window's input listeners, as the platform windows deliver events, with a window
+// and an immediate drawer that draw nothing.
+
+#include <catch2/catch_test_macros.hpp>
+#include <cstdint>
+#include <memory>
+
+#include <imgui.h>
+#include <rex/ui/imgui_dialog.h>
+#include <rex/ui/imgui_drawer.h>
+#include <rex/ui/immediate_drawer.h>
+#include <rex/ui/presenter.h>
+#include <rex/ui/ui_event.h>
+#include <rex/ui/window.h>
+#include <rex/ui/windowed_app_context.h>
+
+namespace {
+
+using namespace rex::ui;
+
+constexpr uint32_t kWidth = 1280, kHeight = 720;
+
+class TestAppContext final : public WindowedAppContext {
+ public:
+  void NotifyUILoopOfPendingFunctions() override {}
+  void PlatformQuitFromUIThread() override {}
+};
+
+class TestWindow final : public Window {
+ public:
+  explicit TestWindow(WindowedAppContext& context) : Window(context, "test", kWidth, kHeight) {}
+  ~TestWindow() override { EnterDestructor(); }
+
+  void Mouse(bool down, float x, float y) {
+    WindowDestructionReceiver receiver(this);
+    MouseEvent e(this, MouseEvent::Button::kLeft, int32_t(x), int32_t(y));
+    if (down) {
+      OnMouseDown(e, receiver);
+    } else {
+      OnMouseUp(e, receiver);
+    }
+  }
+  void Touch(TouchEvent::Action action, float x, float y) {
+    WindowDestructionReceiver receiver(this);
+    TouchEvent e(this, 0, action, x, y);
+    OnTouchEvent(e, receiver);
+  }
+
+ protected:
+  bool OpenImpl() override {
+    WindowDestructionReceiver receiver(this);
+    OnActualSizeUpdate(kWidth, kHeight, receiver);
+    return true;
+  }
+  void RequestCloseImpl() override {}
+  std::unique_ptr<Surface> CreateSurfaceImpl(Surface::TypeFlags) override { return nullptr; }
+  void RequestPaintImpl() override {}
+};
+
+class NullTexture final : public ImmediateTexture {
+ public:
+  NullTexture(uint32_t width, uint32_t height) : ImmediateTexture(width, height) {}
+};
+
+class NullImmediateDrawer final : public ImmediateDrawer {
+ public:
+  std::unique_ptr<ImmediateTexture> CreateTexture(uint32_t width, uint32_t height,
+                                                  ImmediateTextureFilter, bool,
+                                                  const uint8_t*) override {
+    return std::make_unique<NullTexture>(width, height);
+  }
+  void Begin(UIDrawContext&, float, float) override {}
+  void BeginDrawBatch(const ImmediateDrawBatch&) override {}
+  void Draw(const ImmediateDraw&) override {}
+  void EndDrawBatch() override {}
+  void End() override {}
+};
+
+// A modal with one OK button, as the message boxes; it stays open and counts the presses.
+class OkDialog final : public ImGuiDialog {
+ public:
+  explicit OkDialog(ImGuiDrawer* drawer) : ImGuiDialog(drawer) {}
+  int presses = 0;
+  ImVec2 ok_center{}, window_pos{};
+
+ protected:
+  void OnDraw(ImGuiIO&) override {
+    if (!opened_) {
+      ImGui::OpenPopup("Dialog");
+      opened_ = true;
+    }
+    if (ImGui::BeginPopupModal("Dialog", nullptr, ImGuiWindowFlags_AlwaysAutoResize)) {
+      ImGui::TextUnformatted("A message for the dialog's body.");
+      if (ImGui::Button("OK")) {
+        ++presses;
+      }
+      const ImVec2 lo = ImGui::GetItemRectMin(), hi = ImGui::GetItemRectMax();
+      ok_center = ImVec2((lo.x + hi.x) / 2, (lo.y + hi.y) / 2);
+      window_pos = ImGui::GetWindowPos();
+      ImGui::EndPopup();
+    }
+  }
+
+ private:
+  bool opened_ = false;
+};
+
+struct Fixture {
+  TestAppContext context;
+  TestWindow window{context};
+  NullImmediateDrawer immediate;
+  std::unique_ptr<ImGuiDrawer> drawer;
+  OkDialog* dialog = nullptr;
+
+  Fixture() {
+    REQUIRE(window.Open());
+    drawer = std::make_unique<ImGuiDrawer>(&window, 0);
+    drawer->SetPresenterAndImmediateDrawer(nullptr, &immediate);
+    dialog = new OkDialog(drawer.get());  // owned by the drawer
+    Frames(5);                            // the modal opens and settles
+  }
+  ~Fixture() {
+    // Every case ends with the buttons up: the window must not still capture the mouse.
+    CHECK(!window.IsMouseCaptureRequested());
+    drawer->SetPresenterAndImmediateDrawer(nullptr, nullptr);
+  }
+
+  void Frames(int count) {
+    for (int i = 0; i < count; ++i) {
+      AppUIDrawContext draw_context(kWidth, kHeight);
+      drawer->Draw(draw_context);
+    }
+  }
+};
+
+}  // namespace
+
+TEST_CASE("ImGuiDrawer: a click within one frame presses the button", "[ui]") {
+  Fixture f;
+  const ImVec2 ok = f.dialog->ok_center, pos = f.dialog->window_pos;
+  f.window.Mouse(true, ok.x, ok.y);
+  f.window.Mouse(false, ok.x, ok.y);
+  f.Frames(10);
+  CHECK(f.dialog->presses == 1);
+  CHECK(f.dialog->window_pos.x == pos.x);
+  CHECK(f.dialog->window_pos.y == pos.y);
+
+  f.window.Mouse(true, ok.x, ok.y);
+  f.window.Mouse(false, ok.x, ok.y);
+  f.Frames(1);
+  f.window.Mouse(true, ok.x, ok.y);
+  f.window.Mouse(false, ok.x, ok.y);
+  f.Frames(10);
+  CHECK(f.dialog->presses == 3);
+}
+
+TEST_CASE("ImGuiDrawer: a click over several frames presses the button once", "[ui]") {
+  Fixture f;
+  const ImVec2 ok = f.dialog->ok_center;
+  f.window.Mouse(true, ok.x, ok.y);
+  f.Frames(3);
+  CHECK(f.dialog->presses == 0);
+  f.window.Mouse(false, ok.x, ok.y);
+  f.Frames(3);
+  CHECK(f.dialog->presses == 1);
+}
+
+TEST_CASE("ImGuiDrawer: an instant touch tap presses the button", "[ui]") {
+  Fixture f;
+  const ImVec2 ok = f.dialog->ok_center, pos = f.dialog->window_pos;
+  f.window.Touch(TouchEvent::Action::kDown, ok.x, ok.y);
+  f.window.Touch(TouchEvent::Action::kUp, ok.x, ok.y);
+  f.Frames(10);
+  CHECK(f.dialog->presses == 1);
+  CHECK(f.dialog->window_pos.x == pos.x);
+  CHECK(f.dialog->window_pos.y == pos.y);
+}
+
+TEST_CASE("ImGuiDrawer: a press that leaves the button does not click it", "[ui]") {
+  Fixture f;
+  const ImVec2 ok = f.dialog->ok_center;
+  f.window.Mouse(true, ok.x, ok.y);
+  f.window.Mouse(false, 2.0f, 2.0f);  // released outside the dialog
+  f.Frames(10);
+  CHECK(f.dialog->presses == 0);
+}
+
+TEST_CASE("ImGuiDrawer: the mouse is captured while a button is held; touch abandons the press", "[ui]") {
+  Fixture f;
+  const ImVec2 ok = f.dialog->ok_center;
+  f.window.Mouse(true, ok.x, ok.y);
+  CHECK(f.window.IsMouseCaptureRequested());
+  f.window.Touch(TouchEvent::Action::kDown, ok.x, ok.y);  // touch takes over: capture released
+  CHECK(!f.window.IsMouseCaptureRequested());
+  f.window.Touch(TouchEvent::Action::kUp, ok.x, ok.y);
+  f.Frames(10);
+  CHECK(f.dialog->presses == 1);  // the tap; the interrupted mouse press clicks nothing
+}
+
+TEST_CASE("ImGuiDrawer: a mouse event abandons a touch in progress", "[ui]") {
+  Fixture f;
+  const ImVec2 ok = f.dialog->ok_center;
+  f.window.Touch(TouchEvent::Action::kDown, ok.x, ok.y);
+  f.Frames(2);
+  f.window.Mouse(true, ok.x, ok.y);
+  f.window.Mouse(false, ok.x, ok.y);
+  f.Frames(10);
+  CHECK(f.dialog->presses == 1);  // the click; the interrupted touch clicks nothing
+}
+
+TEST_CASE("ImGuiDrawer: removing the last dialog releases a held button", "[ui]") {
+  Fixture f;
+  const ImVec2 ok = f.dialog->ok_center;
+  f.window.Mouse(true, ok.x, ok.y);
+  f.Frames(1);
+  delete f.dialog;  // detaches the drawer, which clears its input
+  f.dialog = nullptr;
+  CHECK(!f.window.IsMouseCaptureRequested());
+  f.window.Mouse(false, ok.x, ok.y);  // no longer listening: nothing to release
+  CHECK(!f.window.IsMouseCaptureRequested());
+}
