+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace rex::codegen {
+
+struct RecompilerConfig;
+
+/**
+ * @brief Instrument the C++ emitted for one PPC instruction.
+ *
+ * For each non-argument register the config keeps in a local (r0, r2, r11, r12, f0, v32-v63,
+ * minus `non_argument_in_context`): if the instruction reads the register's previous value, a
+ * REX_VERIFY_LOCAL check comparing the local with the context goes before it; after each line
+ * that names the register, the local is written through to the context. The two then differ only
+ * where the guest reads a value another function left there, which non_argument_as_local changes.
+ *
+ * @param text     The instruction's emitted lines (each ending in '\n'), comment line excluded
+ * @param config   The recompiler configuration
+ * @param address  Guest address of the instruction (logged on a difference)
+ * @param unused   A register the instruction names but whose value its result ignores (see
+ *                 IgnoredSameRegisterOperand); not checked. Empty for none.
+ * @return The instrumented lines; `text` unchanged when no such register is named
+ */
+std::string InstrumentNonArgumentLocals(std::string_view text, const RecompilerConfig& config,
+                                        uint32_t address, std::string_view unused = {});
+
+/**
+ * @brief The GPR an instruction reads twice without using its value, as "rN", or empty.
+ *
+ * subf, subfc, subfe, xor, eqv and andc (and their record forms) with both source operands the
+ * same register give a result that does not depend on it: 0, 0 with CA set, -1 or 0 from CA
+ * (the compiler's way to make a mask of the carry), 0, -1 and 0.
+ *
+ * @param opcode    The instruction's PPC_INST_* id
+ * @param operandA  Its second operand (rA, or rS for xor, eqv and andc)
+ * @param operandB  Its third operand (rB)
+ */
+std::string IgnoredSameRegisterOperand(int opcode, uint32_t operandA, uint32_t operandB);
+
+}  // namespace rex::codegen
