diff --git a/tests/unit/core/threading_win_test.cpp b/tests/unit/core/threading_win_test.cpp
new file mode 100644
index 0000000..cd63680
--- /dev/null
+++ b/tests/unit/core/threading_win_test.cpp
@@ -0,0 +1,99 @@
+/**
+ * @file        tests/unit/core/threading_win_test.cpp
+ * @brief       Unit tests for the Windows sleeps (rex::thread::Sleep, AlertableSleep) and the
+ *              process timer resolution set up in core/threading_win.cpp.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <functional>
+#include <thread>
+#include <vector>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/platform.h>
+#include <rex/thread.h>
+
+#include "core/platform_win.h"
+
+using namespace std::chrono_literals;
+using Clock = std::chrono::steady_clock;
+
+namespace {
+
+// Median duration of `rounds` calls, in milliseconds (the median keeps a stray scheduler delay
+// from failing the test).
+double MedianMs(int rounds, const std::function<void()>& call) {
+  std::vector<double> ms;
+  for (int i = 0; i < rounds; ++i) {
+    const auto start = Clock::now();
+    call();
+    ms.push_back(std::chrono::duration<double, std::milli>(Clock::now() - start).count());
+  }
+  std::sort(ms.begin(), ms.end());
+  return ms[ms.size() / 2];
+}
+
+}  // namespace
+
+TEST_CASE("Sleep of 1 ms lasts about 1 ms, not a timer tick", "[threading][win]") {
+  const double ms = MedianMs(21, [] { rex::thread::Sleep(1ms); });
+  CHECK(ms >= 0.9);
+  CHECK(ms < 2.0);
+}
+
+TEST_CASE("Sleep under 1 ms waits instead of yielding", "[threading][win]") {
+  const double ms = MedianMs(21, [] { rex::thread::Sleep(500us); });
+  CHECK(ms >= 0.4);
+  CHECK(ms < 1.5);
+}
+
+TEST_CASE("Sleep keeps longer durations", "[threading][win]") {
+  const double ms = MedianMs(5, [] { rex::thread::Sleep(20ms); });
+  CHECK(ms >= 19.5);
+  CHECK(ms < 22.0);
+}
+
+TEST_CASE("AlertableSleep lasts its duration without APCs", "[threading][win]") {
+  rex::thread::SleepResult result = rex::thread::SleepResult::kAlerted;
+  const double ms = MedianMs(11, [&] { result = rex::thread::AlertableSleep(1ms); });
+  CHECK(result == rex::thread::SleepResult::kSuccess);
+  CHECK(ms >= 0.9);
+  CHECK(ms < 2.0);
+}
+
+TEST_CASE("AlertableSleep ends early when an APC arrives", "[threading][win]") {
+  HANDLE self = nullptr;
+  REQUIRE(DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &self, 0,
+                          FALSE, DUPLICATE_SAME_ACCESS));
+  static std::atomic<int> apc_calls{0};
+  apc_calls = 0;
+  std::thread alerter([self] {
+    std::this_thread::sleep_for(50ms);
+    QueueUserAPC([](ULONG_PTR) { ++apc_calls; }, self, 0);
+  });
+  const auto start = Clock::now();
+  const auto result = rex::thread::AlertableSleep(5s);
+  const auto elapsed = Clock::now() - start;
+  alerter.join();
+  CloseHandle(self);
+  CHECK(result == rex::thread::SleepResult::kAlerted);
+  CHECK(apc_calls == 1);
+  CHECK(elapsed < 2s);
+}
+
+TEST_CASE("The process runs with a 1 ms timer resolution", "[threading][win]") {
+  // Plain Win32 waits (not rex::thread's), which only the process timer resolution affects.
+  const double sleep_ms = MedianMs(21, [] { ::Sleep(1); });
+  CHECK(sleep_ms < 2.5);
+  HANDLE event = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+  REQUIRE(event);
+  const double wait_ms = MedianMs(21, [&] { WaitForSingleObject(event, 1); });
+  CloseHandle(event);
+  CHECK(wait_ms < 2.5);
+}
