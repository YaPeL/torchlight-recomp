diff --git a/include/rex/graphics/graphics_system.h b/include/rex/graphics/graphics_system.h
index 4477c2f..b5d10c3 100644
--- a/include/rex/graphics/graphics_system.h
+++ b/include/rex/graphics/graphics_system.h
@@ -51,6 +51,16 @@ class GraphicsSystem : public system::IGraphicsSystem {
   // Rate of the guest's vblank interrupt while the vsync cvar is on, in Hz; 0 (the default) uses
   // the guest video mode's refresh rate. Any thread; the vblank thread reads it every tick.
   void SetGuestVblankRate(uint32_t hz) { guest_vblank_hz_ = hz; }
+  // Aligns the guest's vblank with a host event (the display's vblank, as a host renderer sees it
+  // when its vsynced present returns) at `guest_ticks` (chrono::Clock::QueryGuestTickCount then):
+  // the vblank thread moves its phase so that the next guest vblank falls a whole number of
+  // intervals after it, at its rate. Without it the guest's vblank runs on its own clock, out of
+  // phase with the display's. Any thread; the latest call wins; only while the vsync cvar is on. A
+  // phase moved back never brings two vblanks closer than half an interval. Inline: the graphics
+  // system lives in the GPU plugin.
+  void AlignGuestVblank(uint64_t guest_ticks) {
+    guest_vblank_anchor_.store(guest_ticks, std::memory_order_relaxed);
+  }
 
   virtual ~GraphicsSystem();
 
@@ -124,6 +134,7 @@ class GraphicsSystem : public system::IGraphicsSystem {
 
   std::atomic<bool> vsync_worker_running_;
   std::atomic<uint32_t> guest_vblank_hz_{0};
+  std::atomic<uint64_t> guest_vblank_anchor_{0};  // guest ticks of the latest AlignGuestVblank
   system::object_ref<system::XHostThread> vsync_worker_thread_;
 
   RegisterFile register_file_;
diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index 1d85969..5901ddf 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -156,6 +156,7 @@ X_STATUS GraphicsSystem::SetupGuestGpu(runtime::FunctionDispatcher* function_dis
         uint64_t guest_tick_frequency = chrono::Clock::guest_tick_frequency();
         uint64_t no_vsync_interval_ticks = std::max(uint64_t(1), guest_tick_frequency / 1000);
         uint64_t last_frame_time = chrono::Clock::QueryGuestTickCount();
+        uint64_t applied_anchor = 0;
         while (vsync_worker_running_) {
           uint64_t current_time = chrono::Clock::QueryGuestTickCount();
           const uint32_t chosen_hz = guest_vblank_hz_.load(std::memory_order_relaxed);
@@ -164,7 +165,18 @@ X_STATUS GraphicsSystem::SetupGuestGpu(runtime::FunctionDispatcher* function_dis
               std::max(uint64_t(1), uint64_t(double(guest_tick_frequency) / rate_hz));
           uint64_t interval_ticks =
               REXCVAR_GET(vsync) ? vsync_interval_ticks : no_vsync_interval_ticks;
-          while (current_time - last_frame_time >= interval_ticks) {
+          // AlignGuestVblank: the vblank grid moves to the anchor's phase. The next vblank is the
+          // first one on the new grid after now; if that is under half an interval after the
+          // previous vblank, the one after it. last_frame_time is one interval before the next
+          // vblank, so it may be after now (hence the comparison below without a subtraction).
+          const uint64_t anchor = guest_vblank_anchor_.load(std::memory_order_relaxed);
+          if (anchor != applied_anchor && anchor <= current_time && REXCVAR_GET(vsync)) {
+            applied_anchor = anchor;
+            uint64_t next = anchor + ((current_time - anchor) / interval_ticks + 1) * interval_ticks;
+            if (next < last_frame_time + interval_ticks / 2) next += interval_ticks;
+            last_frame_time = next - interval_ticks;
+          }
+          while (current_time >= last_frame_time + interval_ticks) {
             MarkVblank();
             last_frame_time += interval_ticks;
           }
