+/**
+ * @file        rex/graphics/command_processor_dump.h
+ * @brief       The command processor's part of the thread dump, read without waiting on a lock
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <iterator>
+#include <string>
+
+#include <fmt/format.h>
+
+#include <rex/graphics/pending_calls.h>
+
+namespace rex::graphics {
+
+// What the command processor's worker is doing, written by the worker with atomics for the
+// thread dump (rex/system/thread_dump.h). A time of -1 means "not in that wait".
+struct CommandProcessorDumpState {
+  std::atomic<uint32_t> read_ptr{0};
+  std::atomic<int64_t> idle_since_ms{-1};
+  std::atomic<int64_t> wait_reg_mem_since_ms{-1};
+  std::atomic<uint32_t> wait_reg_mem_address{0};
+  std::atomic<uint32_t> wait_reg_mem_info{0};
+  std::atomic<uint32_t> wait_reg_mem_reference{0};
+  std::atomic<uint32_t> wait_reg_mem_mask{0};
+  std::atomic<uint32_t> wait_reg_mem_value{0};
+};
+
+inline int64_t CommandProcessorDumpNowMs() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+// Appends the command processor's state. It only tries the pending calls' lock: taken, their
+// count is "inconsistent (locked)".
+inline void AppendCommandProcessorState(const CommandProcessorDumpState& state,
+                                        uint32_t write_ptr, bool worker_running,
+                                        const PendingCalls& pending_calls, int64_t now_ms,
+                                        std::string& out) {
+  auto it = std::back_inserter(out);
+  fmt::format_to(it, "  command processor: worker {}, ring read {:08X} write {:08X}, ",
+                 worker_running ? "running" : "stopped",
+                 state.read_ptr.load(std::memory_order_relaxed), write_ptr);
+  int64_t idle_since = state.idle_since_ms.load(std::memory_order_relaxed);
+  int64_t wait_since = state.wait_reg_mem_since_ms.load(std::memory_order_relaxed);
+  if (wait_since >= 0) {
+    uint32_t info = state.wait_reg_mem_info.load(std::memory_order_relaxed);
+    fmt::format_to(it,
+                   "in WAIT_REG_MEM for {:.1f} s ({} {:08X}, function {}, reference {:08X}, "
+                   "mask {:08X}, last value {:08X}), ",
+                   (now_ms - wait_since) / 1000.0, (info & 0x10) ? "memory" : "register",
+                   state.wait_reg_mem_address.load(std::memory_order_relaxed), info & 0x7,
+                   state.wait_reg_mem_reference.load(std::memory_order_relaxed),
+                   state.wait_reg_mem_mask.load(std::memory_order_relaxed),
+                   state.wait_reg_mem_value.load(std::memory_order_relaxed));
+  } else if (idle_since >= 0) {
+    fmt::format_to(it, "idle (ring empty) for {:.1f} s, ", (now_ms - idle_since) / 1000.0);
+  } else {
+    out += "executing packets, ";
+  }
+  size_t pending = 0;
+  if (pending_calls.TrySize(&pending)) {
+    fmt::format_to(it, "{} pending calls\n", pending);
+  } else {
+    out += "pending calls inconsistent (locked)\n";
+  }
+}
+
+}  // namespace rex::graphics
