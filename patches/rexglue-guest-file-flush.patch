+X_STATUS HostPathFile::Flush() {
+  // A handle that cannot write has written nothing to flush (and Windows'
+  // FlushFileBuffers rejects one).
+  if (!(file_access_ & (FileAccess::kGenericWrite | FileAccess::kFileWriteData |
+                        FileAccess::kFileAppendData))) {
+    return X_STATUS_SUCCESS;
+  }
+  return file_handle_->Flush() ? X_STATUS_SUCCESS : X_STATUS_UNSUCCESSFUL;
+}
