+/**
+ * @file        system/thread_dump_test.cpp
+ * @brief       The thread dump: threads' waits, and it returns while other threads hold locks
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <atomic>
+#include <chrono>
+#include <functional>
+#include <future>
+#include <string>
+#include <thread>
+
+#include <rex/graphics/command_processor_dump.h>
+#include <rex/graphics/pending_calls.h>
+#include <rex/system/thread_dump.h>
+
+namespace td = rex::system::thread_dump;
+using rex::system::FormatThreadDump;
+
+namespace {
+
+// Runs `dump` on another thread and fails if it does not return within a second: the dump must
+// never wait on a lock.
+std::string DumpWithin1s(std::function<std::string()> dump) {
+  auto result = std::async(std::launch::async, std::move(dump));
+  REQUIRE(result.wait_for(std::chrono::seconds(1)) == std::future_status::ready);
+  return result.get();
+}
+
+// A thread with a record, which does what the test asks and stays until released.
+class RecordedThread {
+ public:
+  explicit RecordedThread(std::string name) {
+    thread_ = std::thread([this, name] {
+      record_ = td::AcquireRecord(0x1234, 4321, name);
+      ready_.set_value();
+      release_.get_future().wait();
+      td::ReleaseRecord(record_);
+    });
+    ready_.get_future().wait();
+  }
+  ~RecordedThread() {
+    release_.set_value();
+    thread_.join();
+  }
+  int record() const { return record_; }
+
+ private:
+  std::thread thread_;
+  int record_ = -1;
+  std::promise<void> ready_;
+  std::promise<void> release_;
+};
+
+}  // namespace
+
+TEST_CASE("Thread dump shows a thread's wait and then that it runs", "[thread_dump]") {
+  const td::WaitObject objects[] = {{2, 0xF8000010}, {8, 0xF8000020}};  // Event, Semaphore
+  std::promise<void> waiting, done_waiting, release;
+  int record = -1;
+  std::thread thread([&] {
+    record = td::AcquireRecord(0xABCD, 777, "dump test waiter");
+    td::BeginWait(td::WaitKind::kAny, objects, 2, -1, 0x82001234);
+    waiting.set_value();
+    done_waiting.get_future().wait();
+    td::EndWait();
+    release.get_future().wait();
+    td::ReleaseRecord(record);
+  });
+  waiting.get_future().wait();
+  CHECK(record >= 0);
+  std::string dump = DumpWithin1s([] { return FormatThreadDump("test"); });
+  CHECK(dump.find("Thread dump (test)") != std::string::npos);
+  CHECK(dump.find("\"dump test waiter\" id 0000ABCD host tid 777: waiting") != std::string::npos);
+  CHECK(dump.find("wait for any on Event F8000010, Semaphore F8000020, no timeout, "
+                  "guest LR 82001234") != std::string::npos);
+
+  done_waiting.set_value();
+  // EndWait ran on the thread before it waits for `release`; give it a moment.
+  for (int i = 0; i < 100; ++i) {
+    dump = FormatThreadDump("test");
+    if (dump.find("\"dump test waiter\" id 0000ABCD host tid 777: running") != std::string::npos) {
+      break;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+  CHECK(dump.find("\"dump test waiter\" id 0000ABCD host tid 777: running") != std::string::npos);
+
+  release.set_value();
+  thread.join();
+  CHECK(FormatThreadDump("test").find("dump test waiter") == std::string::npos);
+}
+
+TEST_CASE("Thread dump returns with a record held by a writer on another thread",
+          "[thread_dump]") {
+  RecordedThread recorded("dump test held");
+  std::promise<void> holding, release;
+  std::thread writer([&] {
+    td::ScopedWriteForTesting write(recorded.record());
+    holding.set_value();
+    release.get_future().wait();
+  });
+  holding.get_future().wait();
+
+  std::string dump = DumpWithin1s([] { return FormatThreadDump("held"); });
+  CHECK(dump.find("dump test held") == std::string::npos);
+  CHECK(dump.find("inconsistent (being written)") != std::string::npos);
+
+  release.set_value();
+  writer.join();
+  CHECK(FormatThreadDump("held").find("\"dump test held\"") != std::string::npos);
+}
+
+TEST_CASE("Other threads' writes to a record never wait for its own thread's write",
+          "[thread_dump]") {
+  // A thread suspended in the middle of writing its record (SuspendThread on Windows) must not
+  // stop the thread that resumes it, renames it or terminates it.
+  RecordedThread recorded("dump test suspended");
+  int record = recorded.record();
+  std::promise<void> holding, release;
+  std::thread writer([&] {
+    td::ScopedWriteForTesting write(record);
+    holding.set_value();
+    release.get_future().wait();
+  });
+  holding.get_future().wait();
+  auto writes = std::async(std::launch::async, [record] {
+    td::SetSuspendCount(record, 1);
+    td::SetName(record, "dump test renamed");
+    return true;
+  });
+  CHECK(writes.wait_for(std::chrono::seconds(1)) == std::future_status::ready);
+  release.set_value();
+  writer.join();
+  std::string dump = FormatThreadDump("renamed");
+  CHECK(dump.find("\"dump test renamed\" id 00001234 host tid 4321: suspended (1), running") !=
+        std::string::npos);
+}
