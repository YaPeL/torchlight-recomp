+/**
+ * @file        tests/unit/system/guest_fatal_test.cpp
+ * @brief       Fatal guest errors reach the app's handler and never return into the guest
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <csignal>
+#include <cstdint>
+#include <optional>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/system/guest_fatal.h>
+#include <rex/system/xexception.h>
+#include <rex/types.h>
+
+#include "child_process.h"
+
+namespace rex::kernel::xboxkrnl {
+void DbgBreakPoint_entry();
+void RtlRaiseException_entry(ppc_ptr_t<rex::system::X_EXCEPTION_RECORD> record);
+void KeBugCheckEx_entry(u32 code, u32 param1, u32 param2, u32 param3, u32 param4);
+}  // namespace rex::kernel::xboxkrnl
+
+using rex::system::GuestFatalError;
+using rex::system::GuestFatalKind;
+using rex::system::SetGuestFatalHandler;
+namespace krnl = rex::kernel::xboxkrnl;
+
+namespace {
+
+// The handler a test registers keeps the error and leaves by throwing: the guest must not
+// continue, and a test cannot end its process.
+struct LeftTheGuest {};
+std::optional<GuestFatalError> received;
+
+void KeepAndLeave(const GuestFatalError& error) {
+  received = error;
+  throw LeftTheGuest{};
+}
+
+// Registers KeepAndLeave for one test, unregisters after it.
+struct HandlerScope {
+  HandlerScope() {
+    received.reset();
+    SetGuestFatalHandler(KeepAndLeave);
+  }
+  ~HandlerScope() { SetGuestFatalHandler(nullptr); }
+};
+
+}  // namespace
+
+TEST_CASE("RtlRaiseException is fatal and reports its record", "[guest_fatal]") {
+  HandlerScope scope;
+  rex::system::X_EXCEPTION_RECORD record = {};
+  record.code = 0xC0000005u;
+  record.number_parameters = 2;
+  record.exception_information[0] = 1;
+  record.exception_information[1] = 0x1234;
+  CHECK_THROWS_AS(krnl::RtlRaiseException_entry(
+                      ppc_ptr_t<rex::system::X_EXCEPTION_RECORD>(&record, 0x70001000)),
+                  LeftTheGuest);
+  REQUIRE(received);
+  CHECK(received->kind == GuestFatalKind::kException);
+  CHECK(received->code == 0xC0000005u);
+  CHECK(received->record_address == 0x70001000);
+  CHECK(received->parameter_count == 2);
+  CHECK(received->parameters[0] == 1);
+  CHECK(received->parameters[1] == 0x1234);
+  CHECK(received->context == nullptr);  // not called on a guest thread
+}
+
+TEST_CASE("SetThreadName through RtlRaiseException is not fatal", "[guest_fatal]") {
+  HandlerScope scope;
+  rex::system::X_EXCEPTION_RECORD record = {};
+  record.code = 0x406D1388u;
+  record.number_parameters = 4;
+  record.exception_information[0] = 0x1000;  // type
+  record.exception_information[1] = 0;       // no name: the handler returns at once
+  krnl::RtlRaiseException_entry(ppc_ptr_t<rex::system::X_EXCEPTION_RECORD>(&record, 0));
+  CHECK_FALSE(received);
+}
+
+TEST_CASE("KeBugCheckEx is fatal and reports its code and parameters", "[guest_fatal]") {
+  HandlerScope scope;
+  CHECK_THROWS_AS(krnl::KeBugCheckEx_entry(0xF4, 1, 2, 3, 4), LeftTheGuest);
+  REQUIRE(received);
+  CHECK(received->kind == GuestFatalKind::kBugCheck);
+  CHECK(received->code == 0xF4);
+  CHECK(received->parameter_count == 4);
+  CHECK(received->parameters[3] == 4);
+}
+
+TEST_CASE("DbgBreakPoint is fatal", "[guest_fatal]") {
+  HandlerScope scope;
+  CHECK_THROWS_AS(krnl::DbgBreakPoint_entry(), LeftTheGuest);
+  REQUIRE(received);
+  CHECK(received->kind == GuestFatalKind::kDebugBreak);
+  CHECK(received->code == 0x80000003u);
+}
+
+#if !defined(_WIN32)
+
+namespace {
+void ReturnsAnyway(const GuestFatalError&) {}
+}  // namespace
+
+TEST_CASE("child: a fatal guest error with no handler", "[.][fault_child]") {
+  krnl::KeBugCheckEx_entry(0xF4, 0, 0, 0, 0);
+  _exit(0);
+}
+
+TEST_CASE("child: a fatal guest error whose handler returns", "[.][fault_child]") {
+  SetGuestFatalHandler(ReturnsAnyway);
+  krnl::DbgBreakPoint_entry();
+  _exit(0);
+}
+
+TEST_CASE("A fatal guest error aborts the process", "[guest_fatal]") {
+  SECTION("with no handler") {
+    const int status = rex::testing::RunTestInChild("child: a fatal guest error with no handler");
+    CHECK((WIFSIGNALED(status) && WTERMSIG(status) == SIGABRT));
+  }
+  SECTION("when the handler returns") {
+    const int status =
+        rex::testing::RunTestInChild("child: a fatal guest error whose handler returns");
+    CHECK((WIFSIGNALED(status) && WTERMSIG(status) == SIGABRT));
+  }
+}
+
+#endif  // !defined(_WIN32)
