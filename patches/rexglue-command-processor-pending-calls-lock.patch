@@ -0,0 +1,52 @@
+/**
+ * @file        rex/graphics/pending_calls.h
+ * @brief       Calls queued from any thread for the command processor's thread to run
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <functional>
+#include <mutex>
+#include <queue>
+#include <utility>
+
+namespace rex::graphics {
+
+// Any thread may Push; only the thread that runs the calls calls RunAll. Each call runs outside
+// the lock, so a call may queue another one (RunAll runs it too).
+class PendingCalls {
+ public:
+  void Push(std::function<void()> fn) {
+    std::lock_guard lock(mutex_);
+    queue_.push(std::move(fn));
+  }
+
+  bool Empty() const {
+    std::lock_guard lock(mutex_);
+    return queue_.empty();
+  }
+
+  void RunAll() {
+    while (true) {
+      std::function<void()> fn;
+      {
+        std::lock_guard lock(mutex_);
+        if (queue_.empty()) {
+          return;
+        }
+        fn = std::move(queue_.front());
+        queue_.pop();
+      }
+      fn();
+    }
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  std::queue<std::function<void()>> queue_;
+};
+
+}  // namespace rex::graphics
