+TEST_CASE("On a case-insensitive host a replace onto a case variant deletes nothing",
+          "[filesystem][vfs]") {
+  if (HostIgnoresCase()) {
+    SKIP("this host ignores case: the test above runs this case for real");
+  }
+  // Simulated on a case-sensitive host. On a case-insensitive host 1.TSV and 1.tsv are one file,
+  // which the rename replaces with the new save; removing the variant there would remove the new
+  // save. Here 1.TSV becomes a link to 1.tsv after the mount, so both spellings name one file as
+  // they would there. A removal would delete the link, which the checks below see.
+  RenameStore store({{"1.TSV", "first save"}});
+  std::error_code ec;
+  std::filesystem::rename(store.root() / "1.TSV", store.root() / "1.tsv", ec);
+  REQUIRE_FALSE(ec);
+  std::filesystem::create_symlink("1.tsv", store.root() / "1.TSV", ec);
+  if (ec) {
+    SKIP("this host cannot create symbolic links: " + ec.message());
+  }
+  REQUIRE(store.ReadHost("1.TSV") == "first save");
+
+  store.Write("save.tmp", "new save");
+  REQUIRE(store.Rename("save.tmp", "1.tsv", true) == X_STATUS_SUCCESS);
+  CHECK(std::filesystem::is_symlink(std::filesystem::symlink_status(store.root() / "1.TSV")));
+  CHECK(store.ReadHost("1.tsv") == "new save");
+  CHECK(store.ReadHost("1.TSV") == "new save");
+  CHECK(store.Names() == std::vector<std::string>{"1.tsv", "sub"});
+}
