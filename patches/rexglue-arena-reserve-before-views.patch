+#if REX_PLATFORM_LINUX
+// Reserves [base, base + size) without access if nothing is mapped anywhere in it, and says what
+// is there otherwise. Kernels before 4.17 take MAP_FIXED_NOREPLACE as a hint (patch 38): there a
+// reservation placed elsewhere means the range was taken.
+static bool ReserveFreeRange(uint8_t* base, size_t size) {
+  int flags = MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE;
+#if defined(MAP_FIXED_NOREPLACE)
+  flags |= MAP_FIXED_NOREPLACE;
+#endif
+  void* result = mmap(base, size, PROT_NONE, flags, -1, 0);
+  if (result == base) {
+    return true;
+  }
+  if (result != MAP_FAILED) {
+    munmap(result, size);
+  }
+  const uintptr_t begin = reinterpret_cast<uintptr_t>(base);
+  const uintptr_t end = begin + size;
+  std::ifstream maps("/proc/self/maps");
+  std::string line;
+  int listed = 0;
+  while (listed < 4 && std::getline(maps, line)) {
+    uintptr_t start = 0, stop = 0;
+    if (std::sscanf(line.c_str(), "%zx-%zx", &start, &stop) == 2 && start < end && stop > begin) {
+      REXSYS_INFO("Guest memory arena: 0x{:X} is taken by {}", begin, line);
+      ++listed;
+    }
+  }
+  if (listed == 0) {
+    REXSYS_INFO("Guest memory arena: 0x{:X} could not be reserved", begin);
+  }
+  return false;
+}
+#endif
