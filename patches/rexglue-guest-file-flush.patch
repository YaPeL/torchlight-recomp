+void HostPathDevice::NoteWritten(const std::filesystem::path& host_file) {
+  if (!track_changes_) {
+    return;
+  }
+  std::lock_guard lock(changes_mutex_);
+  written_files_.insert(host_file);
+}
+
+void HostPathDevice::NoteRemoved(const std::filesystem::path& host_file) {
+  if (!track_changes_) {
+    return;
+  }
+  std::lock_guard lock(changes_mutex_);
+  written_files_.erase(host_file);
+}
+
+void HostPathDevice::NoteFolderChanged(const std::filesystem::path& host_folder) {
+  if (!track_changes_) {
+    return;
+  }
+  std::lock_guard lock(changes_mutex_);
+  changed_folders_.insert(host_folder);
+}
+
+HostPathDevice::FlushedChanges HostPathDevice::FlushChanges() {
+  std::set<std::filesystem::path> files, folders;
+  {
+    std::lock_guard lock(changes_mutex_);
+    files.swap(written_files_);
+    folders.swap(changed_folders_);
+  }
+  FlushedChanges result;
+  std::set<std::filesystem::path> failed_files, failed_folders;
+  std::error_code ec;
+  for (const auto& file : files) {
+    if (!std::filesystem::is_regular_file(file, ec)) {
+      continue;  // removed or renamed away since; its folder is in the set
+    }
+    auto handle = FileHandle::OpenExisting(file, FileAccess::kGenericWrite, allow_share_delete_);
+    if (handle && handle->Flush()) {
+      ++result.files;
+    } else {
+      failed_files.insert(file);
+    }
+  }
+  for (const auto& folder : folders) {
+    if (!std::filesystem::is_directory(folder, ec)) {
+      continue;
+    }
+    if (FlushFolder(folder)) {
+      ++result.folders;
+    } else {
+      failed_folders.insert(folder);
+    }
+  }
+  result.failed = failed_files.size() + failed_folders.size();
+  if (result.failed) {
+    std::lock_guard lock(changes_mutex_);
+    written_files_.merge(failed_files);
+    changed_folders_.merge(failed_folders);
+  }
+  return result;
+}
+
