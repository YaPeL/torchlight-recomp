+/**
+ * @file        codegen/argument_locals_test.cpp
+ * @brief       non_argument_in_context and the verify_non_argument_locals checking build
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include <toml++/toml.hpp>
+
+#include <rex/codegen/codegen_context.h>
+#include <rex/codegen/codegen_writer.h>
+#include <rex/codegen/config.h>
+#include <rex/codegen/test_support.h>
+
+#include "codegen/verify_locals.h"
+
+namespace fs = std::filesystem;
+using namespace rex::codegen;
+
+namespace {
+
+constexpr uint32_t kBase = 0x82000000;
+
+/// A config from TOML options, with the two fields every config needs.
+RecompilerConfig ConfigFrom(std::string_view options) {
+  std::string text = "file_path = \"default.xex\"\nout_directory_path = \"generated\"\n";
+  text += options;
+  RecompilerConfig config;
+  REQUIRE(config.LoadFromTable(toml::parse(text), fs::temp_directory_path()));
+  return config;
+}
+
+RecompilerConfig CheckingConfig() {
+  return ConfigFrom(R"(
+non_argument_as_local = true
+non_argument_in_context = ["r12"]
+verify_non_argument_locals = true
+)");
+}
+
+bool Contains(const std::string& text, std::string_view part) {
+  return text.find(part) != std::string::npos;
+}
+
+std::string ReadAll(const fs::path& path) {
+  std::ifstream in(path, std::ios::binary);
+  return std::string((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+}
+
+/// One function of big-endian instruction words, generated with `config`; the output text.
+struct Generated {
+  std::string recomp;
+  std::string pch;
+};
+
+Generated Generate(std::string_view name, const std::vector<uint32_t>& words,
+                   RecompilerConfig config) {
+  fs::path root = fs::temp_directory_path() / "rexglue_argument_locals_test" / fs::path(name);
+  fs::remove_all(root);
+  fs::create_directories(root);
+  std::vector<uint8_t> data;
+  for (uint32_t w : words) {
+    data.insert(data.end(), {uint8_t(w >> 24), uint8_t(w >> 16), uint8_t(w >> 8), uint8_t(w)});
+  }
+  TestModule module;
+  module.Load(kBase, data.data(), data.size());
+  config.projectName = "testproj";
+  config.outDirectoryPath = "generated";
+  auto ctx = CodegenContext::Create(BinaryView::fromModule(module), std::move(config));
+  ctx.setConfigDir(root);
+  ctx.analysisState().format = "xex";
+  ctx.analysisState().loadAddress = kBase;
+  ctx.analysisState().entryPoint = kBase + 0x1000;  // not this function: keep its sub_ name
+  ctx.analysisState().imageSize = static_cast<uint32_t>(data.size());
+  auto size = static_cast<uint32_t>(data.size());
+  auto* node = ctx.graph.addFunction(kBase, size, FunctionAuthority::DISCOVERED, true);
+  REQUIRE(node != nullptr);
+  node->discover({{kBase, size}}, {}, {});
+  node->seal();
+  CodegenWriter writer(ctx);
+  REQUIRE(writer.write(false));
+
+  Generated out;
+  for (const auto& entry : fs::directory_iterator(root / "generated")) {
+    auto file = entry.path().filename().string();
+    if (file.find("_recomp.") != std::string::npos)
+      out.recomp += ReadAll(entry.path());
+    if (file == "testproj_pch.h")
+      out.pch = ReadAll(entry.path());
+  }
+  fs::remove_all(root);
+  return out;
+}
+
+// addi r11,r3,1 / addi r12,r3,2 / stw r11,0(r12) / blr
+const std::vector<uint32_t> kStoreThroughR12 = {0x39630001, 0x39830002, 0x916C0000, 0x4E800020};
+
+}  // namespace
+
+TEST_CASE("non_argument_in_context reads the registers it names", "[codegen][argument_locals]") {
+  auto config = ConfigFrom(R"(non_argument_in_context = ["r12", "r0", "f0", "v40"])");
+  CHECK(config.nonArgumentGprsInContext == ((1u << 12) | 1u));
+  CHECK(config.nonArgumentFprsInContext == 1u);
+  CHECK(config.nonArgumentVmxInContext == (uint64_t{1} << 8));
+}
+
+TEST_CASE("non_argument_in_context ignores registers outside the non-argument set",
+          "[codegen][argument_locals]") {
+  auto config = ConfigFrom(R"(non_argument_in_context = ["r3", "f1", "v31", "v64", "r12x"])");
+  CHECK(config.nonArgumentGprsInContext == 0);
+  CHECK(config.nonArgumentFprsInContext == 0);
+  CHECK(config.nonArgumentVmxInContext == 0);
+}
+
+TEST_CASE("A register kept in the context stays in ctx; the others become locals",
+          "[codegen][argument_locals]") {
+  auto plain = ConfigFrom(R"(
+non_argument_as_local = true
+non_argument_in_context = ["r12"]
+)");
+  auto out = Generate("kept", kStoreThroughR12, plain);
+  CHECK(Contains(out.recomp, "\tr11.s64 = ctx.r3.s64 + 1;"));
+  CHECK(Contains(out.recomp, "\tctx.r12.s64 = ctx.r3.s64 + 2;"));
+  CHECK(Contains(out.recomp, "PPCRegister r11{};"));
+  CHECK_FALSE(Contains(out.recomp, "PPCRegister r12{};"));
+  CHECK_FALSE(Contains(out.recomp, "REX_VERIFY_LOCAL"));
+  CHECK_FALSE(Contains(out.pch, "REX_CONFIG_VERIFY_NON_ARGUMENT_LOCALS"));
+
+  auto all = Generate("all", kStoreThroughR12, ConfigFrom("non_argument_as_local = true"));
+  CHECK(Contains(all.recomp, "\tr12.s64 = ctx.r3.s64 + 2;"));
+}
+
+TEST_CASE("The checking build writes locals through and checks reads",
+          "[codegen][argument_locals]") {
+  auto out = Generate("checking", kStoreThroughR12, CheckingConfig());
+  CHECK(Contains(out.recomp, "\tr11.s64 = ctx.r3.s64 + 1;\n\tctx.r11 = r11;\n"));
+  CHECK(Contains(out.recomp, "\tREX_VERIFY_LOCAL(r11, 0x82000008);\n"));
+  CHECK_FALSE(Contains(out.recomp, "REX_VERIFY_LOCAL(r11, 0x82000000)"));  // a full write
+  CHECK_FALSE(Contains(out.recomp, "REX_VERIFY_LOCAL(r12"));               // kept in ctx
+  CHECK(Contains(out.pch, "#define REX_CONFIG_VERIFY_NON_ARGUMENT_LOCALS"));
+  CHECK(Contains(out.pch, "#define REX_VERIFY_LOCAL(reg, address)"));
+}
+
+TEST_CASE("Checks go only where an instruction reads the register's old value",
+          "[codegen][argument_locals]") {
+  auto config = CheckingConfig();
+  auto instrument = [&](std::string_view text) {
+    return InstrumentNonArgumentLocals(text, config, 0x82001234);
+  };
+  const std::string check = "\tREX_VERIFY_LOCAL(r11, 0x82001234);\n";
+
+  SECTION("a read") {
+    auto out = instrument("\tctx.r3.u64 = r11.u64 + 1;\n");
+    CHECK(out == check + "\tctx.r3.u64 = r11.u64 + 1;\n");
+  }
+  SECTION("a full write, then a read of the new value") {
+    auto out = instrument("\tr11.u64 = ctx.r3.u64;\n\tcr6.compare<int32_t>(r11.s32, 0, xer);\n");
+    CHECK(out ==
+          "\tr11.u64 = ctx.r3.u64;\n\tctx.r11 = r11;\n\tcr6.compare<int32_t>(r11.s32, 0, xer);\n");
+  }
+  SECTION("a write of 32 bits keeps the upper half") {
+    auto out = instrument("\tr11.u32 = ea;\n");
+    CHECK(out == check + "\tr11.u32 = ea;\n\tctx.r11 = r11;\n");
+  }
+  SECTION("a read and a write in one statement") {
+    auto out = instrument("\tr11.u64 = r11.u64 | 4;\n");
+    CHECK(out == check + "\tr11.u64 = r11.u64 | 4;\n\tctx.r11 = r11;\n");
+  }
+  SECTION("a conditional write") {
+    auto out = instrument("\tif (temp.u32 > 3) r11.u64 = 0;\n");
+    CHECK(out == check + "\tif (temp.u32 > 3) r11.u64 = 0;\n\tctx.r11 = r11;\n");
+  }
+  SECTION("every lane written replaces the vector") {
+    std::string lanes;
+    for (int i = 0; i < 4; ++i)
+      lanes += "\tv40.f32[" + std::to_string(i) + "] = log2f(ctx.v1.f32[" + std::to_string(i) +
+               "]);\n";
+    auto out = instrument(lanes);
+    CHECK_FALSE(Contains(out, "REX_VERIFY_LOCAL"));
+    CHECK(Contains(out, "\tctx.v40 = v40;\n"));
+  }
+  SECTION("lanes of one width written in two element types") {
+    auto out = instrument(
+        "\tv59.u32[3] = vTemp.u32[0];\n\tv59.u32[2] = vTemp.u32[0];\n"
+        "\tv59.f32[1] = 0.0f;\n\tv59.f32[0] = 1.0f;\n");
+    CHECK_FALSE(Contains(out, "REX_VERIFY_LOCAL"));
+  }
+  SECTION("some lanes written keep the others") {
+    auto out = instrument("\tv40.u32[0] = vTemp.u32[0];\n");
+    CHECK(Contains(out, "\tREX_VERIFY_LOCAL(v40, 0x82001234);\n"));
+  }
+  SECTION("a store intrinsic writes the whole vector") {
+    auto out = instrument(
+        "\tsimde_mm_store_si128((simde__m128i*)v40.u8, "
+        "simde_mm_load_si128((simde__m128i*)v41.u8));\n");
+    CHECK(Contains(out, "\tREX_VERIFY_LOCAL(v41, 0x82001234);\n"));
+    CHECK_FALSE(Contains(out, "REX_VERIFY_LOCAL(v40"));
+    CHECK(Contains(out, "\tctx.v40 = v40;\n"));
+    CHECK_FALSE(Contains(out, "\tctx.v41 = v41;\n"));  // only read
+  }
+  SECTION("the write-through goes before a line that leaves the instruction") {
+    auto out = instrument("\tr11.s64 = 5;\n\tif (cr6.eq) goto loc_82001240;\n");
+    CHECK(out == "\tr11.s64 = 5;\n\tctx.r11 = r11;\n\tif (cr6.eq) goto loc_82001240;\n");
+  }
+  SECTION("context registers, temporaries and other names are left alone") {
+    std::string text =
+        "\tctx.r11.u64 = ctx.r12.u64;\n\ttemp.u32 = cr0.eq;\n\tvTemp.u32[0] = ctx.f0.u32;\n";
+    CHECK(instrument(text) == text);
+  }
+  SECTION("a register kept in the context is not checked") {
+    std::string text = "\tctx.r3.u64 = r12.u64;\n";
+    CHECK(instrument(text) == text);
+  }
+}
+
+TEST_CASE("An operand whose value the result ignores is not checked",
+          "[codegen][argument_locals]") {
+  // subfe r10,r11,r11 / xor r10,r11,r11 / subf r10,r11,r11 / subfe r10,r11,r9 / blr
+  const std::vector<uint32_t> words = {0x7D4B5910, 0x7D6A5A78, 0x7D4B5850, 0x7D4B4910,
+                                       0x4E800020};
+  auto out = Generate("same_register", words, CheckingConfig());
+  CHECK_FALSE(Contains(out.recomp, "REX_VERIFY_LOCAL(r11, 0x82000000)"));  // subfe rA == rB
+  CHECK_FALSE(Contains(out.recomp, "REX_VERIFY_LOCAL(r11, 0x82000004)"));  // xor rS == rB
+  CHECK_FALSE(Contains(out.recomp, "REX_VERIFY_LOCAL(r11, 0x82000008)"));  // subf rA == rB
+  CHECK(Contains(out.recomp, "REX_VERIFY_LOCAL(r11, 0x8200000C)"));        // subfe rA != rB
+
+  auto config = CheckingConfig();
+  CHECK(InstrumentNonArgumentLocals("\tctx.r10.u64 = ~r11.u64 + r11.u64;\n", config, 0x82001234,
+                                    "r11") == "\tctx.r10.u64 = ~r11.u64 + r11.u64;\n");
+}
+
+TEST_CASE("Without the checking option nothing is instrumented", "[codegen][argument_locals]") {
+  auto config = ConfigFrom("non_argument_as_local = true");
+  std::string text = "\tctx.r3.u64 = r11.u64 + 1;\n";
+  CHECK(InstrumentNonArgumentLocals(text, config, 0x82001234) == text);
+}
