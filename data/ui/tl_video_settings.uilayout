            <Property Name="HoverImage" Value="set:widgets2 image:slider_bar_rollover" />
            <Property Name="NormalImage" Value="set:widgets2 image:slider_bar" />
            <Property Name="PushedImage" Value="set:widgets2 image:slider_bar_rollover" />
            <Property Name="DisabledImage" Value="set:widgets2 image:slider_bar" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="UnifiedAreaRect" Value="{{0,16},{0,162},{0,279},{0,200}}" />
            <Property Name="WantsMultiClickEvents" Value="False" />
            <Window Type="ceguiWidget/StaticText" Name="tl_video/fps_cap/value" >
                <Property Name="Font" Value="Serif14" />
                <Property Name="Text" Value="&lt; 60 &gt;" />
                <Property Name="TextColour" Value="FFFCD615" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,-3},{1,0},{1,-3}}" />
                <Property Name="HorzTextFormatting" Value="CentreAligned" />
                <Property Name="VertFormatting" Value="CentreAligned" />
                <Property Name="WantsMultiClickEvents" Value="False" />
                <Property Name="MousePassThroughEnabled" Value="True" />
            </Window>
        </Window>
        <Window Type="ceguiWidget/StaticText" Name="tl_video/language/label" >
            <Property Name="Font" Value="Serif14" />
            <Property Name="Text" Value="Language" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
