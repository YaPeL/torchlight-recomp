+#endif
   PathConfig path_config{game_dir,  user_dir,     update_dir,
-                         cache_dir, metadata_dir, exe_dir / (std::string(GetName()) + ".toml")};
+                         cache_dir, metadata_dir, settings_dir / (std::string(GetName()) + ".toml")};
   OnConfigurePaths(path_config);
