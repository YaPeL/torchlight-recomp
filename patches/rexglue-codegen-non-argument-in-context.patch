diff --git a/src/codegen/verify_locals.cpp b/src/codegen/verify_locals.cpp
new file mode 100644
index 0000000..c17c330
--- /dev/null
+++ b/src/codegen/verify_locals.cpp
@@ -0,0 +1,295 @@
+/**
+ * @file        codegen/verify_locals.cpp
+ * @brief       Checking build for non_argument_as_local (verify_non_argument_locals)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "verify_locals.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstddef>
+#include <map>
+#include <set>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include <rex/codegen/config.h>
+
+#include <ppc.h>
+
+namespace rex::codegen {
+
+namespace {
+
+/// The non-argument registers this config keeps in locals, by the name the builders emit.
+std::set<std::string> LocalNonArgumentNames(const RecompilerConfig& cfg) {
+  std::set<std::string> names;
+  if (!cfg.nonArgumentRegistersAsLocalVariables) {
+    return names;
+  }
+  for (unsigned index : {0u, 2u, 11u, 12u}) {
+    if (!(cfg.nonArgumentGprsInContext & (1u << index))) {
+      names.insert(fmt::format("r{}", index));
+    }
+  }
+  if (!(cfg.nonArgumentFprsInContext & 1u)) {
+    names.insert("f0");
+  }
+  for (unsigned index = 32; index <= 63; ++index) {
+    if (!(cfg.nonArgumentVmxInContext & (uint64_t{1} << (index - 32)))) {
+      names.insert(fmt::format("v{}", index));
+    }
+  }
+  return names;
+}
+
+bool IsWordChar(char c) {
+  return std::isalnum(static_cast<unsigned char>(c)) || c == '_';
+}
+
+/// Lanes of a vector register for an element field; 0 if not a lane field.
+unsigned LaneCount(std::string_view field) {
+  if (field == "u8" || field == "s8")
+    return 16;
+  if (field == "u16" || field == "s16")
+    return 8;
+  if (field == "u32" || field == "s32" || field == "f32")
+    return 4;
+  if (field == "u64" || field == "s64" || field == "f64")
+    return 2;
+  return 0;
+}
+
+enum class Use { kRead, kFullWrite, kLaneWrite, kPartialWrite };
+
+struct Mention {
+  std::string name;
+  Use use;
+  unsigned lanes = 0;  // kLaneWrite: lanes of its element type (16 for u8, 4 for u32 and f32)
+  unsigned lane = 0;   // kLaneWrite: which lane
+};
+
+/// How one occurrence of a register name at `pos` in `line` is used.
+Mention Classify(std::string_view line, size_t pos, const std::string& name) {
+  Mention m{name, Use::kRead};
+  size_t i = pos + name.size();
+  std::string field;
+  bool indexed = false;
+  unsigned lane = 0;
+  if (i < line.size() && line[i] == '.') {
+    size_t start = ++i;
+    while (i < line.size() && IsWordChar(line[i]))
+      ++i;
+    field = std::string(line.substr(start, i - start));
+    if (i < line.size() && line[i] == '[') {
+      indexed = true;
+      size_t close = line.find(']', i);
+      size_t length = close == std::string_view::npos ? 0 : close - i - 1;
+      std::string_view idx = line.substr(i + 1, length);
+      bool digits = !idx.empty();
+      for (char c : idx)
+        digits = digits && std::isdigit(static_cast<unsigned char>(c));
+      lane = digits ? static_cast<unsigned>(std::stoul(std::string(idx))) : ~0u;
+      i = close == std::string_view::npos ? line.size() : close + 1;
+    }
+  }
+  while (i < line.size() && line[i] == ' ')
+    ++i;
+  bool assign = i < line.size() && line[i] == '=' && (i + 1 >= line.size() || line[i + 1] != '=');
+  bool compound = false;
+  static constexpr std::string_view kCompound[] = {"+=", "-=", "*=", "/=", "|=", "&=",
+                                                   "^=", "<<=", ">>=", "++", "--"};
+  for (std::string_view op : kCompound) {
+    if (line.substr(i, op.size()) == op)
+      compound = true;
+  }
+  if (pos >= 2 && (line.substr(pos - 2, 2) == "++" || line.substr(pos - 2, 2) == "--"))
+    compound = true;
+
+  // A store intrinsic whose first argument is this register writes all of it.
+  size_t first = line.find_first_not_of(" \t");
+  std::string_view head = line.substr(first == std::string_view::npos ? line.size() : first);
+  if (head.starts_with("simde_mm_store_")) {
+    size_t paren = head.find('(');
+    size_t comma = head.find(',');
+    size_t at = pos - (line.size() - head.size());
+    if (paren != std::string_view::npos && comma != std::string_view::npos && at > paren &&
+        at < comma) {
+      m.use = Use::kFullWrite;
+      return m;
+    }
+  }
+  if (compound) {
+    m.use = Use::kPartialWrite;
+    return m;
+  }
+  if (!assign) {
+    return m;
+  }
+  bool atLineStart = line.find_first_not_of(" \t") == pos;
+  if (!atLineStart) {
+    m.use = Use::kPartialWrite;  // a conditional or nested assignment
+    return m;
+  }
+  if (field.empty()) {
+    m.use = Use::kFullWrite;
+  } else if (!indexed && (field == "u64" || field == "s64" || field == "f64")) {
+    m.use = Use::kFullWrite;
+  } else if (indexed && name[0] == 'v' && LaneCount(field) != 0 && lane != ~0u) {
+    m.use = Use::kLaneWrite;
+    m.lanes = LaneCount(field);
+    m.lane = lane;
+  } else {
+    m.use = Use::kPartialWrite;
+  }
+  return m;
+}
+
+/// The register names in one line, in order, outside `//` comments and not as ctx.<name>.
+std::vector<std::pair<size_t, std::string>> FindNames(std::string_view line,
+                                                      const std::set<std::string>& names) {
+  std::vector<std::pair<size_t, std::string>> found;
+  size_t end = line.find("//");
+  if (end == std::string_view::npos)
+    end = line.size();
+  for (size_t i = 0; i < end; ++i) {
+    char c = line[i];
+    if (c != 'r' && c != 'f' && c != 'v')
+      continue;
+    if (i > 0 && (IsWordChar(line[i - 1]) || line[i - 1] == '.'))
+      continue;
+    size_t j = i + 1;
+    while (j < end && std::isdigit(static_cast<unsigned char>(line[j])))
+      ++j;
+    if (j == i + 1 || (j < end && IsWordChar(line[j])))
+      continue;
+    std::string name(line.substr(i, j - i));
+    if (names.count(name))
+      found.emplace_back(i, std::move(name));
+    i = j - 1;
+  }
+  return found;
+}
+
+bool TransfersControl(std::string_view line) {
+  return line.find("goto ") != std::string_view::npos ||
+         line.find("return") != std::string_view::npos ||
+         line.find("(ctx, base") != std::string_view::npos ||
+         line.find("REX_CALL_INDIRECT_FUNC") != std::string_view::npos ||
+         line.find("__builtin_trap") != std::string_view::npos;
+}
+
+}  // namespace
+
+std::string IgnoredSameRegisterOperand(int opcode, uint32_t operandA, uint32_t operandB) {
+  switch (opcode) {
+    case PPC_INST_SUBF:
+    case PPC_INST_SUBFC:
+    case PPC_INST_SUBFE:
+    case PPC_INST_XOR:
+    case PPC_INST_EQV:
+    case PPC_INST_ANDC:
+      if (operandA == operandB)
+        return fmt::format("r{}", operandA);
+      return {};
+    default:
+      return {};
+  }
+}
+
+std::string InstrumentNonArgumentLocals(std::string_view text, const RecompilerConfig& config,
+                                        uint32_t address, std::string_view unused) {
+  if (!config.verifyNonArgumentLocals) {
+    return std::string(text);
+  }
+  auto names = LocalNonArgumentNames(config);
+  if (names.empty()) {
+    return std::string(text);
+  }
+
+  std::vector<std::string_view> lines;
+  for (size_t start = 0; start < text.size();) {
+    size_t nl = text.find('\n', start);
+    size_t stop = nl == std::string_view::npos ? text.size() : nl + 1;
+    lines.push_back(text.substr(start, stop - start));
+    start = stop;
+  }
+
+  // Which registers the instruction reads before overwriting them whole, and which lines write
+  // which registers. Lane writes complete a register when every lane of one width is written.
+  std::vector<std::string> reads;
+  std::set<std::string> decided;
+  std::map<std::string, std::map<unsigned, std::set<unsigned>>> lanes;
+  std::vector<std::set<std::string>> writes(lines.size());
+  std::set<std::string> named;
+  auto decide = [&](const std::string& name, bool read) {
+    if (decided.insert(name).second && read)
+      reads.push_back(name);
+  };
+  for (size_t k = 0; k < lines.size(); ++k) {
+    // A statement evaluates its operands before it stores, so a line's reads come first.
+    std::vector<Mention> mentions;
+    for (auto& [pos, name] : FindNames(lines[k], names))
+      mentions.push_back(Classify(lines[k], pos, name));
+    std::stable_partition(mentions.begin(), mentions.end(),
+                          [](const Mention& m) { return m.use == Use::kRead; });
+    for (const Mention& m : mentions) {
+      const std::string& name = m.name;
+      named.insert(name);
+      if (m.use != Use::kRead)
+        writes[k].insert(name);
+      switch (m.use) {
+        case Use::kRead:
+        case Use::kPartialWrite:
+          decide(name, true);
+          break;
+        case Use::kFullWrite:
+          decide(name, false);
+          break;
+        case Use::kLaneWrite: {
+          auto& set = lanes[name][m.lanes];
+          set.insert(m.lane);
+          if (set.size() >= m.lanes)
+            decide(name, false);
+          break;
+        }
+      }
+    }
+  }
+  if (named.empty()) {
+    return std::string(text);
+  }
+  for (const auto& name : named) {
+    decide(name, true);  // lanes written only in part keep the rest of the old value
+  }
+
+  std::string out;
+  for (const auto& name : reads) {
+    if (name != unused)
+      out += fmt::format("\tREX_VERIFY_LOCAL({}, 0x{:08X});\n", name, address);
+  }
+  // Write each local through to the context after the line that writes it, or before a line that
+  // leaves the instruction, so a callee and the next check see the local's value.
+  std::set<std::string> pending;
+  auto flush = [&] {
+    for (const auto& name : pending)
+      out += fmt::format("\tctx.{0} = {0};\n", name);
+    pending.clear();
+  };
+  for (size_t k = 0; k < lines.size(); ++k) {
+    if (TransfersControl(lines[k]))
+      flush();
+    out += lines[k];
+    pending.insert(writes[k].begin(), writes[k].end());
+    if (!TransfersControl(lines[k]))
+      flush();
+  }
+  flush();
+  return out;
+}
+
+}  // namespace rex::codegen
