-  // Always ignoring case
+  // Always ignoring case. Windows/Xbox find semantics for the pattern's end: "*.*" matches every
+  // name, with or without a dot, and so does any pattern ending in ".*" whose stem matches a name
+  // without a dot ("a*.*" matches "abc"); a pattern ending in "." matches only names without a dot
+  // ("*." matches "media", not "a.dat").
   bool Match(const std::string_view str) const;
 
  private:
+  enum class DosEnd { kNone, kDotStar, kDot };
   std::vector<WildcardRule> rules_;
+  std::vector<WildcardRule> stem_rules_;  // the pattern without its ".*" or "." end
+  DosEnd dos_end_ = DosEnd::kNone;
+  static std::vector<WildcardRule> Rules(const std::string_view pattern);
   void PreparePattern(const std::string_view pattern);
 };
 
