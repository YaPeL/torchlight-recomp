+/**
+ * @file        input/keystroke_repeat.h
+ * @brief       XInput keystroke events from a pad's button bits, with key repeat.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+namespace rex::input {
+
+// What a pad has reported as keystrokes so far.
+struct KeystrokeTracker {
+  enum class Repeat : uint8_t {
+    kIdle,       // nothing to repeat
+    kWaiting,    // a button is held and the delay is awaited
+    kRepeating,  // repeating at the rate
+  };
+  uint64_t buttons = 0;  // bits reported as down
+  Repeat repeat = Repeat::kIdle;
+  uint8_t repeat_index = 0;  // the button pressed last
+  uint32_t repeat_time = 0;  // when its down or last repeat was reported (ms)
+};
+
+struct Keystroke {
+  uint8_t index;  // button bit
+  bool down;      // false: up
+  bool repeat;    // a repeated down
+};
+
+// The next keystroke for the buttons now `pressed` (bit i = button i, i < `count`), or nothing.
+// Bits outside `reportable` are never reported. Ups come before downs (so a thumb diagonal is up
+// before its side is down, as XInput does). A held button repeats after `delay_ms`, then every
+// `rate_ms`, only while it is still pressed: XInput never repeats a released button, and a guest
+// that stops reading keystrokes for a while (a loading screen) would otherwise get a repeated
+// down for a button released meanwhile, before its up.
+inline std::optional<Keystroke> NextKeystroke(KeystrokeTracker& t, uint64_t pressed,
+                                              uint64_t reportable, uint8_t count, uint32_t now_ms,
+                                              uint32_t delay_ms, uint32_t rate_ms) {
+  using Repeat = KeystrokeTracker::Repeat;
+  if (t.repeat != Repeat::kIdle && !((pressed >> t.repeat_index) & 1)) {
+    t.repeat = Repeat::kIdle;  // released: its up comes from the change pass below
+  }
+  if (t.repeat == Repeat::kWaiting && t.repeat_time + delay_ms < now_ms) {
+    t.repeat = Repeat::kRepeating;
+  }
+  if (t.repeat == Repeat::kRepeating && t.repeat_time + rate_ms < now_ms) {
+    t.repeat_time = now_ms;
+    return Keystroke{t.repeat_index, true, true};
+  }
+  const uint64_t changed = (pressed ^ t.buttons) & reportable;
+  if (!changed) {
+    return std::nullopt;
+  }
+  for (uint8_t i = 0; i < count; i++) {
+    const uint64_t bit = uint64_t(1) << i;
+    if ((changed & bit) && !(pressed & bit)) {
+      t.buttons &= ~bit;
+      t.repeat = Repeat::kIdle;
+      return Keystroke{i, false, false};
+    }
+  }
+  for (uint8_t i = 0; i < count; i++) {
+    const uint64_t bit = uint64_t(1) << i;
+    if ((changed & bit) && (pressed & bit)) {
+      t.buttons |= bit;
+      t.repeat = Repeat::kWaiting;
+      t.repeat_index = i;
+      t.repeat_time = now_ms;
+      return Keystroke{i, true, false};
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace rex::input
