-            // Check if multisampling supported
-            if(rs->hasMinGLVersion(3, 0))
+            // Check if multisampling supported. With EXT_multisampled_render_to_texture (tile
+            // GPUs) the samples live in tile memory and are resolved as the tile is written out:
+            // no second framebuffer, no blit, no stored samples.
+            mImplicitMultisample = false;
+            if(mNumSamples && rs->checkExtension("GL_EXT_multisampled_render_to_texture"))
+            {
+                GLint maxSamples;
+                OGRE_CHECK_GL_ERROR(glGetIntegerv(GL_MAX_SAMPLES_EXT, &maxSamples));
+                mNumSamples = std::min(mNumSamples, maxSamples);
+                mImplicitMultisample = mNumSamples > 0;
+            }
+            else if(rs->hasMinGLVersion(3, 0))
             {
                 // Check samples supported
