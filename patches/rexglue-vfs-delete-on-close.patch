 }
 
+void Entry::AddOpenFile(File* file) {
+  auto global_lock = global_critical_region_.Acquire();
+  open_files_.push_back(file);
+}
+
+void Entry::ReleaseOpenFile(File* file) {
+  auto global_lock = global_critical_region_.Acquire();
+  open_files_.erase(std::remove(open_files_.begin(), open_files_.end(), file), open_files_.end());
+  if (open_files_.empty() && delete_on_close_ && parent_) {
+    // Deleting removes this entry from its parent and destroys it: nothing may touch members after
+    // this call. If the host refuses, the entry stays, still marked.
+    parent_->Delete(this);
+  }
+}
+
+File::File(uint32_t file_access, Entry* entry) : file_access_(file_access), entry_(entry) {
+  if (entry_) {
+    entry_->AddOpenFile(this);
+  }
+}
+
+// Runs after the derived file closed its host handle, so the host file can be removed.
+File::~File() {
+  auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+  if (entry_) {
+    entry_->ReleaseOpenFile(this);
+  }
+}
