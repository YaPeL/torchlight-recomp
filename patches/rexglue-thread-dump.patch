+TEST_CASE("Thread dump's command processor section returns with its pending calls' lock held "
+          "by another thread",
+          "[thread_dump]") {
+  rex::graphics::PendingCalls calls;
+  calls.Push([] {});
+  rex::graphics::CommandProcessorDumpState state;
+  state.read_ptr = 0x40;
+  state.wait_reg_mem_since_ms = rex::graphics::CommandProcessorDumpNowMs() - 12000;
+  state.wait_reg_mem_address = 0x1234;
+  state.wait_reg_mem_info = 0x13;  // memory, equal
+  state.wait_reg_mem_reference = 5;
+  state.wait_reg_mem_mask = 0xFF;
+  state.wait_reg_mem_value = 4;
+
+  struct Context {
+    rex::graphics::CommandProcessorDumpState* state;
+    rex::graphics::PendingCalls* calls;
+  } context{&state, &calls};
+  rex::system::ThreadDumpSection section = [](void* opaque, std::string& out) {
+    auto* c = static_cast<Context*>(opaque);
+    rex::graphics::AppendCommandProcessorState(*c->state, 0x80, true, *c->calls,
+                                               rex::graphics::CommandProcessorDumpNowMs(), out);
+  };
+  REQUIRE(rex::system::RegisterThreadDumpSection(section, &context));
+
+  std::string dump = FormatThreadDump("free");
+  CHECK(dump.find("command processor: worker running, ring read 00000040 write 00000080, "
+                  "in WAIT_REG_MEM for 12.") != std::string::npos);
+  CHECK(dump.find("(memory 00001234, function 3, reference 00000005, mask 000000FF, "
+                  "last value 00000004), 1 pending calls") != std::string::npos);
+
+  std::promise<void> holding, release;
+  std::thread holder([&] {
+    auto lock = calls.LockForTesting();
+    holding.set_value();
+    release.get_future().wait();
+  });
+  holding.get_future().wait();
+  dump = DumpWithin1s([] { return FormatThreadDump("locked"); });
+  CHECK(dump.find("pending calls inconsistent (locked)") != std::string::npos);
+  release.set_value();
+  holder.join();
+
+  state.wait_reg_mem_since_ms = -1;
+  state.idle_since_ms = rex::graphics::CommandProcessorDumpNowMs() - 3000;
+  dump = FormatThreadDump("idle");
+  CHECK(dump.find("idle (ring empty) for 3.") != std::string::npos);
+
+  rex::system::UnregisterThreadDumpSection(section, &context);
+  CHECK(FormatThreadDump("gone").find("command processor") == std::string::npos);
+}
