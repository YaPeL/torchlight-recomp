new file mode 100644
index 0000000..f7bc96a
--- /dev/null
+++ b/src/system/guest_fatal.cpp
@@ -0,0 +1,61 @@
+/**
+ * @file        system/guest_fatal.cpp
+ * @brief       Fatal guest errors: a hook the app registers, and an end that never returns
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/system/guest_fatal.h>
+
+#include <atomic>
+#include <cstdlib>
+
+#include <rex/dbg.h>
+#include <rex/logging.h>
+#include <rex/ppc/context.h>
+
+namespace rex::system {
+
+namespace {
+
+std::atomic<GuestFatalHandler> fatal_handler{nullptr};
+
+const char* KindName(GuestFatalKind kind) {
+  switch (kind) {
+    case GuestFatalKind::kException:
+      return "exception";
+    case GuestFatalKind::kCppException:
+      return "C++ exception";
+    case GuestFatalKind::kBugCheck:
+      return "bug check";
+    case GuestFatalKind::kDebugBreak:
+      return "debug break";
+  }
+  return "unknown";
+}
+
+}  // namespace
+
+void SetGuestFatalHandler(GuestFatalHandler handler) {
+  fatal_handler.store(handler);
+}
+
+void RaiseGuestFatal(const GuestFatalError& error) {
+  const uint32_t lr = error.context ? static_cast<uint32_t>(error.context->lr) : 0;
+  REXSYS_ERROR(
+      "Fatal guest {}: code {:#010x}, {} parameters ({:#x}, {:#x}, {:#x}, {:#x}), record {:#x}, "
+      "thread {:#x}, called from {:#010x}",
+      KindName(error.kind), error.code, error.parameter_count, error.parameters[0],
+      error.parameters[1], error.parameters[2], error.parameters[3], error.record_address,
+      error.thread_id, lr);
+  if (GuestFatalHandler handler = fatal_handler.load()) {
+    handler(error);
+  }
+  if (rex::debug::IsDebuggerAttached()) {
+    rex::debug::Break();
+  }
+  std::abort();
+}
+
+}  // namespace rex::system
