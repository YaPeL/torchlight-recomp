+# fctiw and fctid convert in the rounding mode FPSCR[RN] selects, set with
+# mtfsf 0xFF (f1). Each test puts the mode back to round to nearest (f0 = 0).
+
+# fctiw 2.5, round to nearest: 2
+test_fctiw_rounding_1:
+  #_ REGISTER_IN f0 0x0000000000000000
+  #_ REGISTER_IN f1 0x0000000000000000
+  #_ REGISTER_IN f2 0x4004000000000000
+  mtfsf 0xFF, f1
+  fctiw f3, f2
+  mtfsf 0xFF, f0
+  blr
+  #_ REGISTER_OUT f2 0x4004000000000000
+  #_ REGISTER_OUT f3 0x0000000000000002
+
+# fctiw -2.5, round to nearest: -2
+test_fctiw_rounding_2:
+  #_ REGISTER_IN f0 0x0000000000000000
+  #_ REGISTER_IN f1 0x0000000000000000
+  #_ REGISTER_IN f2 0xC004000000000000
+  mtfsf 0xFF, f1
+  fctiw f3, f2
+  mtfsf 0xFF, f0
+  blr
+  #_ REGISTER_OUT f2 0xC004000000000000
+  #_ REGISTER_OUT f3 0xFFFFFFFFFFFFFFFE
+
+# fctiw 3.5, round to nearest: 4
