+#if REX_PLATFORM_LINUX
+  // A commit is almost always over a range a heap already reserved (or a mapped view): change its
+  // protection, one system call. mprotect fails with ENOMEM where part of the range is not mapped,
+  // and only then is it mapped below. Trying the mmap first cost a failed mmap and a walk of
+  // /proc/self/maps per commit (about 30 us with a loaded game's mappings), and on kernels before
+  // 4.17 a mapping made elsewhere and removed again (patch 38).
+  // (mprotect accepts a zero length, which the mmap below refuses, so that stays the mmap's.)
+  if (base_address != nullptr && length != 0 && allocation_type == AllocationType::kCommit) {
+    if (mprotect(base_address, length, static_cast<int>(prot_requested)) == 0) {
+      return base_address;
+    }
+    if (errno != ENOMEM) {
+      return nullptr;
+    }
+  }
+#endif
