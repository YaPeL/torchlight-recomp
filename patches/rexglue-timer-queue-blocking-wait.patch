+/**
+ * @file        core/timer_queue_test.cpp
+ * @brief       The timer queue waits on a condition variable: timed waits, timers, idle CPU
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <atomic>
+#include <chrono>
+#include <iterator>
+#include <thread>
+
+#include <disruptorplus/blocking_wait_strategy.hpp>
+
+#include <rex/thread/timer_queue.h>
+
+#if defined(__linux__)
+#include <unistd.h>
+
+#include <fstream>
+#include <sstream>
+#include <string>
+#define REX_TEST_THREAD_CPU 1
+#elif defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#define REX_TEST_THREAD_CPU 1
+#endif
+
+namespace dp = disruptorplus;
+using namespace std::chrono_literals;
+using Clock = std::chrono::steady_clock;
+
+namespace {
+
+/// A sequence nothing has published yet, for the strategy's waits.
+struct Unpublished {
+  std::atomic<dp::sequence_t> sequence{static_cast<dp::sequence_t>(-1)};
+  const std::atomic<dp::sequence_t>* list[1] = {&sequence};
+};
+
+#if defined(REX_TEST_THREAD_CPU)
+#if defined(__linux__)
+using ThreadId = pid_t;
+ThreadId CurrentThreadId() {
+  return gettid();
+}
+#else
+using ThreadId = DWORD;
+ThreadId CurrentThreadId() {
+  return GetCurrentThreadId();
+}
+#endif
+
+/// The dispatch thread's id: callbacks run on it. (Its name is not a way to find it: at 23
+/// characters it is too long for pthread_setname_np, which then leaves the thread unnamed.)
+ThreadId DispatchThreadId() {
+  std::atomic<ThreadId> tid{0};
+  rex::thread::QueueTimerOnce([&](void*) { tid = CurrentThreadId(); }, nullptr, Clock::now());
+  for (auto deadline = Clock::now() + 5s; tid == 0 && Clock::now() < deadline;)
+    std::this_thread::sleep_for(1ms);
+  return tid;
+}
+
+/// CPU time (user + system) a thread of this process has used, or -1 ms if it cannot be read.
+#if defined(__linux__)
+std::chrono::milliseconds ThreadCpu(ThreadId tid) {
+  std::ifstream statFile("/proc/self/task/" + std::to_string(tid) + "/stat");
+  std::string stat((std::istreambuf_iterator<char>(statFile)), std::istreambuf_iterator<char>());
+  if (stat.rfind(')') == std::string::npos)
+    return std::chrono::milliseconds(-1);
+  // Fields after the parenthesised name: state is field 3, utime 14 and stime 15.
+  std::istringstream fields(stat.substr(stat.rfind(')') + 2));
+  std::string field;
+  long long utime = 0, stime = 0;
+  for (int index = 3; fields >> field; ++index) {
+    if (index == 14)
+      utime = std::stoll(field);
+    if (index == 15) {
+      stime = std::stoll(field);
+      break;
+    }
+  }
+  const long ticks = sysconf(_SC_CLK_TCK);
+  return std::chrono::milliseconds((utime + stime) * 1000 / ticks);
+}
+#else
+std::chrono::milliseconds ThreadCpu(ThreadId tid) {
+  HANDLE thread = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, tid);
+  FILETIME created, exited, kernel, user;
+  BOOL ok = thread && GetThreadTimes(thread, &created, &exited, &kernel, &user);
+  if (thread)
+    CloseHandle(thread);
+  if (!ok)
+    return std::chrono::milliseconds(-1);
+  auto hundreds = [](const FILETIME& time) {
+    return (static_cast<long long>(time.dwHighDateTime) << 32) | time.dwLowDateTime;
+  };
+  return std::chrono::milliseconds((hundreds(kernel) + hundreds(user)) / 10000);
+}
+#endif
+#endif
+
+}  // namespace
+
+TEST_CASE("The blocking strategy's timed waits time out", "[timer_queue]") {
+  dp::blocking_wait_strategy strategy;
+  Unpublished unpublished;
+
+  auto start = Clock::now();
+  auto result = strategy.wait_until_published(0, 1, unpublished.list, 20ms);
+  CHECK(dp::difference(result, 0) < 0);
+  CHECK(Clock::now() - start >= 15ms);
+
+  start = Clock::now();
+  result = strategy.wait_until_published(0, 1, unpublished.list, start + 20ms);
+  CHECK(dp::difference(result, 0) < 0);
+  CHECK(Clock::now() - start >= 15ms);
+}
+
+TEST_CASE("The blocking strategy's timed waits return when a sequence is published",
+          "[timer_queue]") {
+  dp::blocking_wait_strategy strategy;
+  Unpublished unpublished;
+  std::thread publisher([&] {
+    std::this_thread::sleep_for(20ms);
+    unpublished.sequence.store(0, std::memory_order_release);
+    strategy.signal_all_when_blocking();
+  });
+  auto start = Clock::now();
+  auto result = strategy.wait_until_published(0, 1, unpublished.list, Clock::now() + 10s);
+  publisher.join();
+  CHECK(dp::difference(result, 0) >= 0);
+  CHECK(Clock::now() - start < 5s);
+}
+
+TEST_CASE("Queued timers fire, recur and stop when disarmed", "[timer_queue]") {
+  std::atomic<int> once{0};
+  auto start = Clock::now();
+  std::atomic<long long> fired_after_us{-1};
+  auto item = rex::thread::QueueTimerOnce(
+      [&](void*) {
+        fired_after_us = std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - start)
+                             .count();
+        once.fetch_add(1);
+      },
+      nullptr, start + 20ms);
+
+  std::atomic<int> ticks{0};
+  auto recurring = rex::thread::QueueTimerRecurring([&](void*) { ticks.fetch_add(1); }, nullptr,
+                                                    Clock::now(), 1ms);
+  std::this_thread::sleep_for(300ms);
+  if (auto locked = recurring.lock())
+    locked->Disarm();
+  const int after_disarm = ticks.load();
+  std::this_thread::sleep_for(50ms);
+
+  CHECK(once.load() == 1);
+  CHECK(fired_after_us.load() >= 20000);
+  CHECK(fired_after_us.load() < 250000);  // loose: a loaded runner can be late, never early
+  CHECK(after_disarm >= 50);              // about 300 at 1 ms; loose for loaded runners
+  CHECK(ticks.load() == after_disarm);
+
+  std::atomic<int> cancelled{0};
+  auto never = rex::thread::QueueTimerOnce([&](void*) { cancelled.fetch_add(1); }, nullptr,
+                                           Clock::now() + 50ms);
+  if (auto locked = never.lock())
+    locked->Disarm();
+  std::this_thread::sleep_for(100ms);
+  CHECK(cancelled.load() == 0);
+}
+
+#if defined(__linux__)
+TEST_CASE("The dispatch thread sleeps between timers", "[timer_queue]") {
+  // A 1 ms recurring timer, as the kernel's KeTimeStampBundle tick keeps queued: with a spinning
+  // wait the dispatch thread runs most of the time between ticks.
+  std::atomic<int> ticks{0};
+  auto recurring = rex::thread::QueueTimerRecurring([&](void*) { ticks.fetch_add(1); }, nullptr,
+                                                    Clock::now(), 1ms);
+  const ThreadId tid = DispatchThreadId();
+  REQUIRE(tid != 0);
+  std::this_thread::sleep_for(50ms);
+  const auto before = ThreadCpu(tid);
+  REQUIRE(before.count() >= 0);
+  std::this_thread::sleep_for(1s);
+  const auto after = ThreadCpu(tid);
+  if (auto locked = recurring.lock())
+    locked->Disarm();
+  REQUIRE(after.count() >= 0);
+  const auto used = after - before;
+  INFO("dispatch thread CPU over 1 s: " << used.count() << " ms, ticks " << ticks.load());
+  // Measured on Linux x86-64: 10 ms waiting on the condition variable, 230 ms spinning. A loaded
+  // machine can only lower the spinning figure, not raise the blocking one.
+  CHECK(used < 100ms);
+}
+#endif
+
+TEST_CASE("The dispatch thread waits for a timer when the queue is empty", "[timer_queue]") {
+  // With no timer queued the dispatch thread's deadline is the clock's largest time point; a
+  // condition variable has to take it without overflowing into a wait that returns at once.
+  // Earlier cases leave no timer armed; their disarmed ones leave the queue within 1 ms.
+#if defined(REX_TEST_THREAD_CPU)
+  const ThreadId tid = DispatchThreadId();
+  REQUIRE(tid != 0);
+  std::this_thread::sleep_for(50ms);
+  const auto before = ThreadCpu(tid);
+  REQUIRE(before.count() >= 0);
+#endif
+  std::this_thread::sleep_for(2s);
+#if defined(REX_TEST_THREAD_CPU)
+  const auto after = ThreadCpu(tid);
+  REQUIRE(after.count() >= 0);
+  const auto used = after - before;
+  INFO("dispatch thread CPU over 2 s of an empty queue: " << used.count() << " ms");
+  CHECK(used < 50ms);
+#endif
+
+  std::atomic<long long> fired_after_us{-1};
+  auto start = Clock::now();
+  auto item = rex::thread::QueueTimerOnce(
+      [&](void*) {
+        fired_after_us = std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - start)
+                             .count();
+      },
+      nullptr, start + 20ms);
+  for (auto deadline = Clock::now() + 5s; fired_after_us == -1 && Clock::now() < deadline;)
+    std::this_thread::sleep_for(1ms);
+  if (auto locked = item.lock())
+    locked->Disarm();  // so a timer that never fired cannot outlive the variables it writes
+  CHECK(fired_after_us.load() >= 20000);
+  CHECK(fired_after_us.load() < 250000);  // loose, as above
+}
