+bool ContentManager::BackupPackageBeforeDelete(const std::filesystem::path& package_path,
+                                               const std::filesystem::path& header_path) {
+  std::error_code ec;
+  if (!std::filesystem::exists(package_path, ec) && !std::filesystem::exists(header_path, ec)) {
+    return true;  // nothing to lose
+  }
+
+  const auto backups_root = root_path_ / "save-backups";
+  const std::string stamp = fmt::format("{:%Y%m%d-%H%M%S}", fmt::gmtime(std::time(nullptr)));
+  const std::string name = rex::path_to_utf8(package_path.filename());
+  std::filesystem::path backup = backups_root / (stamp + "-" + name);
+  for (int i = 2; std::filesystem::exists(backup, ec); ++i) {
+    backup = backups_root / fmt::format("{}-{}-{}", stamp, name, i);
+  }
+
+  bool ok = std::filesystem::create_directories(backup, ec) && !ec;
+  if (ok && std::filesystem::exists(package_path, ec)) {
+    std::filesystem::copy(package_path, backup / package_path.filename(),
+                          std::filesystem::copy_options::recursive, ec);
+    ok = !ec;
+  }
+  if (ok && std::filesystem::exists(header_path, ec)) {
+    std::filesystem::copy_file(header_path, backup / header_path.filename(), ec);
+    ok = !ec;
+  }
+  if (!ok) {
+    REXSYS_ERROR("ContentManager: could not back up '{}' before deleting it ({}); not deleting",
+                 rex::path_to_utf8(package_path), ec.message());
+    std::error_code cleanup_ec;
+    std::filesystem::remove_all(backup, cleanup_ec);
+    return false;
+  }
+  REXSYS_INFO("ContentManager: backed up '{}' to '{}' before deleting it",
+              rex::path_to_utf8(package_path), rex::path_to_utf8(backup));
+  return true;
+}
