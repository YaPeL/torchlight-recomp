index 0000000..d200bcf
--- /dev/null
+++ b/tests/unit/input/mnk_keystroke_test.cpp
@@ -0,0 +1,104 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstdint>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/input/mnk/mnk_input_driver.h>
+#include <rex/ui/ui_event.h>
+#include <rex/ui/virtual_key.h>
+
+REXCVAR_DECLARE(bool, mnk_mode);
+
+// The keyboard's controller emulation reports keystrokes, which menus read
+// instead of the state: before, it never queued any, so a keyboard could not
+// get past a menu. Default keybinds: Space is A, W/A the left stick up/left.
+
+using rex::X_RESULT;
+using rex::input::DeviceId;
+using rex::input::DeviceInfo;
+using rex::input::X_INPUT_KEYSTROKE;
+using rex::input::X_INPUT_KEYSTROKE_KEYDOWN;
+using rex::input::X_INPUT_KEYSTROKE_KEYUP;
+using rex::input::mnk::MnkInputDriver;
+using rex::ui::KeyEvent;
+using rex::ui::VirtualKey;
+
+namespace {
+
+void Key(MnkInputDriver& driver, VirtualKey key, bool down) {
+  KeyEvent e(nullptr, key, 1, !down, false, false, false, false);
+  if (down) {
+    driver.OnKeyDown(e);
+  } else {
+    driver.OnKeyUp(e);
+  }
+}
+
+DeviceId Device(MnkInputDriver& driver) {
+  std::vector<DeviceInfo> devices;
+  driver.EnumerateDevices(devices);
+  REQUIRE(devices.size() == 1);
+  return devices[0].id;
+}
+
+// The next keystroke: its virtual key and whether it is a down; 0 when none.
+struct Stroke {
+  uint16_t key = 0;
+  bool down = false;
+};
+Stroke Next(MnkInputDriver& driver, DeviceId id) {
+  X_INPUT_KEYSTROKE k = {};
+  if (driver.GetDeviceKeystroke(id, 0, &k) != X_ERROR_SUCCESS) {
+    return {};
+  }
+  return {uint16_t(k.virtual_key), (uint16_t(k.flags) & X_INPUT_KEYSTROKE_KEYDOWN) != 0};
+}
+
+}  // namespace
+
+TEST_CASE("MnK: a key's press and release are keystrokes", "[input][mnk]") {
+  REXCVAR_SET(mnk_mode, true);
+  MnkInputDriver driver(nullptr, 0);
+  const DeviceId id = Device(driver);
+
+  REQUIRE(Next(driver, id).key == 0);
+  Key(driver, VirtualKey::kSpace, true);
+  Stroke s = Next(driver, id);
+  REQUIRE(s.key == uint16_t(VirtualKey::kXInputPadA));
+  REQUIRE(s.down);
+  REQUIRE(Next(driver, id).key == 0);  // held: no repeat before the delay
+  Key(driver, VirtualKey::kSpace, false);
+  s = Next(driver, id);
+  REQUIRE(s.key == uint16_t(VirtualKey::kXInputPadA));
+  REQUIRE_FALSE(s.down);
+  REQUIRE(Next(driver, id).key == 0);
+  REXCVAR_SET(mnk_mode, false);
+}
+
+TEST_CASE("MnK: stick keys are directions, two of them a diagonal", "[input][mnk]") {
+  REXCVAR_SET(mnk_mode, true);
+  MnkInputDriver driver(nullptr, 0);
+  const DeviceId id = Device(driver);
+
+  Key(driver, VirtualKey::kW, true);
+  Stroke s = Next(driver, id);
+  REQUIRE(s.key == uint16_t(VirtualKey::kXInputPadLThumbUp));
+  REQUIRE(s.down);
+  Key(driver, VirtualKey::kA, true);
+  s = Next(driver, id);  // ups first
+  REQUIRE(s.key == uint16_t(VirtualKey::kXInputPadLThumbUp));
+  REQUIRE_FALSE(s.down);
+  s = Next(driver, id);
+  REQUIRE(s.key == uint16_t(VirtualKey::kXInputPadLThumbUpLeft));
+  REQUIRE(s.down);
+  REXCVAR_SET(mnk_mode, false);
+}
+
+TEST_CASE("MnK: no keystrokes while the emulation is off", "[input][mnk]") {
+  REXCVAR_SET(mnk_mode, false);
+  MnkInputDriver driver(nullptr, 0);
+  X_INPUT_KEYSTROKE k = {};
+  REQUIRE(driver.GetDeviceKeystroke(DeviceId(0x4D4E4B00), 0, &k) ==
+          X_ERROR_DEVICE_NOT_CONNECTED);
+}
