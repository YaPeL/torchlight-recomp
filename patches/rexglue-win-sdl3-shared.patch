diff --git a/thirdparty/CMakeLists.txt b/thirdparty/CMakeLists.txt
index f102b56..28da6f6 100644
--- a/thirdparty/CMakeLists.txt
+++ b/thirdparty/CMakeLists.txt
@@ -245,8 +245,17 @@ target_compile_options(imgui PRIVATE -w)
 # SDL3 - Cross-platform media layer
 #=============================================================================
 set(SDL_INSTALL ON CACHE BOOL "" FORCE)
-set(SDL_SHARED OFF CACHE BOOL "" FORCE)
-set(SDL_STATIC ON CACHE BOOL "" FORCE)
+if(WIN32)
+    # rexruntime is a DLL on Windows, and a static SDL3 would be copied into it and again into
+    # every executable that calls SDL itself (windowed_app_main_sdl.cpp, a title's own code): two
+    # SDLs, each with its own video, windows and gamepads, so the executable's sees none of the
+    # runtime's. A DLL gives the process one SDL, as the runtime's exported symbols do elsewhere.
+    set(SDL_SHARED ON CACHE BOOL "" FORCE)
+    set(SDL_STATIC OFF CACHE BOOL "" FORCE)
+else()
+    set(SDL_SHARED OFF CACHE BOOL "" FORCE)
+    set(SDL_STATIC ON CACHE BOOL "" FORCE)
+endif()
 set(SDL_TEST OFF CACHE BOOL "" FORCE)
 set(SDL_UNIX_CONSOLE_BUILD ON CACHE BOOL "" FORCE)
 
