diff --git a/tests/unit/core/vfs_delete_on_close_test.cpp b/tests/unit/core/vfs_delete_on_close_test.cpp
new file mode 100644
index 0000000..71da743
--- /dev/null
+++ b/tests/unit/core/vfs_delete_on_close_test.cpp
@@ -0,0 +1,270 @@
+#include <algorithm>
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <span>
+#include <string>
+#include <vector>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/filesystem.h>
+#include <rex/filesystem/devices/host_path_device.h>
+#include <rex/filesystem/entry.h>
+#include <rex/filesystem/file.h>
+#include <rex/filesystem/vfs.h>
+
+using rex::X_STATUS;
+using rex::filesystem::Entry;
+using rex::filesystem::File;
+using rex::filesystem::FileAccess;
+using rex::filesystem::FileAction;
+using rex::filesystem::FileDisposition;
+using rex::filesystem::HostPathDevice;
+using rex::filesystem::VirtualFileSystem;
+
+namespace {
+
+constexpr uint32_t kDeleteAccess = 0x00010000;  // NT DELETE
+
+// A writable host directory mounted as test:, with a few files.
+class DeleteStore {
+ public:
+  DeleteStore() {
+    root_ = std::filesystem::temp_directory_path() /
+            ("rexglue_vfs_delete_on_close_" + std::to_string(counter_++));
+    std::error_code ec;
+    std::filesystem::remove_all(root_, ec);
+    std::filesystem::create_directories(root_, ec);
+    for (const char* name : {"0.TSV", "1.TSV", "2.TSV", "backup.tmp"}) {
+      WriteHost(name, std::string("contents of ") + name);
+    }
+    auto device = std::make_unique<HostPathDevice>("\\DeleteStore", root_, false, true);
+    REQUIRE(device->Initialize());
+    REQUIRE(vfs_.RegisterDevice(std::move(device)));
+    REQUIRE(vfs_.RegisterSymbolicLink("test:", "\\DeleteStore"));
+  }
+  ~DeleteStore() {
+    std::error_code ec;
+    std::filesystem::remove_all(root_, ec);
+  }
+
+  void WriteHost(const std::string& name, const std::string& text) {
+    FILE* file = rex::filesystem::OpenFile(root_ / name, "wb");
+    REQUIRE(file != nullptr);
+    fwrite(text.data(), 1, text.size(), file);
+    fclose(file);
+  }
+  std::string ReadHost(const std::string& name) {
+    FILE* file = rex::filesystem::OpenFile(root_ / name, "rb");
+    if (!file) return "<missing>";
+    std::string text(64, '\0');
+    text.resize(fread(text.data(), 1, text.size(), file));
+    fclose(file);
+    return text;
+  }
+  bool HostExists(const std::string& name) { return std::filesystem::exists(root_ / name); }
+
+  X_STATUS TryOpen(const std::string& name, File** out,
+                   FileDisposition disposition = FileDisposition::kOpen,
+                   uint32_t access = FileAccess::kGenericRead) {
+    FileAction action;
+    *out = nullptr;
+    return vfs_.OpenFile(nullptr, "test:\\" + name, disposition, access, false, true, out,
+                         &action);
+  }
+  File* Open(const std::string& name, uint32_t access = FileAccess::kGenericRead) {
+    File* file = nullptr;
+    REQUIRE(TryOpen(name, &file, FileDisposition::kOpen, access) == X_STATUS_SUCCESS);
+    return file;
+  }
+
+  // The guest's DeleteFileA: open with DELETE access, mark it, close.
+  void DeleteFile(const std::string& name) {
+    File* file = Open(name, kDeleteAccess);
+    file->entry()->SetForDeletion(true);
+    file->Destroy();
+  }
+
+  void Write(const std::string& name, const std::string& text) {
+    File* file = nullptr;
+    REQUIRE(TryOpen(name, &file, FileDisposition::kOverwriteIf, FileAccess::kGenericWrite) ==
+            X_STATUS_SUCCESS);
+    size_t written = 0;
+    file->WriteSync(std::span<const uint8_t>(reinterpret_cast<const uint8_t*>(text.data()),
+                                             text.size()),
+                    0, &written);
+    file->Destroy();
+  }
+
+  // The guest's MoveFile: open the source, rename it through its handle, close.
+  X_STATUS Move(const std::string& from, const std::string& to, bool replace) {
+    File* file = Open(from, kDeleteAccess);
+    X_STATUS status = file->entry()->Rename(rex::to_path("test:\\" + to), replace);
+    file->Destroy();
+    return status;
+  }
+
+  Entry* Lookup(const std::string& name) { return vfs_.ResolvePath("test:\\" + name); }
+
+  std::vector<std::string> Names() {
+    std::vector<std::string> names;
+    for (const auto& child : vfs_.ResolvePath("test:")->children()) names.push_back(child->name());
+    std::sort(names.begin(), names.end());
+    return names;
+  }
+  std::vector<std::string> HostNames() {
+    std::vector<std::string> names;
+    for (const auto& item : std::filesystem::directory_iterator(root_)) {
+      names.push_back(rex::path_to_utf8(item.path().filename()));
+    }
+    std::sort(names.begin(), names.end());
+    return names;
+  }
+
+  VirtualFileSystem& vfs() { return vfs_; }
+
+ private:
+  static int counter_;
+  std::filesystem::path root_;
+  VirtualFileSystem vfs_;
+};
+
+int DeleteStore::counter_ = 0;
+
+}  // namespace
+
+TEST_CASE("Delete on close removes the file when its only handle closes", "[filesystem][vfs]") {
+  DeleteStore store;
+  File* file = store.Open("1.TSV", kDeleteAccess);
+  file->entry()->SetForDeletion(true);
+  CHECK(store.HostExists("1.TSV"));  // marking alone deletes nothing
+  file->Destroy();
+  CHECK_FALSE(store.HostExists("1.TSV"));
+  CHECK(store.Lookup("1.TSV") == nullptr);
+}
+
+TEST_CASE("Delete on close waits for the last of several handles", "[filesystem][vfs]") {
+  DeleteStore store;
+  File* reader = store.Open("1.TSV");
+  File* deleter = store.Open("1.TSV", kDeleteAccess);
+  REQUIRE(reader->entry() == deleter->entry());
+  CHECK(reader->entry()->open_file_count() == 2);
+
+  deleter->entry()->SetForDeletion(true);
+  deleter->Destroy();
+  CHECK(store.HostExists("1.TSV"));  // the reader is still open
+  CHECK(store.Lookup("1.TSV") != nullptr);
+
+  reader->Destroy();
+  CHECK_FALSE(store.HostExists("1.TSV"));
+  CHECK(store.Lookup("1.TSV") == nullptr);
+}
+
+TEST_CASE("A file pending deletion cannot be opened again", "[filesystem][vfs]") {
+  DeleteStore store;
+  File* reader = store.Open("1.TSV");
+  store.DeleteFile("1.TSV");  // pending: the reader keeps it
+
+  File* file = nullptr;
+  CHECK(store.TryOpen("1.TSV", &file) == X_STATUS_DELETE_PENDING);
+  CHECK(store.TryOpen("1.TSV", &file, FileDisposition::kOverwriteIf, FileAccess::kGenericWrite) ==
+        X_STATUS_DELETE_PENDING);
+  CHECK(file == nullptr);
+
+  reader->Destroy();
+  CHECK_FALSE(store.HostExists("1.TSV"));
+  store.Write("1.TSV", "new");  // gone: the name can be created again
+  CHECK(store.ReadHost("1.TSV") == "new");
+}
+
+TEST_CASE("Closing an unmarked file keeps it", "[filesystem][vfs]") {
+  DeleteStore store;
+  store.Open("1.TSV", kDeleteAccess)->Destroy();
+  CHECK(store.HostExists("1.TSV"));
+  CHECK(store.Lookup("1.TSV") != nullptr);
+}
+
+TEST_CASE("Clearing the mark before closing keeps the file", "[filesystem][vfs]") {
+  DeleteStore store;
+  File* file = store.Open("1.TSV", kDeleteAccess);
+  file->entry()->SetForDeletion(true);
+  file->entry()->SetForDeletion(false);
+  file->Destroy();
+  CHECK(store.ReadHost("1.TSV") == "contents of 1.TSV");
+}
+
+TEST_CASE("An open file is not deleted under its handle", "[filesystem][vfs]") {
+  DeleteStore store;
+  File* file = store.Open("1.TSV");
+  CHECK_FALSE(store.vfs().DeletePath("test:\\1.TSV"));
+  CHECK(file->entry() == store.Lookup("1.TSV"));
+  CHECK(store.HostExists("1.TSV"));
+  file->Destroy();
+  CHECK(store.vfs().DeletePath("test:\\1.TSV"));
+  CHECK_FALSE(store.HostExists("1.TSV"));
+}
+
+TEST_CASE("Rename does not replace an open file", "[filesystem][vfs]") {
+  DeleteStore store;
+  File* backup = store.Open("backup.tmp");
+  CHECK(store.Move("1.TSV", "backup.tmp", true) == X_STATUS_ACCESS_DENIED);
+  backup->Destroy();
+  CHECK(store.ReadHost("backup.tmp") == "contents of backup.tmp");
+  CHECK(store.ReadHost("1.TSV") == "contents of 1.TSV");
+}
+
+TEST_CASE("Repeated safe saves with the backup deleted keep one save and one backup",
+          "[filesystem][vfs]") {
+  // Torchlight's save: write save.tmp, delete backup.tmp, rename N.TSV -> backup.tmp,
+  // rename save.tmp -> N.TSV.
+  DeleteStore store;
+  for (const std::string text : {"second save", "third save"}) {
+    const std::string previous = store.ReadHost("1.TSV");
+    store.Write("save.tmp", text);
+    store.DeleteFile("backup.tmp");
+    CHECK_FALSE(store.HostExists("backup.tmp"));
+    REQUIRE(store.Move("1.TSV", "backup.tmp", false) == X_STATUS_SUCCESS);
+    REQUIRE(store.Move("save.tmp", "1.TSV", false) == X_STATUS_SUCCESS);
+    CHECK(store.Names() == std::vector<std::string>{"0.TSV", "1.TSV", "2.TSV", "backup.tmp"});
+    CHECK(store.HostNames() == store.Names());
+    CHECK(store.ReadHost("1.TSV") == text);
+    CHECK(store.ReadHost("backup.tmp") == previous);
+  }
+}
+
+TEST_CASE("A renamed file is deleted by its new name", "[filesystem][vfs]") {
+  DeleteStore store;
+  REQUIRE(store.Move("2.TSV", "5.TSV", false) == X_STATUS_SUCCESS);
+  store.DeleteFile("5.TSV");
+  CHECK(store.Names() == std::vector<std::string>{"0.TSV", "1.TSV", "backup.tmp"});
+  CHECK(store.HostNames() == store.Names());
+}
+
+TEST_CASE("Only the marked files disappear", "[filesystem][vfs]") {
+  DeleteStore store;
+  File* reader0 = store.Open("0.TSV");
+  File* reader2 = store.Open("2.TSV");
+  store.DeleteFile("1.TSV");       // closed: goes now
+  store.DeleteFile("2.TSV");       // open elsewhere: goes when reader2 closes
+  store.Write("save.tmp", "tmp");  // never marked
+  CHECK(store.Names() == std::vector<std::string>{"0.TSV", "2.TSV", "backup.tmp", "save.tmp"});
+
+  reader0->Destroy();
+  CHECK(store.HostExists("0.TSV"));
+  reader2->Destroy();
+  CHECK(store.Names() == std::vector<std::string>{"0.TSV", "backup.tmp", "save.tmp"});
+  CHECK(store.HostNames() == store.Names());
+  CHECK(store.ReadHost("0.TSV") == "contents of 0.TSV");
+  CHECK(store.ReadHost("backup.tmp") == "contents of backup.tmp");
+}
+
+TEST_CASE("A file left open when its device is unmounted closes safely", "[filesystem][vfs]") {
+  DeleteStore store;
+  File* file = store.Open("1.TSV");
+  REQUIRE(store.vfs().UnregisterSymbolicLink("test:"));
+  REQUIRE(store.vfs().UnregisterDevice("\\DeleteStore"));
+  CHECK(file->entry() == nullptr);  // detached from the destroyed entry
+  file->Destroy();                  // must not touch it
+  CHECK(store.HostExists("1.TSV"));
+}
