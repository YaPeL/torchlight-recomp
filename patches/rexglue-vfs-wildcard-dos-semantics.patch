     rules_.push_back(
         WildcardRule(str_str, last ? WildcardFlags::LAST : WildcardFlags::FIRST_AND_LAST));
   }
+  return rules_;
+}
+
+void WildcardEngine::PreparePattern(const std::string_view pattern) {
+  rules_ = Rules(pattern);
+  stem_rules_.clear();
+  dos_end_ = DosEnd::kNone;
+  // Windows' find (FindFirstFile: "*.*" becomes "*", and a dot the pattern ends with or that only
+  // wildcards follow matches the end of a name without one): a name without a dot also matches
+  // when the stem before the ".*" does, and a pattern ending in "." matches only names without a
+  // dot. A pattern that is only ".*" or "." keeps its plain meaning.
+  if (pattern.size() > 2 && pattern.substr(pattern.size() - 2) == ".*") {
+    dos_end_ = DosEnd::kDotStar;
+    stem_rules_ = Rules(pattern.substr(0, pattern.size() - 2));
+  } else if (pattern.size() > 1 && pattern.back() == '.') {
+    dos_end_ = DosEnd::kDot;
+    stem_rules_ = Rules(pattern.substr(0, pattern.size() - 1));
+  }
 }
 
 void WildcardEngine::SetRule(const std::string_view pattern) {
   PreparePattern(pattern);
 }
 
